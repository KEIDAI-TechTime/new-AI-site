---
import NightLayout from '@/layouts/NightLayout.astro';

const title = 'TechTime | SAPの導入と保守を、生成AIで進める。（B案）';
const description =
  'TechTime は、SAP を中心とした基幹システムの導入と運用保守を、生成AIで進めるための手順と仕組みをお客様のプロジェクトに組み込みます。';

const phases = [
  { key: 'req', name: '要件定義', line: '会議の記録から、決定と未決を拾う。', human: 'どれを作るかを決める' },
  { key: 'des', name: '設計', line: '初版を起こし、全件を点検する。', human: '指摘を反映するかを決める' },
  { key: 'dev', name: '開発', line: '設計書から、ABAP とテストを起こす。', human: '動きを確かめる' },
  { key: 'tst', name: 'テスト', line: 'SAP の画面を操作し、証跡を残す。', human: '合否を決める' },
  { key: 'mig', name: '移行', line: '全件を変換し、全件を照合する。', human: '判断の要る項目だけを見る' },
  { key: 'ope', name: '運用保守', line: '導入の記録を持ったまま、問い合わせに答える。', human: '確かめて返す' },
];
const W8 = [92, 70, 84, 56, 96, 64, 78, 44];
const CODE = [[0, 46], [1, 70], [1, 58], [2, 80], [2, 52], [1, 34], [1, 66], [2, 74], [0, 28]];

const COLS = 12;
const ROWS = 7;
const dots = Array.from({ length: COLS * ROWS }, (_, i) => i);
const sampled = [2, 15, 20, 31, 38, 49, 57, 66, 77];
const defects = [8, 27, 46, 70];

const meritsBuild = [
  { fig: 'shift', name: '不具合が、前の工程で見つかる', body: '誤りを後ろの工程へ持ち越さない。' },
  { fig: 'time', name: '作る時間が縮み、決める時間が増える', body: '空いた時間を、業務の検討と合意へ。' },
  { fig: 'daily', name: '進み具合と課題が、毎朝そろっている', body: '報告のための資料づくりが要らない。' },
  { fig: 'even', name: '担当が替わっても、出来がそろう', body: '誰が頼んでも、同じ形で出る。' },
];
const feed = ['会議の記録を読みました', '課題を一覧に足しました', '期日の近い課題を並べました', '止まっている話題を見つけました', '担当への確認の下書きを作りました', 'チャットの投稿を読みました'];

const meritsRun = [
  { name: '引継ぎで知識が落ちない', body: '稼働の日から、導入の記録が使える。' },
  { name: '問い合わせに、その場で答える', body: '記録を持ったAIが、回答の下書きを作る。' },
  { name: '改修の影響が、すぐに分かる', body: '関係する設計書・プログラム・テストが並ぶ。' },
  { name: '止まる前に気づく', body: '夜間の処理と締めを、AIが見張る。' },
];

const steps = [
  { name: '現状を見る', body: '設計書・規約・進め方を見て、AIが効く工程を分ける。' },
  { name: '手順を作る', body: 'お客様の様式と規約に合わせて作る。' },
  { name: '一機能で試す', body: '実際の案件で、設計からテストまで通す。' },
  { name: '広げて、渡す', body: '手順はお客様のものとして残す。' },
];
const rules = ['結果は人が確かめて決める。AIに決めさせない。', '本番環境では、AIに画面を操作させない。', 'お客様の情報を、AIの学習に使われない設定で扱う。'];

const career = [
  { yr: '2001', to: '2009', seat: '業務の当事者', org: '大手自動車メーカー', body: '受注・在庫・物流の運営。SAP PP の更改を業務側で主導。' },
  { yr: '2009', to: '2017', seat: 'コンサルタント', org: '外資系コンサルティングファーム', body: 'SAP ECC・S/4HANA の導入（SD・MM）。構想から要件の確定まで。' },
  { yr: '2017', to: '2024', seat: 'プロジェクト責任者', org: '外資系IT企業', body: 'S/4HANA の再構築を約120名のPMとして統括。アジア3拠点へ展開。' },
  { yr: '2024', to: '現在', seat: '生成AIでの導入', org: 'TechTime', body: '大型の SAP 案件で、生成AIで作る手順と点検の仕組みを設計。' },
];
const band = ['要件定義', '設計', '開発', 'テスト', '移行', '運用保守'];
---

<NightLayout title={title} description={description}>
  <header class="nav">
    <a href="/b" class="nav__logo"><i></i>TechTime</a>
    <nav class="nav__links">
      <a href="#change">AIで変わること</a>
      <a href="#pm">プロジェクト管理</a>
      <a href="#build">導入</a>
      <a href="#run">運用保守</a>
      <a href="#how">進め方</a>
    </nav>
    <a href="#contact" class="nav__cta">相談する</a>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <canvas id="net" aria-hidden="true"></canvas>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__copy">
        <p class="chip"><i></i>SAP × 生成AI</p>
        <h1 class="hero__h1">
          <span class="hl"><span>SAPの導入と保守を、</span></span>
          <span class="hl"><span><em>生成AI</em>で進める。</span></span>
        </h1>
        <p class="hero__lead">
          AIが作り、全件を点検する。人は、決めることに集中する。<br />その進め方を、お客様のプロジェクトに組み込みます。
        </p>
        <div class="hero__act">
          <a href="#contact" class="btn">相談する<span>→</span></a>
          <a href="#change" class="ghost">AIで変わることを見る</a>
        </div>
      </div>
      <p class="hero__legend" aria-hidden="true"><span><i class="lg-doc"></i>伝票の流れ</span><span><i class="lg-ai"></i>AIの点検</span></p>
    </section>

    <div class="band" aria-hidden="true">
      <div class="band__in">
        {[0, 1].map(() => band.map((b) => <span>{b}<i></i></span>))}
      </div>
    </div>

    <!-- ============ CHANGE：スクロールで全件へ ============ -->
    <section class="scan" id="change">
      <div class="scan__sticky">
        <div class="scan__copy">
          <p class="chip"><i></i>AIで変わること</p>
          <h2 class="scan__h">
            <span class="was">抜き取りで<br />確かめる。</span>
            <span class="now">AIが、全件を<br />確かめる。</span>
          </h2>
          <dl class="scan__read">
            <div><dt>確かめた件数</dt><dd><b id="nChk">9</b><small>/ {dots.length}</small></dd></div>
            <div><dt>見つけた誤り</dt><dd class="e"><b id="nHit">0</b><small>/ {defects.length}</small></dd></div>
          </dl>
        </div>
        <div class="scan__grid" id="dots" aria-hidden="true">
          {dots.map((i) => (
            <i class:list={[{ s: sampled.includes(i), d: defects.includes(i) }]} data-w={(i % COLS) + Math.floor(i / COLS)}></i>
          ))}
        </div>
        <p class="scan__hint" aria-hidden="true">スクロール<i></i></p>
      </div>
    </section>

    <!-- ============ 工程：場面で見せる ============ -->
    <section class="px" id="px">
      <div class="px__sticky">
        <div class="px__side">
          <p class="chip"><i></i>工程ごとの変化</p>
          <ol class="px__names">
            {phases.map((p, i) => (
              <li class:list={[{ 'is-on': i === 0 }]} data-i={i}><span>{String(i + 1).padStart(2, '0')}</span>{p.name}</li>
            ))}
          </ol>
          <div class="px__caps">
            {phases.map((p, i) => (
              <div class:list={['px__cap', { 'is-on': i === 0 }]}>
                <p class="px__line"><b>AI</b>{p.line}</p>
                <p class="px__human"><b>人</b>{p.human}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="px__stage" aria-hidden="true">
          <!-- 要件定義 -->
          <div class="st st--req is-on">
            <div class="box talk">
              <em>会議の記録</em>
              {[78, 54, 88, 62, 72].map((w, k) => <i class:list={['bb', 'p', { r: k % 2 === 1 }]} style={`--t:${0.1 + k * 0.22}s;--w:${w}%`}></i>)}
            </div>
            <span class="aibadge p" style="--t:1.5s">AI</span>
            <div class="box out">
              <em>決定</em>
              {[0, 1, 2].map((k) => <b class="cp ok p" style={`--t:${2 + k * 0.4}s`}><i style={`width:${[70, 52, 84][k]}%`}></i></b>)}
              <em class="mt">未決</em>
              {[0, 1].map((k) => <b class="cp ng p" style={`--t:${3.4 + k * 0.4}s`}><i style={`width:${[60, 76][k]}%`}></i></b>)}
            </div>
          </div>

          <!-- 設計 -->
          <div class="st st--des">
            <div class="box doc">
              <em>設計書</em>
              {W8.map((w, k) => <i class:list={['ln', 'ty', { flag: k === 2 || k === 5 }]} style={`--t:${0.2 + k * 0.28}s;--w:${w}%`}></i>)}
              <span class="scanl"></span>
            </div>
            <div class="box side">
              <em>AIの点検</em>
              <b class="cp ng p" style="--t:4.5s">指摘</b>
              <b class="cp ng p" style="--t:4.9s">指摘</b>
              <b class="cp ok p" style="--t:5.4s">ほかは問題なし</b>
            </div>
          </div>

          <!-- 開発 -->
          <div class="st st--dev">
            <div class="box src">
              <em>設計書</em>
              {[80, 60, 90, 50].map((w) => <i class="ln" style={`--w:${w}%`}></i>)}
            </div>
            <span class="aibadge p" style="--t:0.5s">AI</span>
            <div class="box code">
              <em>ABAP</em>
              {CODE.map(([ind, w], k) => <i class:list={['ln', 'ty', `c${k % 3}`]} style={`--t:${0.9 + k * 0.24}s;--w:${w}%;--in:${ind * 9}%`}></i>)}
            </div>
            <div class="tags">
              {['規約に合っている', '設計書と対応している', '単体テスト仕様', 'テストデータ'].map((t, k) => <b class="cp ok p" style={`--t:${3.6 + k * 0.4}s`}>{t}</b>)}
            </div>
          </div>

          <!-- テスト -->
          <div class="st st--tst">
            <div class="box sap">
              <div class="sap__bar"><i></i><i></i><i></i><span>受注登録</span></div>
              {['受注先', '品目', '数量'].map((l, k) => (
                <label><span>{l}</span><i class="fld"><u class="ty" style={`--t:${1 + k * 0.9}s;--w:${[62, 78, 30][k]}%`}></u></i></label>
              ))}
              <div class="sap__btn">保存</div>
              <div class="sap__msg p" style="--t:4.4s">登録しました</div>
              <span class="cur"></span>
              <span class="flash"></span>
            </div>
            <div class="box ev">
              <em>証跡</em>
              <b class="shot p" style="--t:5.1s"><i></i><i></i><i></i></b>
              <b class="cp ok p" style="--t:5.6s">OK</b>
            </div>
          </div>

          <!-- 移行 -->
          <div class="st st--mig">
            <div class="box tbl">
              <em>いまのシステム</em>
              {[0, 1, 2, 3, 4, 5, 6].map(() => <i class="row"></i>)}
            </div>
            <div class="pipe">{[0, 1, 2, 3, 4, 5].map((k) => <u style={`--k:${k}`}></u>)}</div>
            <div class="box tbl new">
              <em>SAP</em>
              {[0, 1, 2, 3, 4, 5, 6].map((k) => <i class:list={['row', 'ty', { warn: k === 4 }]} style={`--t:${0.5 + k * 0.42}s;--w:100%`}><s class="p" style={`--t:${0.9 + k * 0.42}s`}></s></i>)}
            </div>
            <div class="prog"><span>全件を照合</span><i><u></u></i></div>
          </div>

          <!-- 運用保守 -->
          <div class="st st--ope">
            <div class="q p" style="--t:0.3s">この伝票が止まっている理由は？</div>
            <div class="dots"><i></i><i></i><i></i></div>
            <div class="a p" style="--t:2.5s">
              <i class="ln" style="--w:92%"></i><i class="ln" style="--w:76%"></i><i class="ln" style="--w:58%"></i>
              <div class="srcs">
                {['設計書', 'テストの記録', '決定の記録'].map((t, k) => <b class="cp ok p" style={`--t:${3.3 + k * 0.4}s`}>{t}</b>)}
              </div>
            </div>
            <div class="by p" style="--t:5s">担当者が確かめて返す</div>
          </div>

          <div class="px__bar"><i id="pxBar"></i></div>
        </div>
      </div>
    </section>

    <!-- ============ プロジェクト管理 ============ -->
    <section class="sec pm" id="pm">
      <p class="chip rv"><i></i>プロジェクト管理が変わる</p>
      <h2 class="h2 rv">報告を待たない。<br />記録から、毎朝わかる。</h2>
      <div class="pm__cmp rv">
        {[['状況を知る', '週次の報告', '毎朝の画面'], ['期日の判断', '経験と勘', '間に合う確率'], ['会議の資料', '人が集計して作る', '作らない。画面を開く']].map((r) => (
          <div><span>{r[0]}</span><s>{r[1]}</s><i>→</i><b>{r[2]}</b></div>
        ))}
      </div>
      <div class="pm__grid">
        <article class="pmt rv">
          <div class="pmf pmf--pick" aria-hidden="true">
            <div class="pk__in"><em>チャット・会議</em>{[70, 52, 84, 60].map((w, k) => <i class="pp" style={`--t:${0.1 + k * 0.3}s;--w:${w}%`}></i>)}</div>
            <span class="pk__ai pp" style="--t:1.3s">AI</span>
            <div class="pk__out"><em>課題・リスク一覧</em>{['課題', 'リスク', '課題'].map((t, k) => <b class="pp" style={`--t:${1.8 + k * 0.5}s`}><u class:list={[{ r: t === 'リスク' }]}>{t}</u><i></i></b>)}</div>
          </div>
          <h3>会話と会議から、課題とリスクを毎朝拾う</h3>
        </article>
        <article class="pmt rv" style="--d:.1s">
          <div class="pmf pmf--prob" aria-hidden="true">
            <div class="pb__num"><em>期日に間に合う確率（例）</em><p><b class="pbn">52</b><small>%</small></p></div>
            <div class="pb__plot">
              <span class="pb__late">遅れ</span>
              <div class="pb__bars">{[4, 8, 14, 24, 38, 56, 72, 84, 72, 56, 38, 24, 14, 8, 4].map((h, k) => <i class="py" style={`--h:${h}%;--t:${k * 0.05}s`}></i>)}</div>
              <span class="pb__dl"><u>期日</u></span>
            </div>
          </div>
          <h3>期日に間に合うかを、確率で答える</h3>
        </article>
        <article class="pmt rv">
          <div class="pmf pmf--order" aria-hidden="true">
            <em>今日、手を打つ順</em>
            <div class="od">{[[40, 3], [85, 0], [25, 4], [65, 1], [55, 2]].map(([w, r], k) => <div class:list={['od__r', { top: r < 3 }]} style={`--y0:${k};--y1:${r};--w:${w}%`}><u>{r + 1}</u><i></i></div>)}</div>
          </div>
          <h3>どの課題から片付けるかを、効き目の順に並べる</h3>
        </article>
        <article class="pmt rv" style="--d:.1s">
          <div class="pmf pmf--net" aria-hidden="true">
            <svg viewBox="0 0 220 124">
              {[[30, 24], [38, 98], [104, 12], [182, 28], [190, 96], [112, 112]].map(([x, y], k) => (
                <g><line x1={x} y1={y} x2="110" y2="62" pathLength="1" class="nl" style={`--t:${0.4 + k * 0.35}s`} /><circle cx={x} cy={y} r="6" class="nd" /></g>
              ))}
              <circle cx="110" cy="62" r="11" class="hub" />
            </svg>
            <b class="nt pp" style="--t:3s">問いが集まり、答えが止まっている</b>
          </div>
          <h3>問いが集まる人と、止まっている話題が見える</h3>
        </article>
      </div>
    </section>

    <!-- ============ 導入 ============ -->
    <section class="sec" id="build">
      <p class="chip rv"><i></i>導入で得られること</p>
      <h2 class="h2 rv">品質を落とさずに、<br />日程に余裕をつくる。</h2>
      <div class="bento">
        {meritsBuild.map((m, i) => (
          <article class:list={['card', 'rv', `card--${m.fig}`]} style={`--d:${(i % 2) * 0.1}s`}>
            <div class="card__fig" aria-hidden="true">
              {m.fig === 'shift' && (
                <div class="f-shift">
                  {['設計', '単体', '結合', '統合'].map((l) => <div><i></i><span>{l}</span></div>)}
                </div>
              )}
              {m.fig === 'time' && (
                <div class="f-time">
                  <div class="f-time__bar"><i class="mk"><span>作る</span></i><i class="dc"><span>決める</span></i></div>
                </div>
              )}
              {m.fig === 'daily' && (
                <div class="f-daily">
                  <ul>
                    {[...feed, ...feed].map((f) => <li><b>07:00</b>{f}</li>)}
                  </ul>
                </div>
              )}
              {m.fig === 'even' && (
                <div class="f-even">
                  {[0, 1, 2, 3, 4].map((k) => <i style={`--k:${k}`}></i>)}
                </div>
              )}
            </div>
            <h3 class="card__name">{m.name}</h3>
            <p class="card__body">{m.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ============ 運用保守 ============ -->
    <section class="sec" id="run">
      <p class="chip rv"><i></i>運用保守で得られること</p>
      <h2 class="h2 rv">導入の記録を、<br />そのまま保守で使う。</h2>

      <div class="beam rv" aria-hidden="true">
        <div class="beam__track">
          <i class="beam__light"></i>
          <span class="beam__gate"><b>稼働</b></span>
          <span class="beam__pack">設計書・テスト・決定の記録</span>
        </div>
        <div class="beam__labels">
          <span>要件定義</span><span>設計</span><span>開発</span><span>テスト</span><span>移行</span>
          <span class="after">問い合わせ</span><span class="after">改修</span><span class="after">次の展開</span>
        </div>
      </div>

      <div class="runs">
        {meritsRun.map((m, i) => (
          <article class="run rv" style={`--d:${i * 0.08}s`}>
            <span class="run__no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="run__name">{m.name}</h3>
            <p class="run__body">{m.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ============ 進め方 ============ -->
    <section class="sec how" id="how">
      <div class="how__head">
        <p class="chip rv"><i></i>TechTime の進め方</p>
        <h2 class="h2 rv">お客様のプロジェクトの中で、<br />一機能から始める。</h2>
<p class="lead rv">お客様の様式と規約に合わせた手順を作り、使える形でお渡しします。</p>
      </div>
      <div class="stack">
        {steps.map((s, i) => (
          <article class="sc" style={`--i:${i}`}>
            <span class="sc__no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="sc__name">{s.name}</h3>
            <p class="sc__body">{s.body}</p>
          </article>
        ))}
      </div>
      <ul class="rules rv">
        <li class="rules__k">守ること</li>
        {rules.map((r) => <li>{r}</li>)}
      </ul>
    </section>

    <!-- ============ 経歴 ============ -->
    <section class="sec">
      <p class="chip rv"><i></i>代表の経歴</p>
      <h2 class="h2 rv">業務、構想、導入。<br />三つの立場で SAP に関わってきた。</h2>
      <ol class="cv">
        {career.map((c) => (
          <li class="cv__row rv">
            <p class="cv__yr">{c.yr}<small>— {c.to}</small></p>
            <div>
              <h3 class="cv__seat">{c.seat}<span>{c.org}</span></h3>
              <p class="cv__body">{c.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <dl class="nums">
        <div class="rv"><dt>基幹システムの現場</dt><dd><b data-count="25">0</b>年</dd></div>
        <div class="rv"><dt>SAP の導入・展開・更改</dt><dd><b data-count="6">0</b>件</dd></div>
        <div class="rv"><dt>率いた体制（最大）</dt><dd>約<b data-count="120">0</b>名</dd></div>
        <div class="rv"><dt>扱ってきた領域</dt><dd><b class="t">PP・MM・SD</b></dd></div>
      </dl>
    </section>

    <!-- ============ 相談 ============ -->
