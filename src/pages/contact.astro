---
/* 相談する。相談票の動き（入力の確かめ・送信先・記録）は前のまま */
import NextLayout from '@/layouts/NextLayout.astro';

const title = '相談する | TechTime';
const description = 'SAP の導入と保守に AIチームを組み込むご相談を受け付けています。導入の検討中でも、途中でも、稼働したあとでも構いません。';

const situations = ['SAP の導入を検討している', 'SAP の導入の途中', '稼働後の運用保守', 'そのほか'];
const phases = ['要件定義', '設計', '開発', 'テスト', '移行', '運用保守', 'プロジェクト管理', 'アセスメント'];
const timelines = ['1ヶ月以内', '2〜3ヶ月', '3〜6ヶ月', '6ヶ月以上', '未定'];
const asmFlow = [
  { no: '01', name: 'ご相談と、お見積もり', body: 'いまの工程と、お預かりできる資料を伺います。行える解析の範囲をお伝えし、お見積もりします。' },
  { no: '02', name: '資料を預かり、解析する', body: '秘密保持の取り決めを結んだうえで、AIが全件を読み、人が確かめます。' },
  { no: '03', name: '報告書をお返しする', body: 'どの工程に AIチームが効くか、何から始めるかをお伝えします。' },
];
const after = [
  { no: '01', name: '内容を読み、ご連絡します', body: 'いただいた内容を読み、担当からメールでご連絡します。' },
  { no: '02', name: 'いまの進め方を伺います', body: '設計書の様式を一つと、時間がかかっている工程を見せていただきます。' },
  { no: '03', name: 'AIが効くかをお答えします', body: '効く工程と、効かない工程を分けてお伝えします。' },
];
---

<NextLayout noEnd title={title} description={description} og="contact.jpg" ask="導入の検討中でも、途中でも、稼働したあとでも構いません。">
  <script is:inline>if (new URLSearchParams(location.search).get("topic") === "assess") document.documentElement.classList.add("is-asm");</script>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="ct-tone" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="1.256 -0.518 0.369 0 -0.024  0.759 -0.021 0.369 0 -0.024  -0.391 1.129 0.369 0 -0.024  0 0 0 1 0" /></filter></svg>

  <section class="hero" data-st="相談票">
    <div class="ct">
      <div class="ct-side">
        <div class="ct-gen">
          <p class="kick">相談／SAP の導入と保守に、AIチームを</p>
          <h1>いまの進め方を、<br />聞かせてください。</h1>
          <p class="ct-lead">導入の検討中でも、途中でも、稼働したあとでも構いません。</p>

          <ol class="ct-stp">
            {after.map((a) => (
              <li>
                <h2>{a.name}</h2>
                <p>{a.body}</p>
              </li>
            ))}
          </ol>

          <dl class="ct-direct">
            <div><dt>電話</dt><dd><a href="tel:0342223363">03-4222-3363</a><small>月〜金　9〜19時</small></dd></div>
            <div><dt>メール</dt><dd><a href="mailto:kdm@techtime-link.com">kdm@techtime-link.com</a></dd></div>
          </dl>
        </div>

        <div class="ct-asm">
          <p class="kick">アセスメント／最初の一歩は、アセスメント</p>
          <h2 class="ct-h">貴社の資料を読み、<br />どこに効くかを報告書にする。</h2>
          <p class="ct-lead">設計書や会議の記録をお預かりし、AIチームが効く工程と、最初に手を打つ所を報告書にまとめます。</p>

          <a class="ct-deck" id="deck" href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" aria-label="アセスメント結果報告書のサンプルを開く">
            {['01', '03', '07', '10', '12', '20'].map((n, i) => <img src={`/images/assess/p${n}.webp`} alt={i === 0 ? 'アセスメント結果報告書のサンプルの頁' : ''} width="1120" height="792" style={`--i:${i}`} />)}
          </a>
          <div class="ct-asmact">
            <a href="/downloads/techtime-assessment-sample.pdf" download="TechTime_アセスメント結果報告書_サンプル.pdf" class="btn">サンプルをダウンロード<i></i></a>
            <span>PDF・29枚・約2MB。入力は要りません。</span>
            <a href="/assessment" class="more">アセスメントの内容を詳しく見る</a>
          </div>

          <ul class="ct-pts">
            <li><b>全件を読む</b>抜き取りではなく、預かった資料をすべて</li>
            <li><b>統計で測る</b>期日に間に合う確率、減る工数の見込み</li>
            <li><b>根拠を並べる</b>所見ごとに、資料の抜粋を添える</li>
          </ul>

          <ol class="ct-stp">
            {asmFlow.map((a) => (
              <li>
                <h2>{a.name}</h2>
                <p>{a.body}</p>
              </li>
            ))}
          </ol>
          <dl class="ct-direct">
            <div><dt>電話</dt><dd><a href="tel:0342223363">03-4222-3363</a><small>月〜金　9〜19時</small></dd></div>
            <div><dt>メール</dt><dd><a href="mailto:kdm@techtime-link.com">kdm@techtime-link.com</a></dd></div>
          </dl>
        </div>
      </div>

      <section class="ct-slip" id="slip">
        <div class="ct-slip__head">
          <b>相談票</b>
          <span>No. <i id="slipNo">000000</i></span>
          <div class="ct-stamp" id="stamp" aria-hidden="true"><span>受付</span></div>
        </div>

        <form id="form" novalidate>
          <div class="ct-row">
            <label class="ct-f"><span>会社名<em>必須</em></span><input name="company" type="text" required autocomplete="organization" /></label>
            <label class="ct-f"><span>お名前<em>必須</em></span><input name="name" type="text" required autocomplete="name" /></label>
          </div>
          <div class="ct-row">
            <label class="ct-f"><span>メールアドレス<em>必須</em></span><input name="email" type="email" required autocomplete="email" /></label>
            <label class="ct-f"><span>電話番号</span><input name="phone" type="tel" autocomplete="tel" /></label>
          </div>

          <fieldset class="ct-f">
            <legend>いまの状況<em>必須</em></legend>
            <div class="ct-opts">
              {situations.map((s) => <label class="ct-opt"><input type="radio" name="systemType" value={s} required /><span>{s}</span></label>)}
            </div>
          </fieldset>

          <fieldset class="ct-f">
            <legend>相談したい工程<small>いくつでも</small></legend>
            <div class="ct-opts">
              {phases.map((p) => <label class="ct-opt"><input type="checkbox" name="phase" value={p} /><span>{p}</span></label>)}
            </div>
          </fieldset>

          <fieldset class="ct-f">
            <legend>始めたい時期<em>必須</em></legend>
            <div class="ct-opts">
              {timelines.map((t) => <label class="ct-opt"><input type="radio" name="timeline" value={t} required /><span>{t}</span></label>)}
            </div>
          </fieldset>

          <label class="ct-f">
            <span>相談の内容<em>必須</em></span>
            <textarea name="message" rows="6" maxlength="500" required placeholder="いま時間がかかっている工程や、困っていることをお書きください。"></textarea>
            <small class="ct-count"><i id="count">0</i> / 500</small>
          </label>

          <p class="ct-err" id="err" role="alert"></p>

          <div class="ct-send">
            <button type="submit" class="btn" id="send">
              <span id="sendLabel">送信する</span>
              <i></i>
            </button>
            <p class="ct-reply">24時間以内に、メールで返信します。</p>
          </div>
        </form>

        <div class="ct-done" id="done" role="status">
          <p class="ct-done__h">受け付けました。</p>
          <p>24時間以内に、担当からメールで返信します。</p>
          <p class="ct-done__n">ご連絡までの間に、次の資料をご覧いただけます。</p>
          <a href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" class="more">アセスメント結果報告書のサンプル（PDF・29枚）</a>
          <a href="/process" class="more">相談のあとの進め方</a>
          <a href="/blog" class="more">ブログ</a>
          <a href="/" class="more">トップへ戻る</a>
        </div>
      </section>
    </div>
  </section>
</NextLayout>

<style is:global>
  .ct { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 80px); align-items: start; }
  .ct-side { position: sticky; top: 108px; }
  @keyframes ct-up { from { opacity: 0; transform: translateY(18px); } }
  .ct-side h1 { animation: ct-up 0.8s both; }
  .ct-h { margin-top: 14px; font-size: clamp(23px, 2.5vw, 36px); line-height: 1.36; animation: ct-up 0.8s both; }
  .ct-lead { margin-top: 16px; font-size: clamp(15px, 1.25vw, 17px); font-weight: 500; animation: ct-up 0.8s 0.1s both; }

  /* 相談のあとの流れ。番号の丸が、順に光って繰り返す */
  .ct-stp { display: grid; gap: 8px; margin-top: clamp(22px, 3vw, 40px); counter-reset: s; }
  .ct-stp li { position: relative; display: grid; grid-template-columns: 44px 1fr; align-items: start; padding: 16px 22px; border-radius: 12px; background: var(--card); counter-increment: s; animation: ct-up 0.7s both; }
  .ct-stp li:nth-child(1) { animation-delay: 0.2s; }
  .ct-stp li:nth-child(2) { animation-delay: 0.32s; }
  .ct-stp li:nth-child(3) { animation-delay: 0.44s; }
  .ct-stp li::before { content: counter(s); grid-row: 1 / span 2; display: grid; place-items: center; width: 30px; height: 30px; margin-top: 2px; border-radius: 50%; background: var(--key); color: var(--ink); font: 600 16px var(--num); animation: ct-ring 6s infinite; }
  .ct-stp li:nth-child(2)::before { animation-delay: 2s; }
  .ct-stp li:nth-child(3)::before { animation-delay: 4s; }
  @keyframes ct-ring { 0%, 34%, 100% { box-shadow: 0 0 0 0 rgba(242, 169, 0, 0); } 6% { box-shadow: 0 0 0 0 rgba(242, 169, 0, 0.55); } 30% { box-shadow: 0 0 0 12px rgba(242, 169, 0, 0); } }
  .ct-stp li + li::after { content: ''; position: absolute; left: 36px; top: -8px; width: 2px; height: 8px; background: var(--key); }
  .ct-stp h2 { font-size: clamp(16px, 1.4vw, 18px); font-weight: 900; line-height: 1.6; }
  .ct-stp p { grid-column: 2; font-size: 14px; color: var(--mute); }

  .ct-direct { display: grid; gap: 4px; margin-top: 18px; padding: 16px 22px; border-radius: 12px; background: var(--tint); animation: ct-up 0.7s 0.56s both; }
  .ct-direct div { display: grid; grid-template-columns: 4.2em 1fr; align-items: baseline; }
  .ct-direct dt { font-size: 12.5px; font-weight: 700; }
  .ct-direct dd { font: 600 22px/1.5 var(--num); letter-spacing: 0.02em; overflow-wrap: anywhere; }
  .ct-direct dd a { text-decoration: underline; text-decoration-color: var(--key); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .ct-direct small { margin-left: 14px; font: 500 12px var(--sans); color: var(--mute); }

  /* アセスメントの相談として開いたとき */
  .ct-asm { display: none; }
  html.is-asm .ct-gen { display: none; }
  html.is-asm .ct-asm { display: block; }
  html.is-asm .ct-side { position: static; }
  .ct-deck { position: relative; display: block; aspect-ratio: 1120 / 850; margin: 26px 52px 30px 0; animation: ct-up 0.9s 0.2s both; }
  .ct-deck img { position: absolute; inset: 0; width: 100%; height: auto; border-radius: 10px; background: var(--card); filter: url(#ct-tone); box-shadow: 0 10px 26px -12px rgba(17, 23, 26, 0.35);
    transform: translate(calc(var(--i) * 10px), calc(var(--i) * 8px)) rotate(calc(var(--i) * 0.5deg)); z-index: calc(10 - var(--i)); opacity: calc(1 - var(--i) * 0.07); transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.9s; }
  .ct-deck img.out { transform: translate(-46%, -6%) rotate(-7deg); opacity: 0; transition: transform 0.6s cubic-bezier(0.6, 0, 0.9, 0.4), opacity 0.5s 0.1s; }
  .ct-asmact { display: flex; align-items: center; gap: 12px 18px; flex-wrap: wrap; font-size: 12.5px; color: var(--mute); }
  .ct-pts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 26px; }
  .ct-pts li { padding: 14px 16px; border-radius: 12px; background: var(--tint); font-size: 13px; line-height: 1.7; }
  .ct-pts b { display: block; font-size: 16px; font-weight: 900; }

  /* 相談票 */
  .ct-slip { position: relative; border-radius: var(--r); background: var(--card); animation: ct-up 0.9s 0.15s both; }
  .ct-slip__head { position: relative; display: flex; align-items: baseline; gap: 18px; padding: clamp(18px, 2.4vw, 30px) clamp(18px, 2.6vw, 36px) 0; }
  .ct-slip__head b { font-size: 21px; font-weight: 900; letter-spacing: 0.12em; }
  .ct-slip__head > span { font: 500 12px var(--mono); color: var(--mute); }
  .ct-slip__head i { font-style: normal; color: var(--ink); }
  .ct-stamp { position: absolute; right: clamp(18px, 2.6vw, 36px); top: 14px; display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--key); color: var(--ink); font-size: 17px; font-weight: 900; opacity: 0; transform: rotate(-10deg) scale(1.8); }
  .ct-slip.is-done .ct-stamp { opacity: 1; transform: rotate(-10deg) scale(1); transition: opacity 0.12s 0.2s, transform 0.4s 0.2s cubic-bezier(0.3, 1.7, 0.5, 1); }
  .ct-slip form { display: grid; gap: 24px; padding: clamp(18px, 2.4vw, 30px) clamp(18px, 2.6vw, 36px) clamp(22px, 2.8vw, 38px); }
  .ct-slip.is-done form { display: none; }
  .ct-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px clamp(14px, 1.6vw, 24px); }
  .ct-f { position: relative; display: block; min-width: 0; border: 0; }
  .ct-f > span, .ct-f > legend { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 13.5px; font-weight: 700; }
  .ct-f em { padding: 0 9px; border-radius: 99px; background: var(--tint); font-style: normal; font-size: 11px; font-weight: 700; line-height: 1.8; }
  .ct-f legend small { font-size: 12px; font-weight: 500; color: var(--mute); }
  .ct-slip input[type='text'], .ct-slip input[type='email'], .ct-slip input[type='tel'], .ct-slip textarea { display: block; width: 100%; padding: 11px 14px; border: 0; border-radius: 10px; outline: none; background: var(--bg); box-shadow: inset 0 0 0 2px transparent; font: inherit; font-size: 16px; color: var(--ink); transition: background 0.2s, box-shadow 0.2s; }
  .ct-slip textarea { resize: vertical; line-height: 1.8; }
  .ct-slip input:focus, .ct-slip textarea:focus { background: #fff; box-shadow: inset 0 0 0 2px var(--key); }
  .ct-slip ::placeholder { color: #8a8f94; }
  .ct-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .ct-opt { position: relative; cursor: pointer; }
  .ct-opt input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .ct-opt span { display: flex; align-items: center; gap: 9px; padding: 6px 17px 6px 12px; border-radius: 99px; background: var(--bg); font-size: 14px; font-weight: 500; transition: background 0.2s, color 0.2s; }
  .ct-opt span::before { content: ''; flex: none; width: 12px; height: 12px; border-radius: 3px; background: #fff; box-shadow: inset 0 0 0 2px #8a8f94; transition: background 0.2s, box-shadow 0.2s; }
  .ct-opt input[type='radio'] + span::before { border-radius: 50%; }
  .ct-opt:hover span { background: var(--tint); }
  .ct-opt input:checked + span { background: var(--ink); color: #fff; }
  .ct-opt input:checked + span::before { background: var(--key); box-shadow: none; }
  .ct-opt input:focus-visible + span { outline: 3px solid var(--key); outline-offset: 2px; }
  .ct-count { display: block; margin-top: 4px; text-align: right; font: 500 11.5px var(--mono); color: var(--mute); }
  .ct-count i { font-style: normal; color: var(--ink); }
  .ct-f.bad > span, .ct-f.bad > legend { color: var(--miss); }
  .ct-f.bad input[type='text'], .ct-f.bad input[type='email'], .ct-f.bad textarea { box-shadow: inset 0 0 0 2px var(--miss); }
  .ct-f.bad .ct-opt span { box-shadow: inset 0 0 0 2px var(--miss); }
  .ct-err { min-height: 1.6em; margin-top: -8px; font-size: 13.5px; font-weight: 700; color: var(--miss); }
  .ct-send { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; }
  .ct-send .btn.busy { pointer-events: none; background: var(--ink); color: #fff; }
  .ct-send .btn.busy i { animation: ct-go 0.8s linear infinite; }
  @keyframes ct-go { from { transform: translateX(-5px); opacity: 0.3; } 50% { opacity: 1; } to { transform: translateX(6px); opacity: 0.3; } }
  .ct-reply { font-size: 13px; color: var(--mute); }
  .ct-done { display: none; padding: clamp(30px, 5vw, 64px) clamp(18px, 2.6vw, 36px) clamp(34px, 5vw, 64px); }
  .ct-slip.is-done .ct-done { display: block; animation: ct-up 0.7s 0.5s both; }
  .ct-done__h { margin-bottom: 8px; font-size: clamp(28px, 3.4vw, 46px); font-weight: 900; line-height: 1.3; }
  .ct-done__n { margin: 26px 0 6px; font-size: 14px; color: var(--mute); }
  .ct-done .more { display: flex; width: fit-content; margin-top: 12px; }

  @media (max-width: 900px) {
    .ct { grid-template-columns: 1fr; }
    .ct-side { position: static; }
    .ct-deck { margin-right: 40px; }
    .ct-pts, .ct-row { grid-template-columns: 1fr; }
    .ct-stamp { width: 50px; height: 50px; font-size: 14.5px; top: 10px; }
    .ct-send .btn { flex: 1 1 100%; justify-content: space-between; }
    .ct-asmact .btn { flex: 1 1 100%; justify-content: space-between; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct-stp li::before, .ct-side h1, .ct-h, .ct-lead, .ct-stp li, .ct-direct, .ct-deck, .ct-slip { animation: none; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#form')!;
  const slip = document.querySelector<HTMLElement>('#slip')!;
  const err = document.querySelector<HTMLElement>('#err')!;
  const send = document.querySelector<HTMLButtonElement>('#send')!;
  const sendLabel = document.querySelector<HTMLElement>('#sendLabel')!;
  const count = document.querySelector<HTMLElement>('#count')!;
  const msg = form.elements.namedItem('message') as HTMLTextAreaElement;

  /* 票の番号（その日の日付と時刻から作る表示用の番号） */
  const d = new Date();
  document.querySelector('#slipNo')!.textContent =
    String(d.getFullYear()).slice(2) + String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0') + '-' + String(d.getHours()).padStart(2, '0') + String(d.getMinutes()).padStart(2, '0');

  /* トップの「アセスメントを相談する」から来たときは、アセスメントに印を付けておく */
  if (new URLSearchParams(location.search).get('topic') === 'assess') {
    const c = form.querySelector<HTMLInputElement>('input[name="phase"][value="アセスメント"]');
    if (c) c.checked = true;
  }

  /* 報告書の頁を1枚ずつ送る */
  const deck = document.querySelector<HTMLElement>('#deck');
  if (deck && !false) {
    const imgs = [...deck.querySelectorAll<HTMLImageElement>('img')];
    let busy = false;
    setInterval(() => {
      if (busy || document.hidden || deck.matches(':hover') || !deck.offsetParent) return;
      busy = true;
      const top = imgs.find((im) => im.style.getPropertyValue('--i') === '0')!;
      top.classList.add('out');
      setTimeout(() => {
        imgs.forEach((im) => { const i = Number(im.style.getPropertyValue('--i')); im.style.setProperty('--i', String(i === 0 ? imgs.length - 1 : i - 1)); });
        top.classList.remove('out'); busy = false;
      }, 650);
    }, 3200);
  }

  msg.addEventListener('input', () => (count.textContent = String(msg.value.length)));
  form.addEventListener('input', (e) => (e.target as HTMLElement).closest('.ct-f')?.classList.remove('bad'));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    const fd = new FormData(form);
    const val = (k: string) => String(fd.get(k) ?? '').trim();
    const missing: string[] = [];
    const need: [string, string][] = [['company', '会社名'], ['name', 'お名前'], ['email', 'メールアドレス'], ['systemType', 'いまの状況'], ['timeline', '始めたい時期'], ['message', '相談の内容']];
    form.querySelectorAll('.ct-f').forEach((f) => f.classList.remove('bad'));
    for (const [k, label] of need) {
      const ok = k === 'email' ? /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val(k)) : val(k) !== '';
      if (!ok) {
        missing.push(label);
        form.querySelector(`[name="${k}"]`)?.closest('.ct-f')?.classList.add('bad');
      }
    }
    if (missing.length) {
      err.textContent = `次の欄を確かめてください：${missing.join('、')}`;
      (form.querySelector('.ct-f.bad input, .ct-f.bad textarea') as HTMLElement | null)?.focus();
      return;
    }
    const phases = fd.getAll('phase').map(String);
    const body = {
      company: val('company'),
      name: val('name'),
      email: val('email'),
      phone: val('phone'),
      situation: val('systemType'),
      phases,
      topic: document.documentElement.classList.contains('is-asm') ? 'assessment' : 'general',
      timeline: val('timeline'),
      message: val('message'),
    };
    send.classList.add('busy');
    sendLabel.textContent = '送信しています';
    try {
      const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error('failed');
      slip.classList.add('is-done');
      /* 相談の送信を、アナリティクスの「見込み客の獲得」として記録する。個人を特定する情報は送らない */
      (window as any).gtag?.('event', 'generate_lead', {
        form_name: 'contact',
        lead_topic: body.topic,
        lead_from: new URLSearchParams(location.search).get('from') || '',
        lead_situation: body.situation,
        lead_phases: phases.join('・').slice(0, 90) || '（未選択）',
      });
      slip.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      err.textContent = '送信できませんでした。お手数ですが、もう一度お試しいただくか、電話・メールでご連絡ください。';
    } finally {
      send.classList.remove('busy');
      sendLabel.textContent = '送信する';
    }
  });
</script>
