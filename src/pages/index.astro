    pointer-events: none;
    z-index: 40;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }
  .frame span {
    position: absolute;
    background: var(--paper);
    padding: 2px 10px;
    line-height: 1.4;
  }
  .frame b { font-weight: 500; color: var(--ink); }
  .frame__tl { top: -9px; left: 22px; }
  .frame__tr { top: -9px; right: 22px; }

  /* ---------- ナビ ---------- */
  .nav {
    position: fixed;
    top: 10px;
    left: 10px;
    right: 10px;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px var(--gutter) 14px;
    background: linear-gradient(var(--paper) 55%, transparent);
  }
  .nav__logo {
    font-family: var(--mincho);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .nav__logo i { width: 8px; height: 8px; background: var(--shu); display: block; }
  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 32px);
    font-size: 13.5px;
    font-weight: 500;
  }
  .nav__links a:not(.nav__cta) { position: relative; }
  .nav__links a:not(.nav__cta)::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nav__links a:not(.nav__cta):hover::after { transform: scaleX(1); transform-origin: left; }
  .nav__cta { display: flex; align-items: center; gap: 14px; background: var(--shu); color: var(--paper); font-weight: 700; font-size: 14.5px; letter-spacing: 0.04em; padding: 11px 18px 11px 22px; box-shadow: 4px 4px 0 var(--ink); transition: box-shadow 0.25s, transform 0.25s; white-space: nowrap; }
  .nav__cta:hover { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }
  .nav__cta svg { width: 26px; }
  .nav__cta-s { display: none; }
  .nav__links > a { white-space: nowrap; }
  @media (max-width: 1400px) { .nav__lo { display: none; } }
  @media (max-width: 1180px) { .nav__links > a:not(.nav__page) { display: none; } .nav__sep { display: none; } }
  .nav__sep { width: 1px; height: 18px; background: var(--line); margin: 0 -4px; }
  .nav__page { font-weight: 700 !important; }
  .nav__act { position: relative; }
  .nav .nav__links .nav__act .nav__smp::after { display: none; }
  .nav .nav__links .nav__act .nav__smp { position: absolute; top: calc(100% + 14px); right: -4px; display: flex; align-items: baseline; gap: 9px; white-space: nowrap; background: var(--paper); border: 1px solid var(--ink); padding: 5px 12px 6px 14px; font-size: 12.5px; line-height: 1.5; transition: background 0.25s, color 0.25s; }
  .nav__smp::before { content: ''; position: absolute; right: 26px; bottom: 100%; width: 1px; height: 8px; background: var(--ink); }
  .nav__smp b { font-weight: 700; }
  .nav__smp span { font-family: var(--mono); font-size: 10.5px; color: var(--shu); transition: color 0.25s; }
  .nav__smp i { font-style: normal; font-size: 12px; }
  .nav__smp:hover { background: var(--ink); color: var(--paper); }
  .nav__smp:hover span { color: var(--paper); }

  /* ---------- 共通 ---------- */
  main { padding: 0 calc(var(--gutter) + 10px); }
  .tag {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--ink-2);
    margin: 0 0 26px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tag span { color: var(--paper); background: var(--ink); padding: 1px 9px; }
  .h2 {
    font-family: var(--mincho);
    font-weight: 700;
    font-size: clamp(27px, 4.2vw, 56px);
    line-height: 1.42;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .sec {
    padding: clamp(90px, 12vw, 180px) 0;
    border-top: 1px solid var(--ink);
    position: relative;
  }
  .sec__head { max-width: 980px; }
  .sec__lead { margin: 30px 0 0; max-width: 680px; color: var(--ink-2); }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    background: var(--ink);
    color: var(--paper);
    padding: 15px 26px 15px 30px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.08em;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--shu);
    transform: translateX(-101%);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: -1;
  }
  .btn:hover::before { transform: none; }
  svg[viewBox='0 0 40 10'] {
    width: 40px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    flex: none;
    transition: transform 0.35s;
  }
  .btn:hover svg { transform: translateX(6px); }
  .btn--lg { font-size: 18px; padding: 22px 38px 22px 44px; }
  .link { font-size: 14px; font-weight: 500; border-bottom: 1px solid var(--ink); padding-bottom: 2px; }

  .rv {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0s),
      transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0s);
  }
  .rv.in { opacity: 1; transform: none; }

  /* ---------- HERO ---------- */
  .hero {
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 70px);
    align-items: center;
    padding: 130px 0 80px;
  }
  .hero__h1 {
    font-family: var(--mincho);
    font-weight: 800;
    font-size: clamp(26px, 3.5vw, 60px);
    line-height: 1.3;
    letter-spacing: 0.01em;
    margin: 0 0 34px;
    white-space: nowrap;
  }
  .hero__h1 .hl { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hero__h1 .hl > span {
    display: inline-block;
    transform: translateY(108%);
    animation: rise 1.1s cubic-bezier(0.16, 0.9, 0.2, 1) forwards;
  }
  .hero__h1 .hl:nth-child(2) > span { animation-delay: 0.16s; }
  .hero__h1 em { font-style: normal; color: var(--shu); position: relative; }
  .hero__h1 em::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.05em;
    background: var(--shu);
    transform: scaleX(0);
    transform-origin: left;
    animation: sx 0.9s 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  @keyframes rise { to { transform: none; } }
  @keyframes sx { to { transform: scaleX(1); } }
  @keyframes fadeIn { to { opacity: 1; } }
  .hero__lead { max-width: 580px; font-size: clamp(15px, 1.2vw, 17px); margin: 0 0 40px; --d: 0.55s; }
  .hero__act { display: flex; align-items: center; gap: 30px; flex-wrap: wrap; --d: 0.7s; }
  .hero__fig svg { width: 100%; height: auto; display: block; overflow: visible; }
  .hero__cap {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: var(--ink-2);
    margin: 4px 0 0;
  }
  .hero__cap span { display: flex; align-items: center; gap: 8px; }
  .lg { display: block; }
  .lg--doc { width: 16px; height: 11px; background: var(--ink); }
  .lg--ai { width: 13px; height: 13px; border: 1.6px solid var(--shu); border-radius: 50%; }

  #erp .erp__path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    animation: draw 2.4s 0.3s cubic-bezier(0.5, 0, 0.2, 1) forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  #erp .node { opacity: 0; animation: fadeIn 0.6s forwards; }
  #erp .node:nth-of-type(1) { animation-delay: 0.3s; }
  #erp .node:nth-of-type(2) { animation-delay: 0.5s; }
  #erp .node:nth-of-type(3) { animation-delay: 0.7s; }
  #erp .node:nth-of-type(4) { animation-delay: 0.9s; }
  #erp .node:nth-of-type(5) { animation-delay: 1.1s; }
  #erp .node:nth-of-type(6) { animation-delay: 1.3s; }
  #erp .node:nth-of-type(7) { animation-delay: 1.5s; }
  #erp .node:nth-of-type(8) { animation-delay: 1.7s; }
  #erp .node:nth-of-type(9) { animation-delay: 1.9s; }
  #erp .node__box { fill: var(--paper); stroke: var(--ink); stroke-width: 1.4; }
  #erp .node__hit { fill: var(--ink); opacity: 0; transition: opacity 0.9s; }
  #erp .node.hit .node__hit { opacity: 0.1; transition: opacity 0.05s; }
  #erp text { font-family: var(--mono); fill: var(--ink); }
  #erp .node__k { font-size: 11px; letter-spacing: 0.12em; fill: var(--ink-2); }
  #erp .node__n { font-family: var(--gothic); font-weight: 700; font-size: 19px; }
  #erp .node__c { font-size: 10.5px; fill: var(--ink-2); letter-spacing: 0.06em; }
  #erp .node__ok { opacity: 0; transform: rotate(-12deg) scale(1.7); transform-box: fill-box; transform-origin: center; transition: opacity 1.2s 2.4s, transform 0s 3.6s; }
  #erp .node__ok circle { fill: var(--paper); stroke: var(--shu); stroke-width: 1.8; }
  #erp .node__ok text { font-family: var(--mincho); font-weight: 800; font-size: 14px; fill: var(--shu); }
  #erp .node.ok .node__ok { opacity: 1; transform: rotate(-12deg) scale(1); transition: opacity 0.12s, transform 0.28s cubic-bezier(0.3, 1.6, 0.5, 1); }
  #erp #tokens rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1.4; }
  #erp #tokens path { fill: none; stroke: var(--ink); stroke-width: 1.2; }
  #erp .erp__march { fill: none; stroke: var(--ink); stroke-width: 3; stroke-dasharray: 2 14; opacity: 0; animation: fadeIn 0.8s 2.6s forwards, march 1.1s linear infinite; }
  @keyframes march { to { stroke-dashoffset: -16; } }
  #erp #scan { opacity: 0; }
  #erp #scan circle { fill: none; stroke: var(--shu); stroke-width: 2; }
  #erp #scan .dot { fill: var(--shu); stroke: none; }
  #erp #scan text { fill: var(--shu); font-size: 12px; font-weight: 500; letter-spacing: 0.1em; }


  /* ---------- 02 現場の映像 ---------- */
  .scr { margin-top: clamp(40px, 5vw, 70px); background: #151412; color: #e9e4d7; border: 1px solid var(--ink); box-shadow: 14px 14px 0 var(--paper-2), 14px 14px 0 1px var(--ink); position: relative; overflow: hidden; --hl: #34322d; }
  .scr__top { display: grid; grid-template-columns: auto 1fr auto; gap: clamp(12px, 2vw, 28px); align-items: center; padding: 12px clamp(14px, 1.8vw, 26px); border-bottom: 1px solid var(--hl); font-size: 12px; }
  .scr__pj { display: flex; align-items: center; gap: 9px; color: #a8a396; white-space: nowrap; }
  .scr__pj i { width: 8px; height: 8px; border-radius: 50%; background: var(--shu); animation: rec 1.2s infinite; }
  @keyframes rec { 50% { opacity: 0.25; } }
  .scr__day { height: 2px; background: var(--hl); position: relative; }
  .scr__day u { position: absolute; inset: 0; background: #e9e4d7; transform-origin: left; transform: scaleX(var(--p, 0)); }
  .scr__clock { font-family: var(--mono); font-weight: 500; font-size: clamp(20px, 2.4vw, 34px); letter-spacing: 0.02em; line-height: 1; }
  .scr__grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .pane { border-right: 1px solid var(--hl); border-bottom: 1px solid var(--hl); height: clamp(170px, 17vw, 250px); display: flex; flex-direction: column; min-width: 0; }
  .pane:nth-child(3n) { border-right: 0; }
  .pane__h { display: flex; align-items: center; gap: 9px; padding: 9px 14px; font-size: 12px; border-bottom: 1px solid var(--hl); white-space: nowrap; }
  .pane__h i { width: 7px; height: 7px; background: #e9e4d7; flex: none; animation: rec 0.9s infinite; }
  .pane__h span { margin-left: auto; color: #8f8a7e; font-size: 11px; overflow: hidden; text-overflow: ellipsis; }
  .pane__h u { text-decoration: none; font-family: var(--mono); color: #e9e4d7; font-size: 14px; margin-left: 8px; }
  .pane__b { flex: 1; overflow: hidden; padding: 8px 14px; display: flex; flex-direction: column; justify-content: flex-end; gap: 5px; font-family: var(--mono); font-size: clamp(10px, 0.82vw, 12px); line-height: 1.5; -webkit-mask-image: linear-gradient(transparent, #000 34%); mask-image: linear-gradient(transparent, #000 34%); }
  @keyframes rowin { from { opacity: 0; transform: translateY(10px); } }
  @keyframes codein { from { transform: scaleX(0); } }
  .pane--human { background: #e9e4d7; color: var(--ink); }
  .pane--human .pane__h { border-color: var(--line); }
  .pane--human .pane__h i { background: var(--shu); border-radius: 50%; }
  .pane--human .pane__h span { color: var(--ink-2); }
  .pane--human .pane__h u { color: var(--ink); }
  .pane--human .pane__b { -webkit-mask-image: none; mask-image: none; }
  .scr__cap { margin: 0; padding: clamp(16px, 2.2vw, 30px) clamp(14px, 1.8vw, 26px); font-family: var(--mincho); font-weight: 700; font-size: clamp(19px, 2.9vw, 42px); line-height: 1.4; letter-spacing: 0.02em; }
  .scr__cap.sw { animation: capin 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes capin { from { opacity: 0; transform: translateY(16px); } }

  /* ---------- 03 AIチームという入り方 ---------- */
  .org { margin-top: clamp(44px, 6vw, 84px); display: grid; justify-items: center; }
  .org__top, .org__tt { border: 1px solid var(--ink); background: var(--paper); padding: 14px 30px; text-align: center; position: relative; }
  .org b { display: block; font-family: var(--mincho); font-weight: 800; font-size: clamp(18px, 1.9vw, 26px); line-height: 1.5; }
  .org span { display: block; font-size: 13px; color: var(--ink-2); line-height: 1.7; }
  .org__top::after, .org__tt::before { content: ''; position: absolute; left: 50%; width: 1px; height: 34px; background: var(--ink); }
  .org__top::after { top: 100%; }
  .org__tt::before { bottom: 100%; border-left: 1px dashed var(--shu); background: none; }
  .org__ai { margin-top: 34px; margin-bottom: 34px; display: grid; grid-template-columns: repeat(5, 1fr); width: 100%; border-top: 1px solid var(--ink); gap: clamp(8px, 1.2vw, 18px); padding-top: 24px; position: relative; }
  .mem { border: 1px solid var(--ink); background: var(--ink); color: var(--paper); padding: 16px 14px 18px; position: relative; opacity: 0; transform: translateY(20px); }
  .org.in .mem { opacity: 1; transform: none; transition: opacity 0.7s var(--d), transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d); }
  .mem::before { content: ''; position: absolute; left: 50%; bottom: 100%; width: 1px; height: 24px; background: var(--ink); }
  .mem em { font-style: normal; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; background: var(--shu); padding: 0 8px; }
  .mem b { margin-top: 8px; }
  .mem span { color: #c9c4b6; }
  .org__tt { border-color: var(--shu); }
  .org__tt b { color: var(--shu); }
  .vs { display: grid; grid-template-columns: 1fr 1fr; margin-top: clamp(44px, 6vw, 84px); border: 1px solid var(--ink); background: var(--paper); }
  .vs__c { padding: clamp(20px, 2.8vw, 44px); }
  .vs__c + .vs__c { border-left: 1px solid var(--ink); }
  .vs__k { margin: 0 0 10px; font-size: 13px; font-weight: 700; display: inline-block; border: 1px solid var(--ink); padding: 0 12px; }
  .vs__c--on .vs__k { background: var(--shu); border-color: var(--shu); color: var(--paper); }
  .vs svg { width: 100%; height: auto; display: block; }
  .vs .ax { fill: none; stroke: var(--ink); stroke-width: 1; }
  .vs .end { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 4 4; }
  .vs text { font-size: 11px; fill: var(--ink-2); font-family: var(--gothic); }
  .vs .ln2 { fill: none; stroke: var(--ink); stroke-width: 2.6; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.4s cubic-bezier(0.5, 0, 0.2, 1) calc(var(--d, 0s) + 0.4s); }
  .vs__c--on .ln2 { stroke: var(--shu); stroke-width: 3; }
  .vs .area { fill: var(--shu); opacity: 0; transition: opacity 1.2s 2.2s; }
  .vs__c.in .ln2 { stroke-dashoffset: 0; }
  .vs__c.in .area { opacity: 0.12; }
  .vs .man circle, .vs .man path { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .vs .man { opacity: 0; transition: opacity 0.5s 1s; }
  .vs__c.in .man { opacity: 1; animation: leave 0.8s 3s forwards; }
  @keyframes leave { to { opacity: 0.12; } }
  .vs h3 { margin: 14px 0 0; font-family: var(--mincho); font-weight: 700; font-size: clamp(19px, 2.2vw, 30px); line-height: 1.5; }


  /* ---------- 05 流れとつながり ---------- */
  .tr { margin-top: clamp(40px, 5vw, 70px); border: 1px solid var(--ink); background: var(--paper); }
  .tr__figs { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; }
  .tr__fig { margin: 0; padding: clamp(14px, 2vw, 30px); min-width: 0; }
  .tr__fig figcaption { font-size: 13px; font-weight: 700; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
  .tr__fig figcaption::before { content: ''; width: 9px; height: 9px; background: var(--ink); }
  .tr__fig svg { width: 100%; height: auto; display: block; overflow: visible; }
  .tr__mid { display: grid; align-content: center; justify-items: center; gap: 10px; padding: 0 6px; border-inline: 1px solid var(--line); text-align: center; }
  .tr__mid span { width: 48px; height: 48px; border-radius: 50%; background: var(--ink); color: var(--paper); display: grid; place-items: center; font-family: var(--mono); font-size: 14px; }
  .tr__mid p { margin: 0; font-size: 11.5px; line-height: 1.6; color: var(--ink-2); padding: 0 10px; }
  .tr svg text { font-family: var(--gothic); font-size: 12px; fill: var(--ink); }
  .tr .lane { fill: none; stroke: var(--line); stroke-width: 1; }
  .tr .lane__t { fill: var(--ink-2); font-size: 11.5px; }
  .tr .idt { font-family: var(--mono); font-size: 10px; fill: var(--ink-2); letter-spacing: 0.04em; }
  .tr .fl, .tr .sm__l { fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.7s var(--t) cubic-bezier(0.5, 0, 0.2, 1), stroke 0.3s; }
  .tr .sm__h { fill: none; stroke: var(--ink); stroke-width: 1.3; opacity: 0; transition: opacity 0.3s calc(var(--t) + 0.6s), stroke 0.3s; }
  .tr .life { stroke: var(--line); stroke-width: 1; stroke-dasharray: 4 4; }
  .tr .head { fill: var(--paper); stroke: var(--ink); stroke-width: 1.2; }
  .tr .head__t { font-weight: 700; }
  .tr .fs { opacity: 0; cursor: pointer; transition: opacity 0.5s var(--t); }
  .tr .fs rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1.3; transition: fill 0.3s, stroke 0.3s; }
  .tr .fs text { transition: fill 0.3s; }
  .tr .fs text:not(.idt) { font-size: 10.5px; font-weight: 700; }
  .tr .sm { cursor: pointer; }
  .tr .sm text { opacity: 0; transition: opacity 0.4s calc(var(--t) + 0.3s), fill 0.3s; }
  .tr.in .fl, .tr.in .sm__l { stroke-dashoffset: 0; }
  .tr.in .sm__h, .tr.in .fs, .tr.in .sm text { opacity: 1; }
  .tr .fs.hi rect { fill: var(--shu); stroke: var(--shu); }
  .tr .fs.hi text { fill: var(--paper); }
  .tr .fs.hi .idt { fill: var(--shu); font-weight: 500; }
  .tr .sm.hi .sm__l, .tr .sm.hi .sm__h { stroke: var(--shu); stroke-width: 2.4; }
  .tr .sm.hi text { fill: var(--shu); font-weight: 700; }
  .tr__chain { border-top: 1px solid var(--ink); padding: clamp(18px, 2.4vw, 36px); }
  .tr__lead { margin: 0 0 20px; font-family: var(--mincho); font-weight: 700; font-size: clamp(17px, 2vw, 28px); line-height: 1.5; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 12px; }
  .tr__lead b { font-family: var(--mono); font-weight: 500; font-size: 0.72em; background: var(--shu); color: var(--paper); padding: 0 10px; }
  .tr__lead span { color: var(--shu); }
  .tr__chain ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0 34px; }
  .tr__chain li { border: 1px solid var(--ink); padding: 10px 14px 12px; position: relative; background: var(--paper); }
  .tr__chain li:first-child { border-color: var(--shu); }
  .tr__chain li + li::before { content: ''; position: absolute; right: 100%; top: 50%; width: 34px; height: 2px; background: var(--shu); transform-origin: left; transform: scaleX(0); margin-right: 0; }
  .tr__chain li + li::after { content: ''; position: absolute; right: calc(100% + 1px); top: 50%; width: 8px; height: 8px; border-top: 2px solid var(--shu); border-right: 2px solid var(--shu); transform: translateY(-50%) rotate(45deg) translate(-1px, 1px); opacity: 0; }
  .tr__chain em { font-style: normal; display: block; font-size: 11.5px; color: var(--ink-2); }
  .tr__chain b { font-family: var(--mono); font-weight: 500; font-size: clamp(13px, 1.5vw, 21px); letter-spacing: 0.02em; white-space: nowrap; }
  .tr.go .tr__chain li { animation: pop 0.45s calc(var(--i) * 0.28s) cubic-bezier(0.3, 1.4, 0.5, 1) both; }
  .tr.go .tr__chain li + li::before { animation: trl 0.3s calc(var(--i) * 0.28s - 0.12s) both; }
  .tr.go .tr__chain li + li::after { animation: fadeIn 0.2s calc(var(--i) * 0.28s) both; }
  .tr__chain li + li::before { transform: scaleX(1); }
  .tr__chain li + li::after { opacity: 1; }
  @keyframes trl { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* ---------- 02 抜き取りと全件 ---------- */
  .cmp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 4vw, 60px);
    margin-top: clamp(50px, 6vw, 90px);
  }
  .cmp__name { font-size: 13.5px; font-weight: 700; margin: 0 0 12px; }
  .cmp__col--now .cmp__name { color: var(--shu); }
  .cells { display: grid; grid-template-columns: repeat(14, 1fr); gap: 4px; }
  .cells i {
    display: block;
    aspect-ratio: 1 / 1.25;
    border: 1px solid var(--line);
    background: var(--paper);
    transition: background 0.3s, border-color 0.3s, transform 0.3s;
  }
  .cells i.on { background: var(--ink); border-color: var(--ink); }
  .cells i.on.d,
  .cells i.left { background: var(--shu); border-color: var(--shu); }
  .cells i.left { background: transparent; border-style: dashed; border-width: 2px; }
  .cells i.on.d { transform: scale(1.14); }
  .cmp__read {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--ink-2);
    margin: 12px 0 0;
  }
  .cmp__read b { font-weight: 500; color: var(--ink); font-size: 15px; }
  .cmp__read .miss { color: var(--shu); opacity: 0; transition: opacity 0.4s; }
  .cmp__read .miss.on { opacity: 1; }

  /* ---------- 02 工程 ---------- */
  .ph { margin-top: clamp(60px, 7vw, 100px); }
  .ph__bar { display: grid; grid-template-columns: repeat(6, 1fr); border: 1px solid var(--ink); background: var(--paper); }
  .ph__tab {
    font: inherit;
    font-weight: 700;
    font-size: clamp(12px, 1.15vw, 15px);
    background: transparent;
    color: var(--ink);
    border: 0;
    border-right: 1px solid var(--ink);
    padding: 12px 6px 14px;
    cursor: pointer;
    position: relative;
    transition: background 0.35s, color 0.35s;
    line-height: 1.5;
  }
  .ph__tab:last-child { border-right: 0; }
  .ph__tab small { display: block; font-family: var(--mono); font-weight: 400; font-size: 10.5px; opacity: 0.6; }
  .ph__tab.is-on { background: var(--ink); color: var(--paper); }
  .ph__tab::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: var(--shu);
    transform: scaleX(0);
    transform-origin: left;
  }
  .ph.auto .ph__tab.is-on::after { animation: sx 8.2s linear forwards; }
  .ph__panes { display: grid; border: 1px solid var(--ink); border-top: 0; background: var(--paper); }
  .ph__pane {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
    gap: clamp(16px, 3vw, 44px);
    align-items: center;
    padding: clamp(24px, 3.4vw, 50px);
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }
  .ph__pane.is-on { opacity: 1; transform: none; pointer-events: auto; transition: opacity 0.5s 0.05s, transform 0.5s 0.05s; }

  .st { position: absolute; inset: 0; padding: 6.5% 6%; display: grid; gap: 4%; opacity: 0; transform: scale(0.97); pointer-events: none; }
  .st.is-on { opacity: 1; transform: none; transition: opacity 0.5s, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .st em { font-style: normal; font-size: 0.9em; color: var(--ink-2); display: block; margin-bottom: 0.9em; letter-spacing: 0.04em; }
  .st em.mt { margin-top: 1.4em; }
  .box { background: var(--paper); border: 1px solid var(--line); border-radius: 0; padding: 7% 8%; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 0.8em; min-width: 0; }
  .box > em { margin-bottom: 0.2em; }
  .ln { display: block; height: 0.7em; border-radius: 0; background: var(--line); width: var(--w, 80%); margin-left: var(--in, 0); transform-origin: left; flex: none; }
  .cp { display: flex; align-items: center; gap: 0.7em; font-weight: 700; font-size: 0.95em; border-radius: 0; padding: 0.42em 1em 0.42em 0.5em; background: var(--paper-2); white-space: nowrap; min-width: 0; }
  .cp::before { content: '✓'; flex: none; width: 1.6em; height: 1.6em; border-radius: 50%; background: var(--ink); color: var(--paper); display: grid; place-items: center; font-size: 0.82em; font-weight: 900; }
  .cp.ng::before { content: '!'; background: var(--shu); color: var(--paper); }
  .cp > i { display: block; height: 0.55em; border-radius: 0; background: var(--line); }
  .aibadge { align-self: center; justify-self: center; width: 3.6em; height: 3.6em; border-radius: 50%; background: var(--ink); color: var(--paper); font-family: var(--mono); font-weight: 700; font-size: 1.15em; display: grid; place-items: center; box-shadow: 0 0 40px transparent; }
  .st.run .aibadge { animation: pop 0.5s var(--t, 0s) both, pulse 1.6s calc(var(--t, 0s) + 0.5s) infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 70px transparent; transform: scale(1.07); } }

  .st.run .p { animation: pop 0.55s var(--t, 0s) cubic-bezier(0.3, 1.4, 0.5, 1) both; }
  .st.run .ty { animation: ty 0.5s var(--t, 0s) cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  @keyframes pop { from { opacity: 0; transform: translateY(14px) scale(0.9); } to { opacity: 1; transform: none; } }
  @keyframes ty { from { transform: scaleX(0); opacity: 0.3; } to { transform: scaleX(1); opacity: 1; } }

  .st--req { grid-template-columns: 1fr auto 1fr; }
  .bb { display: block; height: 2.1em; border-radius: 0; background: var(--paper-2); width: var(--w); flex: none; }
  .bb.r { align-self: flex-end; border-radius: 0; background: var(--line); }
  .st--req .cp > i { flex: 1; max-width: 100%; }

  .st--des { grid-template-columns: 1.25fr 1fr; }
  .st--des .doc { gap: 1.05em; }
  .st.run .ln.flag { animation: ty 0.5s var(--t, 0s) cubic-bezier(0.2, 0.8, 0.2, 1) both, flag 0.4s 4.2s both; }
  .ln.flag { background: var(--shu); box-shadow: 0 0 18px transparent; }
  @keyframes flag { from { background: var(--line); box-shadow: none; } to { background: var(--shu); box-shadow: 0 0 18px transparent; } }
  .scanl { position: absolute; left: 0; right: 0; top: 0; height: 22%; background: linear-gradient(transparent, transparent); border-bottom: 2px solid var(--ink); opacity: 0; }
  .st.run .scanl { animation: scanl 1.7s 2.7s cubic-bezier(0.4, 0, 0.4, 1) both; }
  @keyframes scanl { 0% { transform: translateY(-100%); opacity: 1; } 90% { opacity: 1; } 100% { transform: translateY(360%); opacity: 0; } }
  .st--des .side { justify-content: center; }

  .st--dev { grid-template-columns: 0.62fr auto 1.2fr; grid-template-rows: 1fr auto; }
  .st--dev .tags { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.7em; }
  .st--dev .code { background: var(--paper-2); gap: 0.75em; }
  .ln.c0 { background: var(--ink); }
  .ln.c1 { background: var(--line); }
  .ln.c2 { background: var(--ink-2); }

  .st--tst { grid-template-columns: 1.5fr 0.7fr; }
  .sap { padding: 0 0 6%; gap: 1em; }
  .sap__bar { display: flex; align-items: center; gap: 0.5em; background: var(--paper-2); padding: 0.8em 1.2em; }
  .sap__bar i { width: 0.7em; height: 0.7em; border-radius: 50%; background: var(--line); display: block; }
  .sap__bar span { margin-left: 0.8em; font-weight: 700; color: var(--ink); }
  .sap label { display: grid; grid-template-columns: 5em 1fr; align-items: center; gap: 1em; padding: 0 8%; color: var(--ink-2); }
  .fld { display: block; height: 2.3em; border: 1px solid var(--line); border-radius: 0; padding: 0.72em 0.8em; }
  .fld u { display: block; height: 100%; width: var(--w); background: var(--ink); border-radius: 0; transform-origin: left; }
  .sap__btn { align-self: flex-end; margin-right: 8%; background: var(--ink); color: var(--paper); font-weight: 700; border-radius: 0; padding: 0.35em 1.6em; }
  .st.run .sap__btn { animation: press 0.35s 4.05s both; }
  @keyframes press { 50% { transform: scale(0.9); background: var(--ink); } }
  .sap__msg { margin: 0 8%; color: var(--ink); font-weight: 700; border-left: 3px solid var(--ink); padding-left: 0.9em; }
  .cur { position: absolute; left: 0; top: 0; width: 0; height: 0; border: 0.55em solid transparent; border-top: 1em solid var(--ink); border-left-color: var(--ink); transform: translate(60em, 3em); filter: drop-shadow(0 0 8px transparent); opacity: 0; }
  .st.run .cur { animation: cur 4.4s 0.3s cubic-bezier(0.5, 0, 0.3, 1) both; }
  @keyframes cur {
    0% { left: 80%; top: 8%; opacity: 0; }
    8% { opacity: 1; }
    16%, 32% { left: 44%; top: 30%; }
    38%, 52% { left: 44%; top: 46%; }
    58%, 72% { left: 44%; top: 62%; }
    84%, 96% { left: 82%; top: 78%; opacity: 1; }
    100% { left: 82%; top: 78%; opacity: 0; }
  }
  .cur { transform: none; }
  .flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
  .st.run .flash { animation: flash 0.5s 4.9s both; }
  @keyframes flash { 0% { opacity: 0; } 25% { opacity: 0.3; } 100% { opacity: 0; } }
  .st--tst .ev { justify-content: center; }
  .shot { display: flex; flex-direction: column; gap: 0.45em; border: 1.5px solid var(--shu); border-radius: 0; padding: 0.8em; background: var(--paper); }
  .shot i { display: block; height: 0.5em; border-radius: 0; background: var(--line); }
  .shot i:nth-child(2) { width: 70%; }
  .shot i:nth-child(3) { width: 40%; background: var(--ink); }

  .st--mig { grid-template-columns: 1fr 0.5fr 1fr; grid-template-rows: 1fr auto; }
  .tbl { gap: 0.62em; }
  .row { display: block; height: 1.15em; border-radius: 0; background: repeating-linear-gradient(90deg, var(--line) 0 22%, transparent 22% 25%); position: relative; transform-origin: left; flex: none; }
  .tbl.new .row { background: repeating-linear-gradient(90deg, var(--ink) 0 22%, transparent 22% 25%); }
  .tbl.new .row.warn { background: repeating-linear-gradient(90deg, var(--shu) 0 22%, transparent 22% 25%); }
  .row s { position: absolute; right: -0.2em; top: 50%; width: 1.25em; height: 1.25em; margin-top: -0.62em; border-radius: 50%; background: var(--ink); }
  .row.warn s { background: var(--shu); }
  .pipe { position: relative; align-self: center; height: 2px; background: var(--line); }
  .pipe u { position: absolute; top: -0.35em; left: 0; width: 0.75em; height: 0.75em; border-radius: 50%; background: var(--ink); box-shadow: 0 0 12px var(--ink); animation: pipe 1.5s calc(var(--k) * -0.25s) linear infinite; }
  @keyframes pipe { from { left: 0; opacity: 0; } 15%, 85% { opacity: 1; } to { left: 100%; opacity: 0; } }
  .prog { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.2em; font-weight: 700; }
  .prog i { display: block; height: 0.7em; border-radius: 0; background: var(--paper-2); overflow: hidden; }
  .prog u { display: block; height: 100%; background: var(--ink); border-radius: 0; transform-origin: left; }
  .st.run .prog u { animation: fill 3.6s 0.5s linear both; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .st--ope { grid-template-columns: 1fr; align-content: center; gap: 1.3em; padding-inline: 10%; }
  .q { justify-self: end; background: var(--paper-2); border-radius: 0; padding: 0.8em 1.4em; font-weight: 700; font-size: 1.1em; }
  .dots { display: flex; gap: 0.4em; height: 0; opacity: 0; }
  .dots i { width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--ink); display: block; animation: blink 0.9s infinite; }
  .dots i:nth-child(2) { animation-delay: 0.15s; }
  .dots i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes blink { 50% { opacity: 0.2; transform: translateY(-0.2em); } }
  .st.run .dots { animation: dots 1.5s 1s both; }
  @keyframes dots { 0%, 100% { opacity: 0; height: 0; } 12%, 88% { opacity: 1; height: 0.6em; } }
  .a { justify-self: start; width: 78%; background: var(--paper); border: 1px solid var(--ink); border-radius: 0; padding: 1.3em 1.5em; display: grid; gap: 0.8em; box-shadow: 0 0 40px transparent; }
  .a .ln { background: var(--line); }
  .srcs { display: flex; flex-wrap: wrap; gap: 0.6em; margin-top: 0.4em; }
  .by { justify-self: start; color: var(--ink-2); font-size: 0.95em; border: 1px dashed var(--ink-2); border-radius: 0; padding: 0.2em 1.2em; }

  .ph__stage { position: relative; aspect-ratio: 16 / 10; border: 1px solid var(--line); overflow: hidden; font-size: clamp(9.5px, 0.92vw, 13px); background: linear-gradient(var(--hair) 1px, transparent 1px) 0 0 / 14px 14px, linear-gradient(90deg, var(--hair) 1px, transparent 1px) 0 0 / 14px 14px; }
  .ph__stage .st { opacity: 1; transform: none; }
  .ph__stage .box { border-color: var(--ink); }
  .ph__stage .a { border-color: var(--ink); }
  .ph__stage .cp { border: 1px solid var(--line); }
  .ph__cap p { margin: 0 0 12px; display: flex; align-items: baseline; gap: 12px; }
  .ph__cap b { flex: none; font-size: 11.5px; font-weight: 700; padding: 0 9px; line-height: 1.8; }
  .ph__line { font-family: var(--mincho); font-weight: 700; font-size: clamp(18px, 2vw, 28px); line-height: 1.6; }
  .ph__line b { background: var(--shu); color: var(--paper); font-family: var(--gothic); }
  .ph__human { color: var(--ink-2); font-size: 15px; }
  .ph__human b { border: 1px solid var(--ink-2); }

  .pm { --pm-card: var(--paper); --pm-edge: var(--ink); --pm-fig: linear-gradient(var(--hair) 1px, transparent 1px) 0 0 / 14px 14px, linear-gradient(90deg, var(--hair) 1px, transparent 1px) 0 0 / 14px 14px; --pm-figedge: var(--line); --pm-fg: var(--ink); --pm-mute: var(--ink-2); --pm-dim: var(--line); --pm-ai: var(--ink); --pm-hot: var(--shu); --pm-on: var(--paper); --pm-rad: 0px; --pm-gap: 0px; --pm-hf: 700 1em var(--mincho); --pm-nf: var(--mono); }
  .pm .pmt:nth-child(odd) { border-right: 0; }
  .pm .pmt:nth-child(-n + 2) { border-bottom: 0; }

  /* ---------- プロジェクト管理 ---------- */
  .pm__cmp { display: grid; gap: 0; margin-top: clamp(40px, 5vw, 70px); border-top: 1px solid var(--pm-edge); }
  .pm__cmp div { display: grid; grid-template-columns: 8em 1fr auto 1.4fr; gap: clamp(10px, 2vw, 30px); align-items: baseline; padding: clamp(10px, 1.3vw, 18px) 0; border-bottom: 1px solid var(--pm-edge); }
  .pm__cmp span { font-size: 12.5px; color: var(--pm-mute); }
  .pm__cmp s { color: var(--pm-mute); text-decoration-thickness: 1px; font-size: clamp(14px, 1.5vw, 20px); }
  .pm__cmp i { font-style: normal; color: var(--pm-hot); }
  .pm__cmp b { font: var(--pm-hf); font-size: clamp(18px, 2.4vw, 34px); line-height: 1.4; }
  .pm__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--pm-gap); margin-top: clamp(30px, 4vw, 56px); }
  .pmt { background: var(--pm-card); border: 1px solid var(--pm-edge); border-radius: var(--pm-rad); padding: clamp(18px, 2.2vw, 34px); }
  .pmt h3 { margin: 22px 0 0; font: var(--pm-hf); font-size: clamp(17px, 1.7vw, 23px); line-height: 1.6; }
  .pmf { height: 230px; border-radius: calc(var(--pm-rad) * 0.6); background: var(--pm-fig); border: 1px solid var(--pm-figedge); padding: 20px 24px; position: relative; overflow: hidden; font-size: 12px; color: var(--pm-mute); }
  .pmf em { font-style: normal; display: block; font-size: 11.5px; margin-bottom: 10px; letter-spacing: 0.04em; }
  .pmf.run .pp { animation: pop 0.55s var(--t, 0s) cubic-bezier(0.3, 1.4, 0.5, 1) both; }

  .pmf--pick { display: grid; grid-template-columns: 1fr auto 1.15fr; gap: 18px; align-items: center; }
  .pk__in, .pk__out { display: flex; flex-direction: column; gap: 9px; }
  .pk__in i { display: block; height: 24px; width: var(--w); background: var(--pm-dim); border-radius: calc(var(--pm-rad) * 0.5); opacity: 0.7; }
  .pk__in i:nth-of-type(even) { align-self: flex-end; }
  .pk__ai { width: 46px; height: 46px; border-radius: 50%; background: var(--pm-ai); color: var(--pm-on); display: grid; place-items: center; font-weight: 700; font-size: 13px; }
  .pk__out b { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: center; border: 1px solid var(--pm-edge); border-radius: calc(var(--pm-rad) * 0.4); padding: 7px 10px; background: var(--pm-card); }
  .pk__out u { text-decoration: none; font-size: 11px; font-weight: 700; color: var(--pm-on); background: var(--pm-ai); padding: 0 8px; border-radius: var(--pm-rad); }
  .pk__out u.r { background: var(--pm-hot); color: #fff; }
  .pk__out b > i { display: block; height: 6px; background: var(--pm-dim); border-radius: 99px; }

  .pmf--prob { display: grid; grid-template-columns: auto 1fr; gap: 24px; align-items: end; }
  .pb__num p { margin: 0; color: var(--pm-fg); line-height: 1; white-space: nowrap; }
  .pb__num b { font-family: var(--pm-nf); font-weight: 500; font-size: clamp(54px, 6vw, 88px); letter-spacing: -0.04em; }
  .pb__num small { font-size: 22px; margin-left: 4px; }
  .pb__plot { position: relative; height: 100%; border-bottom: 1px solid var(--pm-fg); overflow: hidden; }
  .pb__late { position: absolute; top: 0; bottom: 0; right: 0; left: 58%; background: color-mix(in srgb, var(--pm-hot) 20%, transparent); }
  .pb__late { display: grid; place-items: start end; padding: 4px 8px; font-size: 11px; font-weight: 700; color: var(--pm-fg); }
  .pb__dl { position: absolute; top: 0; bottom: 0; left: 58%; border-left: 2px dashed var(--pm-hot); }
  .pb__dl u { position: absolute; top: 2px; right: 6px; text-decoration: none; font-size: 11px; font-weight: 700; color: var(--pm-hot); white-space: nowrap; }
  .pb__bars { position: absolute; inset: 22px 0 0 14%; display: flex; align-items: flex-end; gap: 3px; width: 78%; }
  .pb__bars i { flex: 1; height: var(--h); background: var(--pm-ai); transform-origin: bottom; border-radius: calc(var(--pm-rad) * 0.15) calc(var(--pm-rad) * 0.15) 0 0; }
  .pmf.run .py { animation: py 0.5s var(--t) cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .pmf.run .pb__bars { animation: pbs 1.6s 3.2s cubic-bezier(0.6, 0, 0.2, 1) both; }
  @keyframes py { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes pbs { from { transform: translateX(0); } to { transform: translateX(-24%); } }
  .pb__bars { transform: translateX(-24%); }

  .od { position: relative; height: 160px; }
  .od__r { position: absolute; left: 0; right: 0; top: calc(var(--y1) * 32px); height: 22px; display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: center; }
  .od__r u { text-decoration: none; font-family: var(--pm-nf); font-size: 12px; color: var(--pm-mute); }
  .od__r i { display: block; height: 100%; width: var(--w); background: var(--pm-dim); border-radius: calc(var(--pm-rad) * 0.3); }
  .od__r.top i { background: var(--pm-ai); }
  .od__r.top u { color: var(--pm-fg); font-weight: 700; }
  .pmf.run .od__r { animation: odm 1s 1.4s cubic-bezier(0.6, 0, 0.2, 1) both; }
  .pmf.run .od__r i { animation: odc 0.5s 2.5s both; }
  .pmf.run .od__r u { animation: odu 0.4s 2.4s both; }
  @keyframes odm { from { top: calc(var(--y0) * 32px); } to { top: calc(var(--y1) * 32px); } }
  @keyframes odc { from { background: var(--pm-dim); } }
  @keyframes odu { from { opacity: 0; } }

  .pmf--net svg { position: absolute; inset: 16px 16px 44px; width: calc(100% - 32px); height: calc(100% - 60px); overflow: visible; }
  .nl { stroke: var(--pm-fg); stroke-width: 1; stroke-dasharray: 1; opacity: 0.55; }
  .nd { fill: var(--pm-card); stroke: var(--pm-fg); stroke-width: 1.2; }
  .hub { fill: var(--pm-hot); }
  .pmf.run .nl { animation: nl 0.7s var(--t) both; }
  .pmf.run .hub { animation: hub 2.6s 0.2s both, hubp 1.4s 2.8s infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes nl { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes hub { 0%, 80% { fill: var(--pm-card); stroke: var(--pm-fg); stroke-width: 1.2; } 100% { fill: var(--pm-hot); } }
  @keyframes hubp { 50% { transform: scale(1.3); } }
  .nt { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); white-space: nowrap; font-size: 12px; color: #fff; background: var(--pm-hot); padding: 1px 14px; border-radius: var(--pm-rad); }
  .pmf.run .nt { animation: ntp 0.5s 3s both; }
  @keyframes ntp { from { opacity: 0; } to { opacity: 1; } }

  @media (max-width: 900px) {
    .pm__cmp div { grid-template-columns: 1fr auto 1.3fr; }
    .pm__cmp span { grid-column: 1 / -1; }
    .pm__grid { grid-template-columns: 1fr; }
    .pmf { height: 210px; padding: 16px; }
  }

  /* ---------- 03 導入 ---------- */
  .merits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(50px, 6vw, 90px);
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .merit { padding: clamp(22px, 3vw, 46px); border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .merit:nth-child(2n) { border-right: 0; }
  .merit:nth-last-child(-n + 2) { border-bottom: 0; }
  .merit__fig {
    height: 170px;
    border: 1px solid var(--line);
    margin-bottom: 26px;
    padding: 18px 22px;
    display: grid;
    align-items: center;
    background:
      linear-gradient(var(--hair) 1px, transparent 1px) 0 0 / 14px 14px,
      linear-gradient(90deg, var(--hair) 1px, transparent 1px) 0 0 / 14px 14px;
    font-size: 11.5px;
    color: var(--ink-2);
  }
  .merit__name { font-family: var(--mincho); font-weight: 700; font-size: clamp(19px, 1.9vw, 26px); margin: 0 0 12px; line-height: 1.55; }
  .merit__body { margin: 0; font-size: 14.5px; color: var(--ink-2); }

  .g-shift { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; height: 100%; align-items: end; }
  .g-shift__c { display: grid; grid-template-rows: 1fr auto; height: 100%; text-align: center; gap: 6px; }
  .g-shift__c i {
    align-self: end;
    display: block;
    background: repeating-linear-gradient(-45deg, var(--ink) 0 1px, transparent 1px 6px);
    border: 1px solid var(--ink);
    animation: 7s ease-in-out infinite;
  }
  .g-shift__c:nth-child(1) i { animation-name: sh1; }
  .g-shift__c:nth-child(2) i { animation-name: sh2; }
  .g-shift__c:nth-child(3) i { animation-name: sh3; }
  .g-shift__c:nth-child(4) i { animation-name: sh4; }
  @keyframes sh1 { 0%, 22% { height: 16%; } 45%, 82% { height: 92%; background: var(--shu); border-color: var(--shu); } 100% { height: 16%; } }
  @keyframes sh2 { 0%, 22% { height: 34%; } 45%, 82% { height: 40%; } 100% { height: 34%; } }
  @keyframes sh3 { 0%, 22% { height: 74%; } 45%, 82% { height: 16%; } 100% { height: 74%; } }
  @keyframes sh4 { 0%, 22% { height: 96%; } 45%, 82% { height: 7%; } 100% { height: 96%; } }

  .g-time { display: grid; gap: 18px; }
  .g-time__row { display: grid; grid-template-columns: 62px 1fr; align-items: center; gap: 8px; }
  .g-time__row div { display: flex; height: 36px; border: 1px solid var(--ink); }
  .g-time i { font-style: normal; display: grid; place-items: center; font-size: 11.5px; overflow: hidden; white-space: nowrap; }
  .g-time .mk { background: repeating-linear-gradient(-45deg, var(--line) 0 1px, transparent 1px 6px); border-right: 1px solid var(--ink); color: var(--ink); }
  .g-time .dc { flex: 1; color: var(--ink); }
  .g-time .mk--now { animation: mk 7s ease-in-out infinite; }
  .g-time .dc--now { background: var(--shu); color: var(--paper); }
  @keyframes mk { 0%, 15% { width: 74%; } 45%, 85% { width: 26%; } 100% { width: 74%; } }

  .g-daily { display: grid; gap: 7px; }
  .g-daily p { margin: 0 0 2px; font-family: var(--mono); font-size: 11px; color: var(--shu); }
  .g-daily__r { display: grid; grid-template-columns: 10px 1fr 44px; gap: 10px; align-items: center; animation: row 6s calc(var(--k) * 0.35s) infinite both; }
  .g-daily__r i { width: 9px; height: 9px; background: var(--ink); }
  .g-daily__r:nth-of-type(2) i, .g-daily__r:nth-of-type(5) i { background: var(--shu); }
  .g-daily__r b { height: 7px; background: var(--ink); opacity: 0.75; width: calc(92% - var(--k) * 11%); }
  .g-daily__r em { height: 7px; border: 1px solid var(--ink); }
  @keyframes row { 0% { opacity: 0; transform: translateX(-14px); } 8%, 86% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }

  .g-even { display: grid; grid-template-columns: 1fr auto 1fr; gap: 18px; align-items: center; color: var(--ink); }
  .g-even div { display: grid; gap: 7px; }
  .g-even i { display: block; height: 14px; border: 1px solid var(--ink); background: repeating-linear-gradient(-45deg, var(--ink) 0 1px, transparent 1px 6px); }
  .g-even .raw { animation: vary 5.2s calc(var(--k) * -1.1s) ease-in-out infinite; }
  .g-even .fix { width: 86%; border-color: var(--shu); background: repeating-linear-gradient(-45deg, var(--shu) 0 1px, transparent 1px 6px); }
  @keyframes vary { 0%, 100% { width: 52%; } 20% { width: 92%; } 40% { width: 64%; } 60% { width: 100%; } 80% { width: 42%; } }

  /* ---------- 04 運用保守 ---------- */
  .carry { margin-top: clamp(40px, 5vw, 70px); }
  .carry svg { width: 100%; height: auto; display: block; overflow: visible; }
  .carry text { font-family: var(--gothic); font-size: 15px; fill: var(--ink-2); }
  .carry__base { stroke: var(--line); stroke-width: 1; }
  .carry__prog { stroke: var(--shu); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; animation: carryL 9s linear infinite; }
  .carry__tk { stroke: var(--ink); stroke-width: 1; }
  .carry__go line { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 5 4; }
  .carry__go rect { fill: var(--ink); }
  .carry__go text { fill: var(--paper); font-weight: 700; font-size: 14px; }
  .carry__pack { animation: carryP 9s linear infinite; }
  .carry__pack text { fill: var(--shu); font-size: 13px; font-weight: 700; }
  .carry__pack rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1.3; }
  .carry__pack path { fill: none; stroke: var(--shu); stroke-width: 1.4; }
  .carry__pack .dc1 { animation: grow 9s linear infinite; animation-delay: 0s; }
  .carry__pack .dc2 { animation: grow2 9s linear infinite; }
  @keyframes carryL { 0% { stroke-dashoffset: 1; } 88%, 100% { stroke-dashoffset: 0; } }
  @keyframes carryP { 0% { transform: translate(20px, 120px); opacity: 0; } 4% { opacity: 1; } 88% { transform: translate(1180px, 120px); opacity: 1; } 96%, 100% { transform: translate(1180px, 120px); opacity: 0; } }
  @keyframes grow { 0%, 10% { opacity: 0; } 14%, 100% { opacity: 1; } }
  @keyframes grow2 { 0%, 3% { opacity: 0; } 6%, 100% { opacity: 1; } }
  .runs { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2.4vw, 36px); margin-top: clamp(40px, 5vw, 70px); }
  .run { border-top: 1px solid var(--ink); padding-top: 18px; }
  .run__no { font-family: var(--mono); font-size: 12px; color: var(--shu); letter-spacing: 0.1em; }
  .run__name { font-family: var(--mincho); font-weight: 700; font-size: clamp(18px, 1.7vw, 23px); line-height: 1.6; margin: 6px 0 12px; }
  .run__body { margin: 0; font-size: 14.5px; color: var(--ink-2); }

  /* ---------- 05 進め方 ---------- */
  .flow__rail { margin-top: clamp(60px, 7vw, 100px); position: relative; }
  .flow__line { height: 1px; background: var(--line); position: relative; }
  .flow__line i {
    position: absolute;
    left: 0;
    top: -1px;
    height: 3px;
    width: 100%;
    background: var(--shu);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  .flow__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 40px); }
  .step { position: relative; padding-top: 34px; opacity: 0.28; transition: opacity 0.6s; }
  .step.on { opacity: 1; }
  .step__dot {
    position: absolute;
    top: -7px;
    left: 0;
    width: 13px;
    height: 13px;
    border: 1px solid var(--ink);
    background: var(--paper);
    transition: background 0.4s, border-color 0.4s, transform 0.4s;
  }
  .step.on .step__dot { background: var(--shu); border-color: var(--shu); transform: rotate(45deg); }
  .step__no { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--ink-2); }
  .step__name { font-family: var(--mincho); font-weight: 800; font-size: clamp(24px, 2.7vw, 40px); line-height: 1.4; margin: 4px 0 14px; }
  .step__body { margin: 0; font-size: 14.5px; color: var(--ink-2); }
  .rules {
    margin-top: clamp(50px, 6vw, 80px);
    border: 1px solid var(--ink);
    background: var(--paper);
    display: grid;
    grid-template-columns: auto 1fr;
  }
  .rules__k { margin: 0; padding: 20px 26px; background: var(--ink); color: var(--paper); font-weight: 700; font-size: 14px; display: grid; place-items: center; }
  .rules ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
  .rules li { padding: 20px 24px; border-right: 1px solid var(--line); font-size: 14.5px; line-height: 1.75; }
  .rules li:last-child { border-right: 0; }

  /* ---------- 06 経歴 ---------- */
  .ruler { margin-top: clamp(60px, 7vw, 100px); position: relative; padding-top: 30px; }
  .ruler__scale { position: relative; height: 26px; border-bottom: 1px solid var(--ink); }
  .tick { position: absolute; bottom: 0; width: 1px; height: 8px; background: var(--ink); }
  .tick--major { height: 16px; }
  .tick b {
    position: absolute;
    bottom: 22px;
    left: 0;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .tick:first-child b { transform: none; }
  .tick:last-child b { transform: translateX(-100%); }
  .ruler__bars { position: relative; height: 54px; margin-top: 10px; }
  .seg {
    position: absolute;
    top: 0;
    height: 100%;
    border: 1px solid var(--ink);
    border-left-width: 0;
    background: transparent;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    padding: 0 4px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1s cubic-bezier(0.5, 0, 0.2, 1) var(--d, 0s), background 0.35s, color 0.35s;
  }
  .seg:first-child { border-left-width: 1px; }
  .seg:last-child { font-size: 11.5px; }
  .ruler.in .seg { clip-path: inset(0); }
  .seg.is-on { background: var(--ink); color: var(--paper); }
  .seg:last-child.is-on { background: var(--shu); border-color: var(--shu); }
  .seats { display: grid; margin-top: 38px; min-height: 190px; }
  .seat { grid-area: 1 / 1; max-width: 720px; opacity: 0; transform: translateY(12px); pointer-events: none; }
  .seat.is-on { opacity: 1; transform: none; pointer-events: auto; transition: opacity 0.5s 0.05s, transform 0.5s 0.05s; }
  .seat__yr { font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; color: var(--shu); margin: 0; }
  .seat__name { font-family: var(--mincho); font-weight: 800; font-size: clamp(24px, 2.8vw, 38px); margin: 2px 0; line-height: 1.5; }
  .seat__org { font-size: 13px; font-weight: 700; margin: 0 0 12px; }
  .seat__body { margin: 0; color: var(--ink-2); font-size: 15px; }
  .nums {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(50px, 6vw, 80px) 0 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .num { padding: 26px 20px 22px; border-right: 1px solid var(--line); }
  .num:first-child { padding-left: 0; }
  .num:last-child { border-right: 0; }
  .num dt { font-size: 12.5px; color: var(--ink-2); font-weight: 500; }
  .num dd { margin: 4px 0 0; font-family: var(--mincho); font-weight: 700; font-size: clamp(15px, 1.4vw, 19px); line-height: 1.3; }
  .num dd b { font-family: var(--mono); font-weight: 500; font-size: clamp(40px, 5vw, 72px); letter-spacing: -0.03em; margin: 0 4px 0 2px; }
  .num__txt { font-family: var(--mono) !important; font-weight: 500 !important; font-size: clamp(22px, 2.6vw, 38px) !important; line-height: 2.2 !important; }


  /* ---------- 11 アセスメント ---------- */
  .asm__in { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); gap: clamp(30px, 6vw, 100px); align-items: center; }
  .asm .h2 { font-size: clamp(23px, 2.9vw, 40px); }
  .asm__pts { list-style: none; margin: 30px 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .asm__pts li { display: grid; grid-template-columns: 7.5em 1fr; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 14.5px; color: var(--ink-2); align-items: baseline; }
  .asm__pts b { font-family: var(--mincho); font-size: 16px; color: var(--ink); }
  .asm__act { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 34px; }
  .asm__note { margin: 16px 0 0; font-size: 12.5px; color: var(--ink-2); line-height: 1.8; }
  .asm__deck { position: relative; display: block; aspect-ratio: 1120 / 860; margin: 20px 60px 40px 0; }
  .asm__deck img { position: absolute; inset: 0; width: 100%; height: auto; border: 1px solid var(--ink); background: var(--paper); box-shadow: 0 8px 26px rgba(28, 27, 24, 0.16);
    transform: translate(calc(var(--i) * 13px), calc(var(--i) * 10px)) rotate(calc(var(--i) * 0.5deg)); z-index: calc(10 - var(--i)); opacity: calc(1 - var(--i) * 0.07);
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.9s; }
  .asm__deck img.out { transform: translate(-46%, -6%) rotate(-7deg); opacity: 0; transition: transform 0.6s cubic-bezier(0.6, 0, 0.9, 0.4), opacity 0.5s 0.1s; }
  .asm__deck:hover img { transform: translate(calc(var(--i) * 19px), calc(var(--i) * 12px)) rotate(calc(var(--i) * 0.9deg)); }


  /* アセスメントを目立たせる：黒地の章・見出し下のボタン・相談前の帯・右下の札 */
  .asm { background: var(--ink); color: var(--paper); margin: 0 calc(-1 * (var(--gutter) + 10px)); padding-inline: calc(var(--gutter) + 10px); border-top: 0; }
  .asm + .sec { border-top: 0; }
  .asm .tag { color: #c9c4b6; }
  .asm .tag span { background: var(--shu); color: var(--paper); }
  .asm .sec__lead { color: #c9c4b6; }
  .asm__pts { border-top-color: #6b675d; }
  .asm__pts li { border-bottom-color: #4a4740; color: #c9c4b6; }
  .asm__pts b { color: var(--paper); }
  .asm .btn { background: var(--shu); color: var(--paper); }
  .asm .btn::before { background: var(--paper); }
  .asm .btn:hover { color: var(--ink); }
  .asm .link { border-color: var(--paper); }
  .asm__note { color: #a8a396; }
  .asm__deck img { border-color: var(--paper-2); box-shadow: 0 14px 40px rgba(0, 0, 0, 0.5); }
  .btn--line { background: transparent; color: var(--ink); border: 1px solid var(--ink); padding: 14px 22px; gap: 14px; letter-spacing: 0.04em; }
  .btn--line small { font-family: var(--mono); font-weight: 400; font-size: 11px; color: var(--shu); transition: color 0.3s; }
  .btn--line:hover { color: var(--paper); }
  .btn--line:hover small { color: var(--paper); }
  .nav__hot { display: flex; align-items: center; gap: 7px; font-weight: 700 !important; }
  .nav__hot::before { content: ''; width: 7px; height: 7px; background: var(--shu); border-radius: 50%; }
  .asmband { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px 30px; margin: 0 0 clamp(50px, 6vw, 90px); padding: 22px 28px; border: 1px solid var(--shu); background: var(--paper); transition: opacity 0.9s, transform 0.9s, background 0.3s, color 0.3s; }
  .asmband:hover { background: var(--shu); color: var(--paper); }
  .asmband__k { font-family: var(--mincho); font-weight: 800; font-size: clamp(17px, 1.9vw, 25px); }
  .asmband__t { font-size: 14px; }
  .asmband__b { display: flex; align-items: center; gap: 14px; font-weight: 700; font-size: 14.5px; color: var(--shu); transition: color 0.3s; white-space: nowrap; }
  .asmband:hover .asmband__b { color: var(--paper); }

  /* ---------- ブログの入口 ---------- */
  .blg { padding-block: clamp(70px, 9vw, 130px); }
  .blg__head { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-bottom: 8px; }
  .blg__head .tag { margin: 0; }
  .blg__list { list-style: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--ink); background: var(--paper); }
  .blg__list li + li { border-left: 1px solid var(--ink); }
  .blg__list a { display: grid; gap: 8px; padding: clamp(18px, 2.4vw, 34px); height: 100%; align-content: start; transition: background 0.35s, color 0.35s; }
  .blg__list a:hover { background: var(--ink); color: var(--paper); }
  .blg__no { font-family: var(--mono); font-size: clamp(34px, 4vw, 56px); line-height: 1; color: var(--shu); letter-spacing: -0.04em; }
  .blg__list em { font-style: normal; font-size: 12px; font-weight: 700; justify-self: start; border: 1px solid currentColor; padding: 0 9px; margin-top: 6px; }
  .blg__list b { font-family: var(--mincho); font-weight: 700; font-size: clamp(17px, 1.7vw, 22px); line-height: 1.65; }
  .blg__list small { font-size: 12px; color: var(--ink-2); transition: color 0.35s; }
  .blg__list a:hover small { color: #c9c4b6; }

  /* ---------- 07 相談 ---------- */
  .contact { padding-bottom: clamp(100px, 12vw, 170px); }
  .contact__h { font-family: var(--mincho); font-weight: 800; font-size: clamp(36px, 7.4vw, 116px); line-height: 1.25; margin: 0 0 34px; }
  .contact__lead { max-width: 600px; margin: 0 0 44px; color: var(--ink-2); }
  .foot {
    margin: 0 calc(var(--gutter) + 10px) 40px;
    border-top: 1px solid var(--ink);
    padding-top: 20px;
    font-size: 12.5px;
    color: var(--ink-2);
    display: flex;
    gap: 8px 30px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .foot p { margin: 0; }
  .foot__n { font-weight: 700; color: var(--ink); }
  .foot__c { margin-left: auto !important; font-family: var(--mono); font-size: 10.5px; }

  .ab { position: fixed; right: 22px; bottom: 22px; z-index: 60; display: flex; background: #000; border: 1px solid #555; border-radius: 999px; padding: 3px; font: 700 12px/1 system-ui, sans-serif; }
  .ab a { padding: 8px 14px; border-radius: 999px; color: #bbb; }
  .ab a.on { background: #fff; color: #000; }

  /* ---------- 小さい画面 ---------- */
  @media (max-width: 900px) {
    .nav__links a:not(.nav__cta):not(.nav__page) { display: none; }
    .nav__sep, .nav__hot { display: none !important; }
    .nav__page { font-size: 12.5px; }
    .nav__links { gap: 12px; }

    .nav__cta { font-size: 13px; padding: 9px 12px 9px 14px; gap: 8px; box-shadow: 3px 3px 0 var(--ink); }
    .nav__cta-l { display: none; }
    .nav .nav__links .nav__act .nav__smp { display: flex !important; font-size: 11px; padding: 3px 9px 4px 10px; top: calc(100% + 11px); right: -3px; }
    .nav__smp span { display: none; }
    .nav__cta-s { display: inline; }
    .nav__cta svg { width: 18px; }
    .hero { grid-template-columns: 1fr; padding-top: 120px; }
    .scr { box-shadow: none; }
    .asm__in { grid-template-columns: 1fr; }
    .blg__list { grid-template-columns: 1fr; }
    .blg__list li + li { border-left: 0; border-top: 1px solid var(--ink); }
    .asmband { grid-template-columns: 1fr; }
    .asm__deck { margin: 0 44px 30px 0; }
    .asm__pts li { grid-template-columns: 1fr; gap: 0; }
    .tr__figs { grid-template-columns: 1fr; }
    .tr__mid { grid-auto-flow: column; justify-content: center; border-inline: 0; border-block: 1px solid var(--line); padding: 10px; }
    .tr__mid br { display: none; }
    .tr svg text { font-size: 15px; }
    .tr .idt { font-size: 12px; }
    .tr__chain ol { grid-template-columns: 1fr; gap: 22px 0; }
    .tr__chain li + li::before { right: auto; left: 22px; top: auto; bottom: 100%; width: 2px; height: 22px; transform-origin: top; }
    .tr__chain li + li::after { display: none; }
    .scr__grid { grid-template-columns: 1fr 1fr; }
    .pane { height: 150px; }
    .pane:nth-child(3n) { border-right: 1px solid var(--hl); }
    .pane:nth-child(2n) { border-right: 0; }
    .pane__h span { display: none; }
    .scr__pj { font-size: 10.5px; white-space: normal; }
    .org__ai { grid-template-columns: 1fr 1fr; }
    .mem:last-child { grid-column: 1 / -1; }
    .vs { grid-template-columns: 1fr; }
    .vs__c + .vs__c { border-left: 0; border-top: 1px solid var(--ink); }
    .cmp { grid-template-columns: 1fr; }
    .ph__bar { grid-template-columns: repeat(3, 1fr); }
    .ph__tab:nth-child(3) { border-right: 0; }
    .ph__tab:nth-child(-n + 3) { border-bottom: 1px solid var(--ink); }
    .ph__pane { grid-template-columns: 1fr; }
    .ph__stage { aspect-ratio: 4 / 3.7; font-size: 9px; }
    .ph__arrow { transform: rotate(90deg); width: 40px; }
    .merits { grid-template-columns: 1fr; }
    .merit { border-right: 0; border-bottom: 1px solid var(--ink) !important; }
    .merit:last-child { border-bottom: 0 !important; }
    .runs { grid-template-columns: 1fr; }
    .carry text { font-size: 26px; }
    .carry__pack text { display: none; }
    .flow__line { display: none; }
    .flow__steps { grid-template-columns: 1fr; border-left: 1px solid var(--line); gap: 40px; }
    .step { padding: 0 0 0 26px; }
    .step__dot { top: 8px; left: -7px; }
    .rules { grid-template-columns: 1fr; }
    .rules__k { place-items: start; padding: 12px 20px; }
    .rules ul { grid-template-columns: 1fr; }
    .rules li { border-right: 0; border-bottom: 1px solid var(--line); padding: 14px 20px; }
    .rules li:last-child { border-bottom: 0; }
    .seg { font-size: 0 !important; }
    .nums { grid-template-columns: 1fr 1fr; }
    .num:nth-child(2) { border-right: 0; }
    .num:nth-child(3) { padding-left: 0; }
    .num:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .foot__c { margin-left: 0 !important; }
  }
  @media (max-width: 440px) {
    .nav { padding-inline: 14px; }
    .nav__logo { font-size: 18px; gap: 5px; }
    .nav__links { gap: 14px; }
    .nav__page { font-size: 12px; padding: 2px 0; border-bottom: 1px solid var(--ink); }
    .nav .nav__links .nav__cta { font-size: 11.5px; padding: 8px 10px; gap: 0; }
    .nav .nav__links .nav__cta svg { display: none; }
    .nav .nav__links .nav__act .nav__smp { font-size: 10.5px; padding: 3px 8px 4px; }
  }
  @media (max-width: 340px) {
    .nav__logo { font-size: 16px; }
    .nav__links { gap: 10px; }
    .nav .nav__links .nav__cta { font-size: 10.5px; padding: 7px 8px; }
  }

</style>

<style is:global>
  /* 映像の中の行は実行時に作るので、ここに置く */
  #scr .pane__b > div { display: flex; gap: 10px; white-space: nowrap; animation: rowin 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both; flex: none; }
  #scr .pane__b time { color: #77736a; }
  #scr .pane__b span { font-family: var(--gothic); color: #d9d4c7; overflow: hidden; text-overflow: ellipsis; }
  #scr .pane__b em { font-style: normal; margin-left: auto; padding: 0 7px; font-size: 0.9em; border: 1px solid #e9e4d7; }
  #scr .pane__b em.ng { background: var(--shu); border-color: var(--shu); color: #fff; }
  #scr .pane__b .code { gap: 6px; height: 1.5em; align-items: center; }
  #scr .pane__b .code i { display: block; height: 5px; background: #8f8a7e; transform-origin: left; animation: codein 0.45s both; }
  #scr .pane__b .code i.k { background: #e9e4d7; }
  #scr .pane__b .code i.s { background: var(--shu); }
  #scr .pane--human .pane__b > div { border: 1px solid var(--ink); padding: 5px 10px; align-items: center; background: var(--paper); position: relative; }
  #scr .pane--human .pane__b span { color: var(--ink); font-weight: 700; }
  #scr .pane--human .pane__b s { text-decoration: none; margin-left: auto; width: 24px; height: 24px; border-radius: 50%; border: 1.6px solid var(--shu); color: var(--shu); font-family: var(--mincho); font-weight: 800; font-size: 13px; display: grid; place-items: center; opacity: 0; transform: scale(1.8) rotate(-12deg); flex: none; }
  #scr .pane--human .pane__b .done s { opacity: 1; transform: rotate(-12deg); transition: opacity 0.1s, transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1); }
  #scr .pane--human .pane__b .done { opacity: 0.55; transition: opacity 0.6s 0.5s; }
</style>

<script>
  /* 動く図がこのページの中身なので、端末の「動きを減らす」設定でも止めない（2026-11-15 iPhone で止まって見えたため） */
  const reduce = false;
  const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends Element>(s: string) => [...document.querySelectorAll<T>(s)];
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const SVGNS = 'http://www.w3.org/2000/svg';

  /* 現れ方 */
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
    { threshold: 0.15 },
  );
  $$('.rv, .ruler, .org').forEach((el) => io.observe(el));

  /* いまの章の番号 */
  const sheetNo = $('#sheetNo');
  const so = new IntersectionObserver(
    (es) => es.forEach((e) => e.isIntersecting && (sheetNo.textContent = (e.target as HTMLElement).dataset.sheet!)),
    { rootMargin: '-45% 0px -45% 0px' },
  );
  $$('[data-sheet]').forEach((s) => so.observe(s));

  /* 見えている間だけ動かすための目印 */
  const seen = new Map<Element, boolean>();
  const vo = new IntersectionObserver((es) => es.forEach((e) => seen.set(e.target, e.isIntersecting)));
  const watch = (el: Element) => (vo.observe(el), el);
  const live = (el: Element) => seen.get(el) !== false && !document.hidden;

  /* 数字の読み上げ */
  const co = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    co.unobserve(e.target);
    const el = e.target as HTMLElement, to = Number(el.dataset.count);
    if (reduce) { el.textContent = String(to); return; }
    const t0 = performance.now(), dur = 1400;
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / dur);
      el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 4))));
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }), { threshold: 0.6 });
  $$('[data-count]').forEach((el) => co.observe(el));

  /* ===== 図1：伝票が基幹システムを流れ、AIが点検して回る ===== */
  (() => {
    const svg = watch($('#erp'));
    const nodes = $$<SVGGElement>('#erp .node');
    const pts = nodes.map((n) => {
      const m = /translate\(([\d.]+) ([\d.]+)\)/.exec(n.getAttribute('transform')!)!;
      return { x: +m[1] + 68, y: +m[2] + 38 };
    });
    const cum = [0];
    for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
    const L = cum[cum.length - 1];
    const at = (d: number) => {
      let i = 1;
      while (i < cum.length - 1 && cum[i] < d) i++;
      const k = (d - cum[i - 1]) / (cum[i] - cum[i - 1]);
      return { x: pts[i - 1].x + (pts[i].x - pts[i - 1].x) * k, y: pts[i - 1].y + (pts[i].y - pts[i - 1].y) * k };
    };
    const counts = nodes.map((_, i) => 1200 + i * 137);
    const cEls = nodes.map((n) => n.querySelector('.node__c')!);
    cEls.forEach((c, i) => (c.textContent = String(counts[i])));

    const N = 5;
    const layer = $('#tokens');
    const toks = Array.from({ length: N }, (_, i) => {
      const r = document.createElementNS(SVGNS, 'g');
      r.innerHTML = '<rect x="-13" y="-9" width="26" height="18"/><path d="M-8 -3h16M-8 2h10"/>';
      layer.appendChild(r);
      return { el: r, d: -(i * L) / N, last: -1 };
    });
    const scan = $<SVGGElement>('#scan');
    let sd = 0, sLast = -1;

    if (reduce) {
      nodes.forEach((n) => n.classList.add('ok'));
      toks.forEach((t, i) => { const p = at(((i + 0.5) * L) / N); t.el.setAttribute('transform', `translate(${p.x} ${p.y})`); });
      return;
    }
    let prev = performance.now(), started = false;
    setTimeout(() => (started = true, scan.style.opacity = '1', scan.style.transition = 'opacity .6s'), 2600);
    const frame = (now: number) => {
      const dt = Math.min(50, now - prev); prev = now;
      if (started && live(svg)) {
        for (const t of toks) {
          t.d += dt * 0.085;
          if (t.d > L) { t.d -= L; t.last = -1; }
          if (t.d < 0) { t.el.setAttribute('opacity', '0'); continue; }
          const p = at(t.d);
          t.el.setAttribute('opacity', '1');
          t.el.setAttribute('transform', `translate(${p.x} ${p.y})`);
          const ni = cum.findIndex((c) => Math.abs(c - t.d) < 34);
          if (ni >= 0 && ni !== t.last) {
            t.last = ni;
            counts[ni]++; cEls[ni].textContent = String(counts[ni]);
            const n = nodes[ni]; n.classList.add('hit'); setTimeout(() => n.classList.remove('hit'), 120);
          }
        }
        sd += dt * 0.26;
        if (sd > L + 260) { sd = -60; sLast = -1; }
        const q = at(Math.max(0, Math.min(L, sd)));
        scan.setAttribute('transform', `translate(${q.x + 46} ${q.y - 30})`);
        const si = cum.findIndex((c) => Math.abs(c - sd) < 26);
        if (si >= 0 && si !== sLast) {
          sLast = si;
          const n = nodes[si]; n.classList.add('ok'); setTimeout(() => n.classList.remove('ok'), 900);
        }
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  })();

  /* ===== 図2：抜き取りと全件 ===== */
  (async () => {
    const box = watch($('#cmp'));
    const l = $$<HTMLElement>('.cells[data-side="l"] i'), r = $$<HTMLElement>('.cells[data-side="r"] i');
    const lChk = $('#lChk'), lHit = $('#lHit'), rChk = $('#rChk'), rHit = $('#rHit'), lMiss = $('#lMiss');
    const ls = l.filter((c) => c.classList.contains('s'));
    const total = r.length, dTotal = r.filter((c) => c.classList.contains('d')).length;
    if (reduce) {
      ls.forEach((c) => c.classList.add('on')); r.forEach((c) => c.classList.add('on'));
      l.filter((c) => c.classList.contains('d')).forEach((c) => c.classList.add('left'));
      lChk.textContent = String(ls.length); rChk.textContent = String(total); rHit.textContent = String(dTotal); lMiss.classList.add('on');
      return;
    }
    for (;;) {
      while (!live(box)) await sleep(400);
      [...l, ...r].forEach((c) => c.classList.remove('on', 'left'));
      lMiss.classList.remove('on');
      lChk.textContent = lHit.textContent = rChk.textContent = rHit.textContent = '0';
      await sleep(700);
      let rc = 0, rh = 0;
      const maxW = Math.max(...r.map((c) => +c.style.getPropertyValue('--w')));
      const right = (async () => {
        for (let w = 0; w <= maxW; w++) {
          r.filter((c) => +c.style.getPropertyValue('--w') === w).forEach((c) => {
            c.classList.add('on'); rc++; if (c.classList.contains('d')) rh++;
          });
          rChk.textContent = String(rc); rHit.textContent = String(rh);
          await sleep(95);
        }
      })();
      for (let i = 0; i < ls.length; i++) {
        ls[i].classList.add('on'); lChk.textContent = String(i + 1);
        await sleep(430);
      }
      await right;
      await sleep(500);
      l.filter((c) => c.classList.contains('d')).forEach((c) => c.classList.add('left'));
      lMiss.classList.add('on');
      await sleep(4200);
    }
  })();

  /* ===== 図2：工程の切り替え（触らなければ順に送る） ===== */
  const tabset = (root: string, tabSel: string, paneSel: string, ms: number, onPick?: (pane: HTMLElement) => void) => {
    const box = watch($(root));
    const tabs = $$<HTMLElement>(`${root} ${tabSel}`), panes = $$<HTMLElement>(`${root} ${paneSel}`);
    let cur = 0, touched = false;
    const pick = (i: number) => {
      cur = i;
      tabs.forEach((t, k) => t.classList.toggle('is-on', k === i));
      panes.forEach((p, k) => p.classList.toggle('is-on', k === i));
      if (!reduce) onPick?.(panes[i]);
    };
    const stop = () => { touched = true; box.classList.remove('auto'); };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); pick(i); });
      t.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { stop(); pick(i); } });
    });
    if (reduce) return;
    onPick?.(panes[0]);
    box.classList.add('auto');
    setInterval(() => { if (!touched && live(box) && box.classList.contains('in')) pick((cur + 1) % tabs.length); }, ms);
  };
  tabset('#ph', '.ph__tab', '.ph__pane', 8200, (pane) => {
    const st = pane.querySelector<HTMLElement>('.st')!;
    st.classList.remove('run'); void st.offsetWidth; st.classList.add('run');
  });
  tabset('#ruler', '.seg', '~ .seats .seat', 3800);

  /* ===== 進め方：スクロールに合わせて線が伸びる ===== */
  const rail = $<HTMLElement>('#flowRail'), prog = $<HTMLElement>('#flowProg');
  const stepEls = $$('.step');
  const onScroll = () => {
    const r = rail.getBoundingClientRect(), vh = innerHeight;
    const p = Math.max(0, Math.min(1, (vh * 0.82 - r.top) / (vh * 0.5)));
    prog.style.setProperty('--p', String(p));
    stepEls.forEach((s, i) => s.classList.toggle('on', p > i / stepEls.length + 0.02));
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ===== プロジェクト管理の図：見えている間、繰り返し再生する ===== */
  (() => {
    const figs = [...document.querySelectorAll<HTMLElement>('.pmf')];
    const rm = false;
    const on = new Set<HTMLElement>();
    const num = document.querySelector<HTMLElement>('.pbn')!;
    if (rm) { num.textContent = '81'; return; }
    const play = (f: HTMLElement) => {
      f.classList.remove('run'); void f.offsetWidth; f.classList.add('run');
      if (!f.contains(num)) return;
      num.textContent = '52';
      const t0 = performance.now() + 3200;
      const tick = (t: number) => {
        if (!f.classList.contains('run')) return;
        const k = Math.max(0, Math.min(1, (t - t0) / 1600));
        num.textContent = String(Math.round(52 + 29 * k * k * (3 - 2 * k)));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    new IntersectionObserver((es) => es.forEach((e) => {
      const f = e.target as HTMLElement;
      if (e.isIntersecting) { if (!on.has(f)) { on.add(f); play(f); } } else on.delete(f);
    }), { threshold: 0.3 }).observe && figs.forEach((f) => {
      new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { if (!on.has(f)) { on.add(f); play(f); } } else on.delete(f);
      }), { threshold: 0.3 }).observe(f);
    });
    setInterval(() => { if (!document.hidden) on.forEach(play); }, 7600);
  })();

  /* ===== 現場の映像：AIチームと人が、一日を通して動く ===== */
  (() => {
    const scr = document.querySelector<HTMLElement>('#scr')!;
    const rm = false;
    const clock = scr.querySelector<HTMLElement>('#scrClock')!, day = scr.querySelector<HTMLElement>('#scrDay')!, cap = scr.querySelector<HTMLElement>('#scrCap')!;
    const pane = (k: string) => scr.querySelector<HTMLElement>(`.pane[data-k="${k}"]`)!;
    const body = (k: string) => pane(k).querySelector<HTMLElement>('.pane__b')!;
    const cnt = (k: string) => pane(k).querySelector<HTMLElement>('.pane__h u')!;
    const LOG: Record<string, string[]> = {
      pmo: ['チャットの投稿を読む', '会議の記録を読む', '課題を追加　移行データの桁数', 'リスクを追加　連携先の回答待ち', '期日の近い課題を並べ替え', '止まっている話題を検出', '担当への確認を下書き', '間に合う確率を更新'],
      des: ['外部設計書　受注取込　初版', '会議の決定を反映', '外部設計書　出荷指示　初版', '要件との対応を記入', '内部設計書　在庫引当　初版', '様式に合わせて整形'],
      chk: ['設計書を点検　記載の抜け', '設計書を点検　項目の桁数', 'コードを点検　命名規約', 'コードを点検　設計書との対応', '移行データを照合', '指摘を一覧に追加'],
      tst: ['受注登録', '出荷指示', '在庫引当', '請求書発行', '入庫', '購買発注'],
      human: ['設計書の指摘 3件を反映するか', 'この要件を作るか', 'テストの合否', '移行の桁数の扱い', '優先して片付ける課題'],
    };
    const CAPS: [number, string][] = [[7, '朝、AIチームが記録を読みはじめる。'], [9, '会議の前に、設計書の初版がそろう。'], [11, '点検は、抜き取りではなく全件。'], [13, 'テストは、AIが画面を操作して流す。'], [15, '人が受け取るのは、決めることだけ。'], [17, 'SAP 導入に、AIチームという選択肢を。']];
    const N: Record<string, number> = { pmo: 0, des: 0, dev: 0, tst: 0, chk: 0, human: 0 };
    const idx: Record<string, number> = {};
    let hour = 7, capI = -1, vis = false, tc = 0;
    const hhmm = () => `${String(Math.floor(hour)).padStart(2, '0')}:${String(Math.floor((hour % 1) * 60)).padStart(2, '0')}`;
    const push = (k: string, html: string, cls = '') => {
      const b = body(k), d = document.createElement('div');
      if (cls) d.className = cls;
      d.innerHTML = html; b.appendChild(d);
      while (b.children.length > (k === 'human' ? 4 : 8)) b.firstElementChild!.remove();
      return d;
    };
    const next = (k: string) => { idx[k] = ((idx[k] ?? -1) + 1) % LOG[k].length; return LOG[k][idx[k]]; };
    const bump = (k: string, by: number) => { N[k] += by; cnt(k).textContent = String(N[k]); };
    const step: Record<string, () => void> = {
      pmo: () => { const t = next('pmo'); push('pmo', `<time>${hhmm()}</time><span>${t}</span>`); if (t.includes('追加')) bump('pmo', 1); },
      des: () => { const t = next('des'); push('des', `<time>${hhmm()}</time><span>${t}</span>`); if (t.includes('初版')) bump('des', 1); },
      chk: () => { push('chk', `<time>${hhmm()}</time><span>${next('chk')}</span>`); bump('chk', 12 + Math.floor(Math.random() * 30)); },
      dev: () => {
        const ind = [0, 1, 1, 2, 2, 1, 0][Math.floor(Math.random() * 7)], n = 1 + Math.floor(Math.random() * 3);
        let h = `<i style="width:${ind * 16}px;background:none"></i>`;
        for (let i = 0; i < n; i++) h += `<i class="${['k', '', '', 's'][Math.floor(Math.random() * 4)]}" style="width:${18 + Math.random() * 90}px;animation-delay:${i * 0.12}s"></i>`;
        push('dev', h, 'code'); if (Math.random() < 0.12) bump('dev', 1);
      },
      tst: () => { tc++; const ng = tc % 9 === 0; push('tst', `<time>TC-${String(tc).padStart(3, '0')}</time><span>${next('tst')}</span><em class="${ng ? 'ng' : ''}">${ng ? 'NG 起票' : 'OK'}</em>`); bump('tst', 1); },
      human: () => { const d = push('human', `<span>${next('human')}</span><s>決</s>`); setTimeout(() => { d.classList.add('done'); bump('human', 1); }, 1500); },
    };
    const EVERY: Record<string, number> = { pmo: 950, des: 1300, chk: 700, dev: 260, tst: 620, human: 3100 };
    if (rm) { Object.keys(step).forEach((k) => { for (let i = 0; i < 5; i++) step[k](); }); return; }
    Object.keys(step).forEach((k) => {
      for (let i = 0; i < 4; i++) step[k]();
      setInterval(() => { if (vis && !document.hidden) step[k](); }, EVERY[k]);
    });
    const DUR = 46000; let t0 = performance.now(), prev = t0;
    const frame = (now: number) => {
      if (vis && !document.hidden) {
        t0 += 0; const p = ((now - t0) % DUR) / DUR;
        hour = 7 + p * 11.5;
        clock.textContent = hhmm();
        day.style.setProperty('--p', String(p));
        let ci = 0; CAPS.forEach((c, i) => { if (hour >= c[0]) ci = i; });
        if (ci !== capI) { capI = ci; cap.textContent = CAPS[ci][1]; cap.classList.remove('sw'); void cap.offsetWidth; cap.classList.add('sw'); }
      } else t0 += now - prev;
      prev = now;
      requestAnimationFrame(frame);
    };
    new IntersectionObserver((es) => (vis = es[0].isIntersecting), { threshold: 0.15 }).observe(scr);
    requestAnimationFrame(frame);
  })();

  /* ===== 流れとつながり：手順を選ぶと、要件からテストまでの番号が替わる ===== */
  (() => {
    const box = document.querySelector<HTMLElement>('#tr')!;
    const data = JSON.parse(document.querySelector('#trData')!.textContent!) as Record<string, string>[];
    const rm = false;
    const parts = [...box.querySelectorAll<SVGGElement>('[data-s]')];
    let cur = -1, touched = false, vis = false;
    const pick = (i: number) => {
      if (i === cur) return; cur = i;
      parts.forEach((g) => g.classList.toggle('hi', Number(g.dataset.s) === i));
      const t = data[i];
      box.querySelector('#trId')!.textContent = t.id;
      box.querySelector('#trStep')!.textContent = t.step;
      box.querySelectorAll<HTMLElement>('[data-f]').forEach((b) => (b.textContent = t[b.dataset.f!]));
      if (rm) return;
      box.classList.remove('go'); void box.offsetWidth; box.classList.add('go');
    };
    parts.forEach((g) => g.addEventListener('click', () => { touched = true; pick(Number(g.dataset.s)); }));
    pick(1);
    new IntersectionObserver((es) => (vis = es[0].isIntersecting), { threshold: 0.3 }).observe(box);
    if (!rm) setInterval(() => { if (vis && !touched && !document.hidden) pick((cur + 1) % data.length); }, 4200);
  })();

  /* ===== アセスメント：報告書の頁を1枚ずつ送る ===== */
  (() => {
    const deck = document.querySelector<HTMLElement>('#deck')!;
    const imgs = [...deck.querySelectorAll<HTMLImageElement>('img')];
    if (false) return;
    let vis = false, busy = false;
    new IntersectionObserver((es) => (vis = es[0].isIntersecting), { threshold: 0.4 }).observe(deck);
    setInterval(() => {
      if (!vis || busy || document.hidden || deck.matches(':hover')) return;
      busy = true;
      const top = imgs.find((im) => im.style.getPropertyValue('--i') === '0')!;
      top.classList.add('out');
      setTimeout(() => {
        imgs.forEach((im) => { const i = Number(im.style.getPropertyValue('--i')); im.style.setProperty('--i', String(i === 0 ? imgs.length - 1 : i - 1)); });
        top.classList.remove('out'); busy = false;
      }, 650);
    }, 3200);
  })();

</script>
