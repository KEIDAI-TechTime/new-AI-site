---
import DraftLayout from '@/layouts/DraftLayout.astro';
import { posts } from '@/data/posts';

const title = 'TechTime | SAP 導入に、AIチームという選択肢を。';
const description =
  'TechTime は、SAP を中心とした基幹システムの導入と運用保守に、設計・開発・テスト・点検・進捗管理を受け持つAIチームを組み込みます。提供するのは工数ではなく、プロジェクトに残る仕組みです。';

const trace = [
  { id: 'F-01', step: '受注を受ける', msg: '受注データ', req: 'R-004', des: 'D-011', prg: 'ZSD_ORDER_IN', tst: 'T-031' },
  { id: 'F-02', step: '在庫を引き当てる', msg: '引当の依頼', req: 'R-012', des: 'D-034', prg: 'ZSD_ALLOC', tst: 'T-108' },
  { id: 'F-03', step: '出荷する', msg: '出荷の実績', req: 'R-019', des: 'D-047', prg: 'ZLE_SHIP', tst: 'T-142' },
  { id: 'F-04', step: '請求する', msg: '請求データ', req: 'R-027', des: 'D-063', prg: 'ZFI_BILL', tst: 'T-176' },
];
/* 業務の流れ：手順の箱の位置と、次の手順への線 */
const fbox = [[66, 58], [186, 138], [306, 138], [406, 218]];
const fline = ['M114 102V160H186', 'M282 160H306', 'M354 182V240H406'];
/* シーケンス図：どこからどこへ（x）と高さ（y） */
const smsg = [[90, 260, 96], [260, 430, 146], [430, 260, 196], [260, 90, 246]];

const team = [
  { k: 'pmo', name: '進捗管理のAI', unit: '拾った課題', job: '課題とリスクを拾い、並べる' },
  { k: 'des', name: '設計のAI', unit: '設計書の初版', job: '設計書の初版を起こす' },
  { k: 'dev', name: '開発のAI', unit: 'ABAP', job: 'ABAP とテストを起こす' },
  { k: 'tst', name: 'テストのAI', unit: '実施したケース', job: '画面を操作し、証跡を残す' },
  { k: 'chk', name: '点検のAI', unit: '点検した件数', job: '全件を同じ観点で確かめる' },
];

/* 図1：基幹システムの伝票の流れ */
const nodes = [
  { k: 'SD', n: '受注', x: 125, y: 110 },
  { k: 'PP', n: '生産計画', x: 325, y: 110 },
  { k: 'MM', n: '購買', x: 525, y: 110 },
  { k: 'MM', n: '入庫', x: 525, y: 270 },
  { k: 'PP', n: '製造', x: 325, y: 270 },
  { k: 'SD', n: '出荷', x: 125, y: 270 },
  { k: 'SD', n: '請求', x: 125, y: 430 },
  { k: 'FI', n: '会計', x: 325, y: 430 },
  { k: 'CO', n: '原価', x: 525, y: 430 },
];
const flowD = 'M' + nodes.map((p) => `${p.x} ${p.y}`).join(' L');

/* 図2：工程ごとの変化 */
const phases = [
  { name: '要件定義', line: '会議の記録から決定と未決を拾い、業務の流れとシーケンス図を起こす。', human: '流れを確かめ、どれを作るかを決める' },
  { name: '設計', line: '初版を起こし、全件を点検する。', human: '指摘を反映するかを決める' },
  { name: '開発', line: '設計書から、ABAP とテストを起こす。', human: '動きを確かめる' },
  { name: 'テスト', line: 'SAP の画面を操作し、証跡を残す。', human: '合否を決める' },
  { name: '移行', line: '全件を変換し、全件を照合する。', human: '判断の要る項目だけを見る' },
  { name: '運用保守', line: '導入の記録を持ったまま、問い合わせに答える。', human: '確かめて返す' },
];
const W8 = [92, 70, 84, 56, 96, 64, 78, 44];
const CODE = [[0, 46], [1, 70], [1, 58], [2, 80], [2, 52], [1, 34], [1, 66], [2, 74], [0, 28]];

/* 図2：抜き取りと全件 */
const COLS = 14;
const ROWS = 6;
const cells = Array.from({ length: COLS * ROWS }, (_, i) => i);
const sampled = [3, 17, 22, 36, 41, 55, 63, 70, 78];
const defects = [9, 30, 52, 72];

const meritsBuild = [
  {
    fig: 'shift',
    name: '不具合が、前の工程で見つかる',
    body: '誤りを後ろの工程へ持ち越さない。',
  },
  {
    fig: 'time',
    name: '作る時間が縮み、決める時間が増える',
    body: '空いた時間を、業務の検討と合意へ。',
  },
  {
    fig: 'daily',
    name: '進み具合と課題が、毎朝そろっている',
    body: '報告のための資料づくりが要らない。',
  },
  {
    fig: 'even',
    name: '担当が替わっても、出来がそろう',
    body: '誰が頼んでも、同じ形で出る。',
  },
];

const meritsRun = [
  { name: '引継ぎで知識が落ちない', body: '稼働の日から、導入の記録が使える。' },
  { name: '問い合わせに、その場で答える', body: '記録を持ったAIが、回答の下書きを作る。' },
  { name: '改修の影響が、すぐに分かる', body: '関係する設計書・プログラム・テストが並ぶ。' },
  { name: '止まる前に気づく', body: '夜間の処理と締めを、AIが見張る。' },
];

const steps = [
  { no: '01', name: '現状を見る', body: '設計書・規約・進め方を見て、AIが効く工程を分ける。' },
  { no: '02', name: '手順を作る', body: 'お客様の様式と規約に合わせて作る。' },
  { no: '03', name: '一機能で試す', body: '実際の案件で、設計からテストまで通す。' },
  { no: '04', name: '広げて、渡す', body: '手順はお客様のものとして残す。' },
];

const rules = [
  '結果は人が確かめて決める。AIに決めさせない。',
  '本番環境では、AIに画面を操作させない。',
  'お客様の情報を、AIの学習に使われない設定で扱う。',
];

const career = [
  { from: 2001, to: 2009, seat: '業務の当事者', org: '大手自動車メーカー', body: '受注・在庫・物流の運営。SAP PP の更改を業務側で主導。' },
  { from: 2009, to: 2017, seat: 'コンサルタント', org: '外資系コンサルティングファーム', body: 'SAP ECC・S/4HANA の導入（SD・MM）。構想から要件の確定まで。' },
  { from: 2017, to: 2024, seat: 'プロジェクト責任者', org: '外資系IT企業', body: 'S/4HANA の再構築を約120名のPMとして統括。アジア3拠点へ展開。' },
  { from: 2024, to: 2026, seat: '生成AIでの導入', org: 'TechTime', body: '大型の SAP 案件で、生成AIで作る手順と点検の仕組みを設計。' },
];
const Y0 = 2001;
const Y1 = 2026;
const years = Array.from({ length: Y1 - Y0 + 1 }, (_, i) => Y0 + i);
const pct = (y: number) => ((y - Y0) / (Y1 - Y0)) * 100;
---

<DraftLayout title={title} description={description}>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="frame" aria-hidden="true">
    <span class="frame__tl">TECHTIME CO., LTD.</span>
    <span class="frame__tr"><b id="sheetNo">01</b> / 12</span>
  </div>

  <header class="nav">
    <a href="/" class="nav__logo">TechTime<i></i></a>
    <nav class="nav__links">
      <a href="#team">AIチーム</a>
      <a href="#change">AIで変わること</a>
      <a href="#pm">プロジェクト管理</a>
      <a href="#build" class="nav__lo">導入</a>
      <a href="#run" class="nav__lo">運用保守</a>
      <a href="#how" class="nav__lo">進め方</a>
      <span class="nav__sep" aria-hidden="true"></span>
      <a href="/services" class="nav__page nav__hot">サービス</a>
      <a href="/assessment" class="nav__page nav__hot">アセスメント</a>
      <a href="/blog" class="nav__page">ブログ</a>
      <div class="nav__act"><a href="/contact?topic=assess" class="nav__cta"><span class="nav__cta-l">アセスメントの相談はこちら</span><span class="nav__cta-s">アセスメントの相談</span><svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
        <a href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" class="nav__smp"><b>アセスメントのサンプル</b><span>PDF・29枚</span><i>↗</i></a>
      </div>
    </nav>
  </header>

  <main>
    <!-- ============ 01 HERO ============ -->
    <section class="hero" data-sheet="01">
      <div class="hero__copy">
        <p class="tag"><span>01</span>SAP の導入と保守への、新しい入り方</p>
        <h1 class="hero__h1">
          <span class="hl"><span>SAP 導入に、</span></span>
          <span class="hl"><span><em>AIチーム</em>という選択肢を。</span></span>
        </h1>
        <p class="hero__lead rv">
          設計、開発、テスト、点検、進捗管理。それぞれを受け持つAIチームを、SAP の導入と保守のプロジェクトに組み込みます。<br />工数ではなく、プロジェクトに残る仕組みを納めます。
        </p>
        <div class="hero__act rv">
          <a href="#contact" class="btn">相談する<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
          <a href="#assess" class="btn btn--line">アセスメントのサンプルを見る<small>PDF・29枚</small></a>
          <a href="#film" class="link">現場を見る</a>
        </div>
      </div>

      <div class="hero__fig">
        <svg id="erp" viewBox="0 0 650 540" role="img" aria-label="受注から会計まで、伝票が基幹システムの中を流れ、AIが各処理を点検していく図">
          <path d={flowD} class="erp__path" />
          <path d={flowD} class="erp__march" />
          <g id="tokens"></g>
          {nodes.map((p, i) => (
            <g class="node" data-i={i} transform={`translate(${p.x - 68} ${p.y - 38})`}>
              <rect width="136" height="76" class="node__box" />
              <rect width="136" height="76" class="node__hit" />
              <text x="12" y="22" class="node__k">{p.k}</text>
              <text x="12" y="50" class="node__n">{p.n}</text>
              <text x="124" y="66" class="node__c" text-anchor="end">0000</text>
              <g transform="translate(116 14)">
                <g class="node__ok">
                  <circle r="13" />
                  <text y="5" text-anchor="middle">済</text>
                </g>
              </g>
            </g>
          ))}
          <g id="scan"><circle r="15" /><circle r="4" class="dot" /><text x="22" y="5">AI</text></g>
        </svg>
        <p class="hero__cap">
          <span><i class="lg lg--doc"></i>伝票の流れ（受注から会計まで）</span>
          <span><i class="lg lg--ai"></i>AIの点検</span>
        </p>
      </div>
    </section>

    <!-- ============ 02 現場の映像 ============ -->
    <section class="sec film" id="film" data-sheet="02">
      <div class="sec__head">
        <p class="tag rv"><span>02</span>AIチームがいる現場</p>
        <h2 class="h2 rv">ある一日の、<br />SAP 導入プロジェクト。</h2>
      </div>
      <div class="scr rv" id="scr" aria-hidden="true">
        <div class="scr__top">
          <span class="scr__pj"><i></i>S/4HANA 導入プロジェクト（架空の例）</span>
          <span class="scr__day"><u id="scrDay"></u></span>
          <b class="scr__clock" id="scrClock">07:00</b>
        </div>
        <div class="scr__grid">
          {team.map((m) => (
            <div class="pane" data-k={m.k}>
              <div class="pane__h"><i></i><b>{m.name}</b><span>{m.unit}<u>0</u></span></div>
              <div class="pane__b"></div>
            </div>
          ))}
          <div class="pane pane--human" data-k="human">
            <div class="pane__h"><i></i><b>人（PM・業務担当）</b><span>決めたこと<u>0</u></span></div>
            <div class="pane__b"></div>
          </div>
        </div>
        <p class="scr__cap" id="scrCap">朝、AIチームが記録を読みはじめる。</p>
      </div>
    </section>

    <!-- ============ 03 AIチームという入り方 ============ -->
    <section class="sec team" id="team" data-sheet="03">
      <div class="sec__head">
        <p class="tag rv"><span>03</span>AIチームという入り方</p>
        <h2 class="h2 rv">工数ではなく、<br />仕組みを納める。</h2>
      </div>

      <div class="org rv">
        <div class="org__top"><b>お客様と PM</b><span>業務を決める。合否を決める。</span></div>
        <div class="org__ai">
          {team.map((m, i) => (
            <div class="mem" style={`--d:${0.3 + i * 0.12}s`}><em>AI</em><b>{m.name.replace('のAI', '')}</b><span>{m.job}</span></div>
          ))}
        </div>
        <div class="org__tt"><b>TechTime</b><span>手順と点検の観点を作り、AIチームを組み、育てる。</span></div>
      </div>

      <div class="vs">
        <article class="vs__c rv">
          <p class="vs__k">工数の提供</p>
          <svg viewBox="0 0 400 190" aria-hidden="true">
            <path d="M24 160H388M24 160V18" class="ax" />
            <path d="M284 14V160" class="end" /><text x="290" y="24">契約の終わり</text>
            <path d="M24 160H52V74H284V160H388" pathLength="1" class="ln2" />
            {[70, 110, 150, 190, 230].map((x) => <g class="man" transform={`translate(${x} 50)`}><circle r="6" /><path d="M-8 20a8 9 0 0 1 16 0" /></g>)}
          </svg>
          <h3>人が離れると、止まる。</h3>
        </article>
        <article class="vs__c vs__c--on rv" style="--d:.12s">
          <p class="vs__k">仕組みの提供</p>
          <svg viewBox="0 0 400 190" aria-hidden="true">
            <path d="M24 160H388M24 160V18" class="ax" />
            <path d="M284 14V160" class="end" /><text x="290" y="24">契約の終わり</text>
            <path d="M24 160C120 160 150 72 284 58C330 53 360 42 388 30V160H24Z" class="area" />
            <path d="M24 160C120 160 150 72 284 58C330 53 360 42 388 30" pathLength="1" class="ln2" />
          </svg>
          <h3>納めたあとも、残って育つ。</h3>
        </article>
      </div>
    </section>

    <!-- ============ 04 アセスメント ============ -->
    <section class="sec asm" id="assess" data-sheet="04">
      <div class="asm__in">
        <div class="asm__txt">
          <p class="tag rv"><span>04</span>最初の一歩は、アセスメント</p>
          <h2 class="h2 rv">貴社の資料を読み、<br />どこに効くかを報告書にする。</h2>
          <p class="sec__lead rv">設計書や会議の記録をお預かりし、AIチームが効く工程と、最初に手を打つ所を報告書にまとめます。架空の会社を題材にした、結果報告書のサンプルをご覧いただけます。</p>
          <ul class="asm__pts rv">
            <li><b>全件を読む</b>抜き取りではなく、預かった資料をすべて</li>
            <li><b>統計で測る</b>期日に間に合う確率、減る工数の見込み</li>
            <li><b>根拠を並べる</b>所見ごとに、資料の抜粋を添える</li>
          </ul>
          <div class="asm__act rv">
            <a href="/downloads/techtime-assessment-sample.pdf" download="TechTime_アセスメント結果報告書_サンプル.pdf" class="btn">サンプルをダウンロード<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
            <a href="/assessment" class="link">アセスメントの内容を見る</a>
            <a href="/contact?topic=assess" class="link">アセスメントを相談する</a>
          </div>
          <p class="asm__note rv">PDF・29枚・約2MB。お名前やメールアドレスの入力は要りません。</p>
        </div>
        <a class="asm__deck rv" id="deck" href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" aria-label="アセスメント結果報告書のサンプルを開く">
          {['01', '03', '07', '10', '12', '20'].map((n, i) => <img src={`/images/assess/p${n}.webp`} alt={i === 0 ? 'アセスメント結果報告書のサンプルの頁' : ''} loading="lazy" width="1120" height="792" style={`--i:${i}`} data-i={i} />)}
        </a>
      </div>
    </section>


    <!-- ============ 02 CHANGE ============ -->
    <section class="sec" id="change" data-sheet="05">
      <div class="sec__head">
        <p class="tag rv"><span>05</span>AIで変わること</p>
        <h2 class="h2 rv">抜き取りから、全件へ。<br />書くことから、決めることへ。</h2>
      </div>

      <div class="cmp rv" id="cmp" aria-hidden="true">
        <div class="cmp__col">
          <p class="cmp__name">これまで　抜き取りで確かめる</p>
          <div class="cells" data-side="l">
            {cells.map((i) => (
              <i class:list={[{ s: sampled.includes(i), d: defects.includes(i) }]}></i>
            ))}
          </div>
          <p class="cmp__read">確かめた <b id="lChk">0</b> / {cells.length}　　見つけた誤り <b id="lHit">0</b>　　<span class="miss" id="lMiss">残った誤り {defects.length}</span></p>
        </div>
        <div class="cmp__col cmp__col--now">
          <p class="cmp__name">いま　AIが全件を確かめる</p>
          <div class="cells" data-side="r">
            {cells.map((i) => (
              <i class:list={[{ d: defects.includes(i) }]} style={`--w:${(i % COLS) + Math.floor(i / COLS)}`}></i>
            ))}
          </div>
          <p class="cmp__read">確かめた <b id="rChk">0</b> / {cells.length}　　見つけた誤り <b id="rHit">0</b></p>
        </div>
      </div>

      <div class="ph rv" id="ph">
        <div class="ph__bar">
          {phases.map((p, i) => (
            <button type="button" class:list={['ph__tab', { 'is-on': i === 0 }]} data-i={i}>
              <small>{String(i + 1).padStart(2, '0')}</small>{p.name}
            </button>
          ))}
        </div>
        <div class="ph__panes">
          <div class:list={['ph__pane', { 'is-on': true }]} data-i={0}>
            <div class="ph__cap">
              <p class="ph__line"><b>AI</b>{phases[0].line}</p>
              <p class="ph__human"><b>人</b>{phases[0].human}</p>
            </div>
            <div class="ph__stage" aria-hidden="true">
              <div class="st st--req">
                <div class="box talk">
                  <em>会議の記録</em>
                  {[78, 54, 88, 62, 72].map((w, k) => <i class:list={['bb', 'p', { r: k % 2 === 1 }]} style={`--t:${0.1 + k * 0.22}s;--w:${w}%`}></i>)}
                </div>
                <span class="aibadge p" style="--t:1.5s">AI</span>
                <div class="box out">
                  <em>決定</em>
                  {[0, 1, 2].map((k) => <b class="cp ok p" style={`--t:${2 + k * 0.4}s`}><i style={`width:${[70, 52, 84][k]}%`}></i></b>)}
                  <em class="mt">未決</em>
                  {[0, 1].map((k) => <b class="cp ng p" style={`--t:${3.4 + k * 0.4}s`}><i style={`width:${[60, 76][k]}%`}></i></b>)}
                </div>
              </div>
            </div>
          </div>
          <div class:list={['ph__pane', { 'is-on': false }]} data-i={1}>
            <div class="ph__cap">
              <p class="ph__line"><b>AI</b>{phases[1].line}</p>
              <p class="ph__human"><b>人</b>{phases[1].human}</p>
            </div>
            <div class="ph__stage" aria-hidden="true">
              <div class="st st--des">
                <div class="box doc">
                  <em>設計書</em>
                  {W8.map((w, k) => <i class:list={['ln', 'ty', { flag: k === 2 || k === 5 }]} style={`--t:${0.2 + k * 0.28}s;--w:${w}%`}></i>)}
                  <span class="scanl"></span>
                </div>
                <div class="box side">
                  <em>AIの点検</em>
                  <b class="cp ng p" style="--t:4.5s">指摘</b>
                  <b class="cp ng p" style="--t:4.9s">指摘</b>
                  <b class="cp ok p" style="--t:5.4s">ほかは問題なし</b>
                </div>
              </div>
            </div>
          </div>
          <div class:list={['ph__pane', { 'is-on': false }]} data-i={2}>
            <div class="ph__cap">
              <p class="ph__line"><b>AI</b>{phases[2].line}</p>
              <p class="ph__human"><b>人</b>{phases[2].human}</p>
            </div>
            <div class="ph__stage" aria-hidden="true">
              <div class="st st--dev">
                <div class="box src">
                  <em>設計書</em>
                  {[80, 60, 90, 50].map((w) => <i class="ln" style={`--w:${w}%`}></i>)}
                </div>
                <span class="aibadge p" style="--t:0.5s">AI</span>
                <div class="box code">
