---
import PageLayout from '@/layouts/PageLayout.astro';
import { faqGroups } from '@/data/faq';
const title = 'よくある質問 | TechTime';
const description = 'TechTime のサービスについて、よくいただく質問と答えです。人を出すサービスとの違い、始め方、預かった資料の扱い、費用と期間の決まり方を説明します。';
const ld = [
  {
    '@type': 'FAQPage',
    mainEntity: faqGroups.flatMap((g) => g.items).map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---

<PageLayout
  title={title}
  description={description}
  crumbs={[{ name: 'よくある質問' }]}
  tag="サービス・始め方・情報の扱い・費用"
  h1={['よくある質問']}
  lead="サービスの内容、始め方、お預かりした資料の扱い、費用と期間の決まり方について、よくいただく質問に答えます。"
  ld={ld}
  ask="ここに無い質問は、相談票からお送りください。"
>
  {faqGroups.map((g, i) => (
    <section class:list={['sec', i === 0 && 'pg-near']} data-st={g.name}>
      <div class="pg-grp rv">
        <h2>{g.name}</h2>
        <dl class="pg-qa">{g.items.map(([q, a]) => <div><dt>{q}</dt><dd>{a}</dd></div>)}</dl>
      </div>
    </section>
  ))}
  <p class="pg-tail rv">導入の検討中でも、途中でも、稼働したあとでも構いません。<a href="/process" class="more">進め方とお見積もりを見る</a></p>
</PageLayout>
