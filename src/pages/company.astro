---
import PageLayout from '@/layouts/PageLayout.astro';
const SITE = 'https://techtime-jp.com';
const title = '会社概要 | TechTime株式会社';
const description = 'TechTime株式会社の会社概要です。SAP を中心とした基幹システムの導入と運用保守に、生成AIのチームを組み込む仕組みを提供しています。所在地、設立、事業の内容を掲載しています。';
const rows: [string, string][] = [
  ['会社名', 'TechTime株式会社（TechTime Co., Ltd.）'],
  ['設立', '2020年4月1日'],
  ['資本金', '800万円'],
  ['所在地（東京）', '〒150-0002　東京都渋谷区渋谷2-19-15 宮益坂ビルディング609'],
  ['所在地（大阪）', '〒530-0001　大阪府大阪市北区梅田1丁目2番2号 大阪駅前第2ビル12-12'],
  ['電話', '03-4222-3363（月曜から金曜　9時から19時）'],
];
const works = [
  ['アセスメント', 'プロジェクトの設計書・会議の記録・課題表を全件読み、生成AIが効く工程を報告書にまとめます。', '/assessment'],
  ['導入への組み込み', '要件定義、設計、開発、テスト、移行、プロジェクト管理のそれぞれに、AIの手順を組み込みます。', '/services'],
  ['運用保守への組み込み', '導入の記録を、問い合わせへの回答と、改修の影響の調査に使える形にします。', '/services/operations'],
];
const ld = [{ '@type': 'AboutPage', '@id': `${SITE}/company#page`, name: title, about: { '@id': `${SITE}/#org` }, url: `${SITE}/company` }];
---

<PageLayout
  title={title}
  description={description}
  cur="company"
  crumbs={[{ name: '会社概要' }]}
  tag="TechTime株式会社"
  h1={['SAP の導入と運用保守に、', '生成AIの仕組みを提供する会社。']}
  lead="TechTime は、SAP を中心とした基幹システムの導入と運用保守に、生成AIのチームを組み込みます。提供するのは、人の作業時間ではありません。プロジェクトに残る、手順と点検の観点です。"
  ld={ld}
  ask="いまの進め方を、聞かせてください。"
>
  <section class="sec pg-near" data-st="会社の情報">
    <div class="pg-grp rv">
      <h2>会社の情報</h2>
      <table class="pg-tbl">
        <tbody>{rows.map(([a, b]) => <tr><th>{a}</th><td>{b}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="sec" data-st="事業の内容">
    <div class="head rv">
      <p class="kick">事業の内容</p>
      <h2>3つの形で、<br />AIチームを提供する。</h2>
    </div>
    <div class="pg-cds pg-body rv">
      {works.map(([a, b, h]) => <a href={h}><b>{a}</b><p>{b}</p></a>)}
    </div>
  </section>

  <section class="sec" data-st="守ること">
    <div class="head rv">
      <p class="kick">守ること</p>
      <h2>決めるのは人。<br />AIには決めさせない。</h2>
    </div>
    <div class="pg-cds pg-cds--tint pg-body rv">
      <div><b>結果は人が確かめて決める</b><p>AIは、材料と下書きを作ります。業務の内容と合否は、人が決めます。</p></div>
      <div><b>本番環境では、AIに操作させない</b><p>AIが画面を操作するのは、検証環境だけです。</p></div>
      <div><b>情報を、AIの学習に使わせない</b><p>お客様の情報は、AIの学習に使われない設定で扱います。</p></div>
    </div>
    <p class="pg-tail rv">導入の検討中でも、途中でも、稼働したあとでも構いません。<a href="/services" class="more">サービスの一覧を見る</a></p>
  </section>
</PageLayout>
