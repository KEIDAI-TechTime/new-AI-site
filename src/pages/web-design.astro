---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';

const title = 'Webサイト制作 | TechTime株式会社';
const description = 'コーポレートサイトからEC、Webアプリまで。AI駆動のデザイン・開発で、高品質なWebサイトを短期間・低コストで制作します。';

const portfolioData = [
  {
    title: 'Harlow Ice Cream ブランドサイト',
    industry: '飲食・サービス',
    style: 'ポップ・カジュアル系',
    icon: 'ri-cake-3-line',
    description: '1950年代アメリカンダイナーをコンセプトにしたハンドメイドアイスクリーム店のLP',
    duration: '2週間',
    scope: 'デザイン〜実装',
    gradient: 'from-[#E8927C] to-[#F2C94C]',
    demoUrl: 'https://kydlty.readdy.co',
    previewUrl: 'https://kydlty.readdy.co'
  },
  {
    title: 'コードアドベンチャー プログラミングスクールLP',
    industry: '教育・スクール',
    style: 'ポップ・カジュアル系',
    icon: 'ri-rocket-2-line',
    description: '冒険×発見がテーマの子ども向けプログラミングスクールのランディングページ',
    duration: '2週間',
    scope: 'デザイン〜実装',
    gradient: 'from-[#FF8C42] to-[#2EC4B6]',
    demoUrl: 'https://ssrnvs.readdy.co',
    previewUrl: 'https://ssrnvs.readdy.co'
  },
  {
    title: '製造業A社 コーポレートサイト',
    industry: '製造業・メーカー',
    style: 'コーポレート・信頼系',
    icon: 'ri-building-line',
    description: '老舗製造業のリブランディングに伴う全面リニューアル',
    duration: '2ヶ月',
    scope: '企画〜実装',
    gradient: 'from-[#6366f1] to-[#8b5cf6]'
  },
  {
    title: 'クリニックB 新規開院LP',
    industry: '医療・福祉',
    style: '温かみ・親しみ系',
    icon: 'ri-hospital-line',
    description: '新規開院に伴う集患用ランディングページ',
    duration: '3週間',
    scope: 'デザイン〜実装',
    gradient: 'from-[#00D4AA] to-[#06b6d4]'
  },
  {
    title: '食品メーカーC社 ECサイト',
    industry: '小売・EC',
    style: '温かみ・親しみ系',
    icon: 'ri-shopping-bag-3-line',
    description: 'D2C展開のための自社ECサイト構築',
    duration: '3ヶ月',
    scope: '企画〜運用支援',
    gradient: 'from-[#f59e0b] to-[#ef4444]'
  },
  {
    title: '不動産D社 物件管理システム',
    industry: '不動産・建築',
    style: 'モダン・スタイリッシュ系',
    icon: 'ri-home-smile-line',
    description: '物件情報管理と顧客向けポータル',
    duration: '4ヶ月',
    scope: '要件定義〜実装',
    gradient: 'from-[#ec4899] to-[#8b5cf6]'
  },
  {
    title: 'ITスタートアップE社 コーポレートサイト',
    industry: 'IT・テック',
    style: 'モダン・スタイリッシュ系',
    icon: 'ri-macbook-line',
    description: 'シリーズA調達に向けたブランディングサイト',
    duration: '1.5ヶ月',
    scope: '企画〜実装',
    gradient: 'from-[#10b981] to-[#06b6d4]'
  },
  {
    title: '美容室F サロンサイト',
    industry: '美容・サロン',
    style: '高級・ブランド系',
    icon: 'ri-scissors-cut-line',
    description: '高単価顧客向けブランドサイトリニューアル',
    duration: '1ヶ月',
    scope: 'デザイン〜実装',
    gradient: 'from-[#f59e0b] to-[#f97316]'
  },
  {
    title: '税理士事務所G 事務所サイト',
    industry: '士業・コンサル',
    style: 'コーポレート・信頼系',
    icon: 'ri-briefcase-line',
    description: '信頼感を重視した事務所紹介サイト',
    duration: '1.5ヶ月',
    scope: '企画〜実装',
    gradient: 'from-[#6366f1] to-[#8b5cf6]'
  },
  {
    title: 'レストランH 店舗サイト',
    industry: '飲食・サービス',
    style: '高級・ブランド系',
    icon: 'ri-restaurant-line',
    description: '高級レストランのブランドサイト',
    duration: '1ヶ月',
    scope: 'デザイン〜実装',
    gradient: 'from-[#00D4AA] to-[#06b6d4]'
  }
];

const industries = [
  'すべて',
  '製造業・メーカー',
  '小売・EC',
  '士業・コンサル',
  '飲食・サービス',
  '教育・スクール',
  '医療・福祉',
  '不動産・建築',
  'IT・テック',
  '美容・サロン'
];

const styles = [
  'コーポレート・信頼系',
  'モダン・スタイリッシュ系',
  '高級・ブランド系',
  '温かみ・親しみ系',
  'ポップ・カジュアル系'
];

const services = [
  {
    icon: 'ri-building-4-line',
    title: 'コーポレートサイト',
    description: '企業の顔となるWebサイト',
    gradient: 'from-[#6366f1] to-[#8b5cf6]'
  },
  {
    icon: 'ri-rocket-line',
    title: 'LP',
    description: '集客・CVに特化した1ページサイト',
    gradient: 'from-[#00D4AA] to-[#06b6d4]'
  },
  {
    icon: 'ri-shopping-cart-line',
    title: 'ECサイト',
    description: 'オンラインショップ構築',
    gradient: 'from-[#f59e0b] to-[#ef4444]'
  },
  {
    icon: 'ri-flashlight-line',
    title: 'Webアプリ',
    description: '業務効率化・顧客向けサービス',
    gradient: 'from-[#ec4899] to-[#8b5cf6]'
  }
];

const steps = [
  {
    number: '01',
    title: 'ヒアリング・企画',
    description: '目的・ターゲット・競合分析からサイト設計'
  },
  {
    number: '02',
    title: 'デザイン',
    description: 'AI活用の高速デザイン、複数案提示'
  },
  {
    number: '03',
    title: '開発・実装',
    description: 'レスポンシブ・SEO最適化標準装備'
  },
  {
    number: '04',
    title: '公開・運用',
    description: '更新サポート・アクセス解析対応'
  }
];

const getIndustryCount = (industry: string) => {
  if (industry === 'すべて') return portfolioData.length;
  return portfolioData.filter(item => item.industry === industry).length;
};
---

<BaseLayout title={title} description={description}>
  <Navigation currentPath="/web-design" />

  <div class="min-h-screen bg-[#0A1628]">
    <!-- Hero Section -->
    <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden pt-20">
      <div class="absolute inset-0 bg-gradient-to-br from-[#6366f1]/20 via-[#0A1628] to-[#00D4AA]/20"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/20 to-black/30"></div>

      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[#6366f1]/30 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-[#00D4AA]/30 rounded-full blur-3xl"></div>

      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center w-full">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#00D4AA]/20 border border-[#00D4AA]/30 mb-8">
          <i class="ri-palette-line text-[#00D4AA]"></i>
          <span class="text-sm font-medium text-[#00D4AA]">AI × クリエイティブ</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-6 leading-tight">
          Webサイトを、<br />
          <span class="bg-gradient-to-r from-[#6366f1] to-[#00D4AA] bg-clip-text text-transparent">
            もっと手軽に。
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-300 mb-12 leading-relaxed">
          コーポレートサイトからEC、Webアプリまで。<br />
          AI駆動のデザイン・開発で、高品質なWebサイトを短期間・低コストで制作します。
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#portfolio"
            class="px-8 py-4 bg-gradient-to-r from-[#6366f1] to-[#00D4AA] text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-[#00D4AA]/50 transition-all duration-300 hover:-translate-y-1 cursor-pointer whitespace-nowrap"
          >
            制作実績を見る
          </a>
          <a
            href="/simulator"
            class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-xl hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 cursor-pointer whitespace-nowrap"
          >
            見積もりシミュレーター
          </a>
        </div>
      </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portfolio" class="py-24 px-6 bg-[#0A1628]">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <div class="text-[#00D4AA] text-sm font-bold tracking-widest mb-4">PORTFOLIO</div>
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">制作実績</h2>
          <p class="text-gray-400 text-lg">様々な業界・規模のWebサイト制作を手がけてきました</p>
        </div>

        <!-- Industry Filter -->
        <div class="mb-12">
          <div class="mb-6 overflow-x-auto pb-4">
            <div class="flex gap-3 min-w-max" id="industry-filters">
              {industries.map((industry, index) => (
                <button
                  data-industry={industry}
                  class={`industry-btn px-6 py-3 rounded-xl font-medium transition-all duration-300 cursor-pointer whitespace-nowrap ${
                    index === 0
                      ? 'bg-gradient-to-r from-[#6366f1] to-[#00D4AA] text-white shadow-lg active'
                      : 'bg-white/5 text-gray-300 hover:bg-white/10 border border-white/10'
                  }`}
                >
                  {industry}
                  <span class="ml-2 text-xs opacity-70">({getIndustryCount(industry)})</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Style Filter -->
          <div class="flex flex-wrap gap-3" id="style-filters">
            {styles.map((style) => (
              <button
                data-style={style}
                class="style-btn px-5 py-2.5 rounded-lg font-medium text-sm transition-all duration-300 cursor-pointer whitespace-nowrap bg-white/5 text-gray-300 hover:bg-white/10 border border-white/10"
              >
                {style}
              </button>
            ))}
          </div>
        </div>

        <!-- Portfolio Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="portfolio-grid">
          {portfolioData.map((item, index) => (
            <div
              class="portfolio-item group bg-white/[0.02] border border-white/[0.05] rounded-2xl overflow-hidden hover:-translate-y-2 hover:border-[#00D4AA] transition-all duration-300 hover:shadow-xl hover:shadow-[#00D4AA]/20 cursor-pointer"
              data-industry={item.industry}
              data-style={item.style}
            >
              <div class={`aspect-[16/10] bg-gradient-to-br ${item.gradient} flex items-center justify-center relative overflow-hidden`}>
                {item.previewUrl ? (
                  <div class="absolute inset-0 overflow-hidden">
                    <iframe
                      src={item.previewUrl}
                      class="w-[200%] h-[200%] origin-top-left scale-50 pointer-events-none"
                      loading="lazy"
                      title={`${item.title} プレビュー`}
                    ></iframe>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                  </div>
                ) : (
                  <>
                    <div class="absolute inset-0 bg-black/20"></div>
                    <div class="relative w-20 h-20 flex items-center justify-center">
                      <i class={`${item.icon} text-6xl text-white`}></i>
                    </div>
                  </>
                )}
              </div>

              <div class="p-6">
                <div class="flex gap-2 mb-4">
                  <span class="px-3 py-1 bg-[#6366f1]/20 text-[#a5b4fc] text-xs font-medium rounded-full border border-[#6366f1]/30">
                    {item.industry}
                  </span>
                  <span class="px-3 py-1 bg-[#00D4AA]/20 text-[#00D4AA] text-xs font-medium rounded-full border border-[#00D4AA]/30">
                    {item.style}
                  </span>
                </div>

                <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
                <p class="text-gray-400 text-sm mb-4 leading-relaxed">{item.description}</p>

                <div class="flex items-center justify-between text-xs text-gray-500 mb-4">
                  <span><i class="ri-time-line mr-1"></i>{item.duration}</span>
                  <span><i class="ri-file-list-3-line mr-1"></i>{item.scope}</span>
                </div>

                {item.demoUrl && (
                  <a
                    href={item.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-[#6366f1] to-[#00D4AA] text-white text-sm font-semibold rounded-lg hover:shadow-lg hover:shadow-[#00D4AA]/30 transition-all duration-300"
                    onclick="event.stopPropagation();"
                  >
                    <i class="ri-external-link-line"></i>
                    デモを見る
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Empty State -->
        <div id="empty-state" class="hidden text-center py-20">
          <div class="text-6xl mb-4">🔍</div>
          <p class="text-gray-400 text-lg">この条件の実績はまだありません</p>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-24 px-6 bg-[#0d1b2f]">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <div class="text-[#00D4AA] text-sm font-bold tracking-widest mb-4">SERVICES</div>
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">対応サービス</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {services.map((service) => (
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-2xl p-8 hover:-translate-y-2 hover:border-[#00D4AA] transition-all duration-300 hover:shadow-xl hover:shadow-[#00D4AA]/20 cursor-pointer">
              <div class={`w-16 h-16 rounded-2xl bg-gradient-to-br ${service.gradient} flex items-center justify-center mb-6`}>
                <i class={`${service.icon} text-3xl text-white`}></i>
              </div>
              <h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{service.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="py-24 px-6 bg-[#0A1628]">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <div class="text-[#00D4AA] text-sm font-bold tracking-widest mb-4">PROCESS</div>
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">制作の流れ</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {steps.map((step, index) => (
            <div class="relative">
              <div class="bg-white/[0.02] border border-white/[0.05] rounded-2xl p-8 hover:-translate-y-2 hover:border-[#00D4AA] transition-all duration-300">
                <div class="text-7xl font-bold bg-gradient-to-r from-[#6366f1] to-[#00D4AA] bg-clip-text text-transparent mb-6">
                  {step.number}
                </div>
                <h3 class="text-xl font-bold text-white mb-4">{step.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{step.description}</p>
              </div>

              {index < steps.length - 1 && (
                <div class="hidden lg:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10">
                  <i class="ri-arrow-right-line text-2xl text-[#00D4AA]"></i>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Pricing Info -->
        <div class="mt-20 bg-white/[0.02] border border-white/[0.05] rounded-2xl p-12 text-center">
          <h3 class="text-2xl font-bold text-white mb-4">料金について</h3>
          <p class="text-gray-400 mb-8 leading-relaxed">
            プロジェクトの規模・要件に応じて柔軟にお見積り。<br />
            見積もりシミュレーターで概算確認可能。
          </p>
          <a
            href="/simulator"
            class="inline-block px-8 py-4 bg-gradient-to-r from-[#6366f1] to-[#00D4AA] text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-[#00D4AA]/50 transition-all duration-300 hover:-translate-y-1 cursor-pointer whitespace-nowrap"
          >
            見積もりシミュレーターで確認
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 px-6 bg-[#0d1b2f] relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-[#6366f1]/30 to-[#00D4AA]/30 rounded-full blur-3xl"></div>

      <div class="max-w-4xl mx-auto text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Webサイト制作のご相談はこちら
        </h2>
        <p class="text-xl text-gray-300 mb-12 leading-relaxed">
          まずは見積もりシミュレーターで概算を確認。<br />
          詳細なご相談も承ります。
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/simulator"
            class="px-8 py-4 bg-gradient-to-r from-[#6366f1] to-[#00D4AA] text-white font-semibold rounded-xl hover:shadow-lg hover:shadow-[#00D4AA]/50 transition-all duration-300 hover:-translate-y-1 cursor-pointer whitespace-nowrap"
          >
            見積もりシミュレーター
          </a>
          <a
            href="/contact"
            class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-xl hover:bg-white/10 transition-all duration-300 hover:-translate-y-1 cursor-pointer whitespace-nowrap"
          >
            お問い合わせ
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Portfolio filtering
  document.addEventListener('DOMContentLoaded', () => {
    const industryBtns = document.querySelectorAll('.industry-btn');
    const styleBtns = document.querySelectorAll('.style-btn');
    const portfolioItems = document.querySelectorAll('.portfolio-item');
    const emptyState = document.getElementById('empty-state');

    let selectedIndustry = 'すべて';
    let selectedStyles: string[] = [];

    function filterPortfolio() {
      let visibleCount = 0;

      portfolioItems.forEach((item) => {
        const itemIndustry = item.getAttribute('data-industry');
        const itemStyle = item.getAttribute('data-style');

        const industryMatch = selectedIndustry === 'すべて' || itemIndustry === selectedIndustry;
        const styleMatch = selectedStyles.length === 0 || selectedStyles.includes(itemStyle || '');

        if (industryMatch && styleMatch) {
          (item as HTMLElement).style.display = '';
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    industryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        industryBtns.forEach((b) => {
          b.classList.remove('bg-gradient-to-r', 'from-[#6366f1]', 'to-[#00D4AA]', 'text-white', 'shadow-lg', 'active');
          b.classList.add('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
        });

        btn.classList.remove('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
        btn.classList.add('bg-gradient-to-r', 'from-[#6366f1]', 'to-[#00D4AA]', 'text-white', 'shadow-lg', 'active');

        selectedIndustry = btn.getAttribute('data-industry') || 'すべて';
        filterPortfolio();
      });
    });

    styleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const style = btn.getAttribute('data-style') || '';

        if (selectedStyles.includes(style)) {
          selectedStyles = selectedStyles.filter((s) => s !== style);
          btn.classList.remove('bg-[#00D4AA]', 'text-white', 'shadow-lg');
          btn.classList.add('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
        } else {
          selectedStyles.push(style);
          btn.classList.remove('bg-white/5', 'text-gray-300', 'border', 'border-white/10');
          btn.classList.add('bg-[#00D4AA]', 'text-white', 'shadow-lg');
        }

        filterPortfolio();
      });
    });
  });
</script>
