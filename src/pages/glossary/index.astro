---
import PageLayout from '@/layouts/PageLayout.astro';
import { terms, groups } from '@/data/glossary';
const SITE = 'https://techtime-jp.com';
const title = 'SAP 導入の用語集 | TechTime';
const description = `SAP の導入と運用保守で使う言葉を、${terms.length}語まとめました。Fit to Standard、クリーンコア、2027年問題、結合テスト、データ移行などの意味と、生成AIを使うと何が変わるかを説明します。`;
const ld = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${SITE}/glossary#set`,
    name: 'SAP 導入の用語集',
    hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.word, description: t.def, url: `${SITE}/glossary/${t.slug}` })),
  },
];
---

<PageLayout
  title={title}
  description={description}
  crumbs={[{ name: '用語集' }]}
  tag={`${terms.length}語`}
  h1={['SAP 導入の言葉を、', '短く説明する。']}
  lead="SAP の導入と運用保守で使う言葉をまとめました。言葉ごとに、意味と、生成AIを使うと何が変わるかを説明します。"
  ld={ld}
>
  {groups.map((g, gi) => (
    <section class:list={['sec', gi === 0 && 'pg-near']} data-st={g}>
      <div class="pg-grp rv">
        <h2>{g}</h2>
        <dl class="pg-qa gl">
          {terms.filter((t) => t.group === g).map((t) => (
            <div><dt><a href={`/glossary/${t.slug}`} class="pg-lnk">{t.word}</a></dt><dd>{t.def}</dd></div>
          ))}
        </dl>
      </div>
    </section>
  ))}
</PageLayout>

<style is:global>
  .gl div { grid-template-columns: 1fr 2fr; }
  @media (max-width: 900px) { .gl div { grid-template-columns: 1fr; } }
</style>
