---
import PageLayout from '@/layouts/PageLayout.astro';
import { terms, termBySlug } from '@/data/glossary';
import { posts } from '@/data/posts';
import { serviceBySlug } from '@/data/services';

export function getStaticPaths() {
  return terms.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const SITE = 'https://techtime-jp.com';
const url = `${SITE}/glossary/${t.slug}`;
const rel = (t.posts ?? []).map((x) => posts.find((p) => p.slug === x)!).filter(Boolean);
const see = (t.see ?? []).map(termBySlug).filter(Boolean);
const svc = t.service ? serviceBySlug(t.service) : null;
const title = `${t.word}とは：意味と、生成AIで変わること | TechTime`;
const ld = [
  { '@type': 'DefinedTerm', '@id': `${url}#term`, name: t.word, description: t.def, url, inDefinedTermSet: `${SITE}/glossary#set` },
];
---

<PageLayout
  title={title}
  description={t.def}
  crumbs={[{ name: '用語集', href: '/glossary' }, { name: t.word }]}
  tag={t.group}
  h1={[`${t.word}とは`]}
  lead={t.def}
  ld={ld}
>
  {t.body.length > 0 && (
    <section class="sec pg-near" data-st="くわしく">
      <div class="pg-grp rv">
        <h2>くわしく</h2>
        <div class="pg-prose">{t.body.map((b) => <p>{b}</p>)}</div>
      </div>
    </section>
  )}

  <section class:list={['sec', t.body.length === 0 && 'pg-near']} data-st="生成AIを使うと">
    <div class="pg-grp rv">
      <h2>生成AIを使うと</h2>
      <div class="pg-prose">
        <p>{t.ai}</p>
        {svc && <p><a href={`/services/${svc.slug}`}>{svc.name}のサービスのページ</a>で、AIが行うことと、人が決めることを説明しています。</p>}
      </div>
    </div>
  </section>

  {(rel.length > 0 || see.length > 0) && (
    <section class="sec" data-st="続き">
      <div class="pg-rel rv">
        {rel.length > 0 && (
          <div>
            <p class="kick">この言葉が出てくる記事</p>
            <ul>{rel.map((p) => <li><a href={`/blog/${p.slug}`}><small>{p.cat}</small>{p.title}</a></li>)}</ul>
          </div>
        )}
        {see.length > 0 && (
          <div>
            <p class="kick">関係する言葉</p>
            <ul class="pg-chips">{see.map((x) => <li><a href={`/glossary/${x!.slug}`}>{x!.word}</a></li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="sec" data-st="アセスメント">
    <div class="pg-nx rv">
      <h2>SAP の導入と運用保守に、AIチームを組み込みます。</h2>
      <div>
        <p>最初の一歩は、アセスメントです。プロジェクトの資料を全件読み、AIチームが効く工程を報告書にまとめます。</p>
        <div class="act">
          <a href="/assessment" class="btn">アセスメントの内容を見る<i></i></a>
          <a href="/services" class="more">サービスの一覧を見る</a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
