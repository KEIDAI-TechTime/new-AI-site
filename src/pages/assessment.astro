---
import DraftLayout from '@/layouts/DraftLayout.astro';

const title = 'SAP 導入の AI アセスメント | TechTime';
const description =
  'SAP 導入のプロジェクトの設計書・会議の記録・課題表を全件読み、生成AIが効く工程と、最初に手を打つ所を報告書にまとめます。期日に間に合う確率や、減る工数の見込みも、統計の方法で計算します。';
const SITE = 'https://techtime-jp.com';

const pages = [
  { n: '01', name: '結論', body: '報告書の最初に、3つの問いに答える。どこに AIチームが効くか。何から始めるか。何が変わるか。' },
  { n: '03', name: '読んだもの', body: '預かった資料の種類と量を示す。どの資料から何を読み取ったかも書く。' },
  { n: '07', name: '期日に間に合う確率', body: '未決の課題から、期日に間に合う確率を計算する。どの課題を先に決めればよいかが分かる。' },
  { n: '10', name: '指摘の偏り', body: '設計書を全件点検する。指摘が集中する領域と、指摘の種類を示す。' },
  { n: '12', name: '所見', body: '資料の抜粋を根拠に、起きていることと打ち手を書く。放置した場合の影響も書く。' },
  { n: '20', name: '減る工数の見込み', body: 'AIチームを組み込んだ場合の工数を、幅と前提を付けて示す。' },
];
const docs = [
  ['設計書・機能記述書と、その様式', '全件の点検、指摘の偏り'],
  ['業務フロー、要件一覧', '資料どうしの食い違い、手順と要件の結び付き'],
  ['会議の記録、チャット', '決定が資料に反映されているか、質問の集中'],
  ['課題表', '期日に間に合う確率、先に決める課題'],
  ['追加開発の見積もり', '工数のばらつき、減る工数の見込み'],
];
const reads = [
  ['AIが、預かった資料をすべて読む', '一部だけを読む方法では、結論が「たまたま読んだ資料」に左右されます。'],
  ['同じ資料を2回読ませ、結果を比べる', '2回の結果が違った箇所では、AIの結論を使いません。人が元の資料を読んで確認します。'],
  ['人が、結果の一部を元の資料と比べる', '人は、AIの読み取りの誤りの割合を測ります。測った割合は、報告書に書きます。'],
  ['プロジェクトのリーダーに、事実と違う所を確認する', '報告書は、リーダーの確認を経てから確定します。'],
];
const faqs = [
  ['導入の途中でも受けられますか。', 'はい。構想、要件定義、設計、テスト、稼働後の保守のどの段階でも受けられます。報告書は、いま進めている工程の進め方を中心に書きます。'],
  ['SAP 以外の基幹システムでも受けられますか。', 'はい。SAP 以外の基幹システムでも、読む資料の種類は同じです。SAP の標準機能との比較など、SAP に固有の分析は行いません。'],
  ['出せる資料が少ない場合はどうなりますか。', '出せる資料で行える解析をお伝えします。たとえば、設計書の様式と数本の設計書だけでも、点検の観点と指摘の偏りは示せます。'],
  ['期間と費用はどのくらいですか。', '預かる資料の量と、行う解析で決まります。ご相談のうえで、お見積もりします。'],
  ['預けた資料は、どのように扱われますか。', '秘密保持の取り決めを結んでからお預かりします。資料は、AIの学習に使われない設定で扱います。本番の環境には接続しません。'],
];
const ld = [
  {
    '@type': 'Service',
    '@id': `${SITE}/assessment#service`,
    name: 'SAP 導入の AI アセスメント',
    serviceType: '基幹システム導入のアセスメント',
    description,
    provider: { '@id': `${SITE}/#org` },
    areaServed: 'JP',
    url: `${SITE}/assessment`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'アセスメント', item: `${SITE}/assessment` },
    ],
  },
];
---

<DraftLayout title={title} description={description} og="assessment.jpg" ld={ld}>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="frame" aria-hidden="true"><span class="frame__tl">TECHTIME CO., LTD.</span><span class="frame__tr">ASSESSMENT</span></div>

  <header class="nav">
    <a href="/" class="nav__logo">TechTime<i></i></a>
    <nav class="nav__links">
      <a href="/blog">ブログ</a>
      <a href="/contact?topic=assess" class="nav__cta">アセスメントの相談はこちら<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
    </nav>
  </header>

  <main class="wrap">
    <section class="hero">
      <div>
        <nav class="crumb" aria-label="現在の位置"><a href="/">ホーム</a><i>/</i><span>アセスメント</span></nav>
        <p class="tag"><span>アセスメント</span>SAP 導入の AIチームの最初の一歩</p>
        <h1 class="h1">
          <span class="hl"><span>SAP 導入のプロジェクトを、</span></span>
          <span class="hl"><span>資料から診断する。</span></span>
        </h1>
        <p class="lead">設計書・会議の記録・課題表をお預かりし、全件を読みます。AIチームが効く工程と、最初に手を打つ所を、報告書にまとめます。</p>
        <ul class="pts">
          <li><b>全件を読む</b>一部だけではなく、預かった資料をすべて読む</li>
          <li><b>統計で測る</b>期日に間に合う確率と、減る工数の見込みを計算する</li>
          <li><b>根拠を並べる</b>所見ごとに、資料の抜粋を添える</li>
        </ul>
        <div class="act">
          <a href="/downloads/techtime-assessment-sample.pdf" download="TechTime_アセスメント結果報告書_サンプル.pdf" class="btn">報告書のサンプルをダウンロード<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
          <a href="/contact?topic=assess" class="link">アセスメントを相談する</a>
        </div>
        <p class="note">サンプルは PDF・29枚・約2MB で、架空の会社を題材にしています。ダウンロードに、お名前などの入力は要りません。</p>
      </div>
      <a class="deck" id="deck" href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" aria-label="アセスメント結果報告書のサンプルを開く">
        {pages.map((p, i) => <img src={`/images/assess/p${p.n}.jpg`} alt={`報告書のサンプルの「${p.name}」の頁`} width="1120" height="792" style={`--i:${i}`} />)}
      </a>
    </section>

    <section class="sec">
      <p class="tag"><span>01</span>受け取るもの</p>
      <h2 class="h2">報告書には、結論・数字・根拠・進め方を書く。</h2>
      <p class="sub">報告書は約30枚です。架空の会社を題材にしたサンプルから、6つの頁を示します。</p>
      <div class="gal">
        {pages.map((p) => (
          <figure>
            <a href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener"><img src={`/images/assess/p${p.n}.jpg`} alt={`報告書のサンプルの「${p.name}」の頁`} width="1120" height="792" loading="lazy" /></a>
            <figcaption><b>{p.name}</b>{p.body}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="sec">
      <p class="tag"><span>02</span>お預かりする資料</p>
      <h2 class="h2">預かる資料によって、行える解析が決まる。</h2>
      <p class="sub">すべての資料がそろわなくても構いません。出せる資料で行える解析を、最初のご相談でお伝えします。</p>
      <table class="tbl">
        <thead><tr><th>お預かりする資料</th><th>行える解析</th></tr></thead>
        <tbody>{docs.map(([a, b]) => <tr><th>{a}</th><td>{b}</td></tr>)}</tbody>
      </table>
    </section>

    <section class="sec">
      <p class="tag"><span>03</span>読み方</p>
      <h2 class="h2">AIが全件を読み、人が確認する。</h2>
      <p class="sub">AIの読み取りには誤りがあります。誤りを前提に、4つの段階で確認します。</p>
      <ol class="steps">
        {reads.map(([a, b], i) => <li><span>{String(i + 1).padStart(2, '0')}</span><div><b>{a}</b><p>{b}</p></div></li>)}
      </ol>
    </section>

    <section class="sec">
      <p class="tag"><span>04</span>進め方</p>
      <h2 class="h2">ご相談から報告まで、3つの段階で進める。</h2>
      <div class="flow">
        <div><span>01</span><b>ご相談と、お見積もり</b><p>いまの工程と、お預かりできる資料を伺います。行える解析をお伝えし、お見積もりします。</p></div>
        <div><span>02</span><b>資料を預かり、解析する</b><p>秘密保持の取り決めを結んでから、資料をお預かりします。AIが全件を読み、人が確認します。</p></div>
        <div class="on"><span>03</span><b>報告書をお渡しする</b><p>報告書をもとに、どの工程から AIチームを組み込むかを、一緒に決めます。</p></div>
      </div>
    </section>

    <section class="sec">
      <p class="tag"><span>05</span>よくある質問</p>
      <h2 class="h2">途中の工程からでも、資料が少なくても受けられる。</h2>
      <dl class="faq">
        {faqs.map(([q, a]) => <div><dt>{q}</dt><dd>{a}</dd></div>)}
      </dl>
    </section>

    <section class="cta">
      <h2>貴社の資料で、同じ分析を行います。</h2>
      <p>導入の検討中でも、途中でも、稼働したあとでも構いません。</p>
      <div class="act">
        <a href="/contact?topic=assess" class="btn btn--inv">アセスメントを相談する<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
        <a href="/downloads/techtime-assessment-sample.pdf" download="TechTime_アセスメント結果報告書_サンプル.pdf" class="link link--inv">報告書のサンプルをダウンロード</a>
      </div>
    </section>

    <section class="blog">
      <p class="tag"><span>ブログ</span>アセスメントで使う考え方</p>
      <ul>
        <li><a href="/blog/review-every-document">設計書は全件をレビューする。指摘が集中する所に、未決の課題がある</a></li>
        <li><a href="/blog/answer-with-probability">「間に合いますか」には確率で答える。先に解決すべき課題が分かる</a></li>
        <li><a href="/blog/measure-ai-without-counterfactual">AIの効果は「工数が何割減ったか」では測れない。記録に残る数字で、導入の前と後を比べる</a></li>
      </ul>
    </section>
  </main>

  <footer class="foot">
    <p class="foot__n">TechTime株式会社</p>
    <p>東京都渋谷区渋谷2-19-15 宮益坂ビルディング609</p>
    <p><a href="/blog">ブログ</a></p>
    <p class="foot__c">© TechTime Co., Ltd.</p>
  </footer>
</DraftLayout>

<style>
  .grid-bg { position: fixed; inset: 0; z-index: -1; background-image: linear-gradient(var(--hair) 1px, transparent 1px), linear-gradient(90deg, var(--hair) 1px, transparent 1px), linear-gradient(rgba(28, 27, 24, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(28, 27, 24, 0.035) 1px, transparent 1px); background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px; }
  .frame { position: fixed; inset: 10px; border: 1px solid var(--ink); pointer-events: none; z-index: 40; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em; color: var(--ink-2); }
  .frame span { position: absolute; top: -9px; background: var(--paper); padding: 2px 10px; line-height: 1.4; }
  .frame__tl { left: 22px; }
  .frame__tr { right: 22px; }
  .nav { position: fixed; top: 10px; left: 10px; right: 10px; z-index: 30; display: flex; justify-content: space-between; align-items: center; padding: 22px var(--gutter) 14px; background: linear-gradient(var(--paper) 60%, transparent); }
  .nav__logo { font-family: var(--mincho); font-weight: 800; font-size: 21px; display: flex; align-items: center; gap: 7px; }
  .nav__logo i { width: 8px; height: 8px; background: var(--shu); display: block; }
  .nav__links { display: flex; align-items: center; gap: clamp(14px, 2.4vw, 30px); font-size: 13.5px; font-weight: 500; }
  .nav__cta { display: flex; align-items: center; gap: 12px; background: var(--shu); color: var(--paper); font-weight: 700; padding: 10px 16px 10px 20px; box-shadow: 4px 4px 0 var(--ink); transition: box-shadow 0.25s, transform 0.25s; white-space: nowrap; }
  .nav__cta:hover { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }
  svg[viewBox='0 0 40 10'] { width: 30px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1.2; flex: none; transition: transform 0.35s; }

  .wrap { max-width: 1180px; margin: 0 auto; padding: 150px calc(var(--gutter) + 10px) 60px; }
  .crumb { display: flex; gap: 10px; margin: 0 0 22px; font-size: 12px; color: var(--ink-2); }
  .crumb a { border-bottom: 1px solid var(--line); }
  .crumb i { font-style: normal; color: var(--line); }
  .tag { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--ink-2); margin: 0 0 22px; display: flex; align-items: center; gap: 14px; }
  .tag span { color: var(--paper); background: var(--ink); padding: 1px 9px; font-family: var(--gothic); }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: clamp(30px, 5vw, 80px); align-items: center; padding-bottom: clamp(60px, 8vw, 110px); }
  .h1 { font-family: var(--mincho); font-weight: 800; font-size: clamp(25px, 3.25vw, 46px); line-height: 1.4; margin: 0 0 22px; white-space: nowrap; }
  .hl { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hl > span { display: inline-block; transform: translateY(108%); animation: rise 1.1s cubic-bezier(0.16, 0.9, 0.2, 1) forwards; }
  .hl:nth-child(2) > span { animation-delay: 0.16s; }
  @keyframes rise { to { transform: none; } }
  @keyframes up { from { opacity: 0; transform: translateY(22px); } }
  .lead { margin: 0 0 26px; color: var(--ink-2); max-width: 560px; animation: up 0.9s 0.4s both; }
  .pts { list-style: none; margin: 0 0 30px; padding: 0; border-top: 1px solid var(--ink); animation: up 0.9s 0.5s both; }
  .pts li { display: grid; grid-template-columns: 7.5em 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14.5px; color: var(--ink-2); align-items: baseline; }
  .pts b { font-family: var(--mincho); font-size: 16px; color: var(--ink); }
  .act { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; animation: up 0.9s 0.6s both; }
  .btn { display: inline-flex; align-items: center; gap: 18px; background: var(--shu); color: var(--paper); padding: 15px 22px 15px 28px; font-weight: 700; font-size: 15px; letter-spacing: 0.04em; position: relative; overflow: hidden; isolation: isolate; }
  .btn::before { content: ''; position: absolute; inset: 0; background: var(--ink); transform: translateX(-101%); transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: -1; }
  .btn:hover::before { transform: none; }
  .btn:hover svg { transform: translateX(6px); }
  .link { font-size: 14px; font-weight: 500; border-bottom: 1px solid var(--ink); padding-bottom: 2px; }
  .note { margin: 14px 0 0; font-size: 12.5px; color: var(--ink-2); }
  .deck { position: relative; display: block; aspect-ratio: 1120 / 860; margin: 10px 56px 40px 0; animation: up 1s 0.4s both; }
  .deck img { position: absolute; inset: 0; width: 100%; height: auto; border: 1px solid var(--ink); background: var(--paper); box-shadow: 0 8px 26px rgba(28, 27, 24, 0.16);
    transform: translate(calc(var(--i) * 12px), calc(var(--i) * 9px)) rotate(calc(var(--i) * 0.5deg)); z-index: calc(10 - var(--i)); opacity: calc(1 - var(--i) * 0.07); transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.9s; }
  .deck img.out { transform: translate(-46%, -6%) rotate(-7deg); opacity: 0; transition: transform 0.6s cubic-bezier(0.6, 0, 0.9, 0.4), opacity 0.5s 0.1s; }

  .sec { padding: clamp(60px, 8vw, 110px) 0; border-top: 1px solid var(--ink); }
  .h2 { font-family: var(--mincho); font-weight: 800; font-size: clamp(23px, 3vw, 38px); line-height: 1.45; margin: 0 0 14px; }
  .sub { margin: 0 0 34px; color: var(--ink-2); max-width: 680px; }
  .gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .gal figure { margin: 0; }
  .gal img { display: block; width: 100%; height: auto; border: 1px solid var(--ink); background: var(--paper); transition: transform 0.35s, box-shadow 0.35s; }
  .gal a:hover img { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ink); }
  .gal figcaption { margin-top: 10px; font-size: 13.5px; line-height: 1.75; color: var(--ink-2); }
  .gal figcaption b { display: block; font-family: var(--mincho); font-size: 16.5px; color: var(--ink); }
  .tbl { width: 100%; border-collapse: collapse; background: var(--paper); font-size: 15px; }
  .tbl th, .tbl td { border: 1px solid var(--ink); padding: 13px 18px; text-align: left; line-height: 1.7; }
  .tbl thead th { background: var(--ink); color: var(--paper); font-size: 13px; }
  .tbl tbody th { background: var(--paper-2); width: 40%; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--ink); background: var(--paper); }
  .steps li { padding: 20px 20px 22px; border-right: 1px solid var(--ink); display: grid; gap: 10px; align-content: start; }
  .steps li:last-child { border-right: 0; }
  .steps span { font-family: var(--mono); font-size: 26px; color: var(--shu); line-height: 1; }
  .steps b { font-family: var(--mincho); font-size: 17px; line-height: 1.55; display: block; }
  .steps p { margin: 6px 0 0; font-size: 13.5px; line-height: 1.8; color: var(--ink-2); }
  .flow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--ink); background: var(--paper); }
  .flow div { padding: 22px 24px 24px; border-right: 1px solid var(--ink); position: relative; }
  .flow div:last-child { border-right: 0; }
  .flow div.on { background: var(--ink); color: var(--paper); }
  .flow span { font-family: var(--mono); font-size: 13px; color: var(--shu); }
  .flow b { display: block; font-family: var(--mincho); font-size: 19px; margin: 4px 0 8px; }
  .flow p { margin: 0; font-size: 14px; line-height: 1.85; color: var(--ink-2); }
  .flow .on p { color: #c9c4b6; }
  .faq { margin: 0; border-top: 1px solid var(--ink); }
  .faq div { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .faq dt { font-family: var(--mincho); font-weight: 700; font-size: 17px; line-height: 1.6; }
  .faq dt::before { content: 'Q'; font-family: var(--mono); color: var(--shu); margin-right: 12px; }
  .faq dd { margin: 0; font-size: 15px; line-height: 1.9; color: var(--ink-2); }
  .cta { margin: clamp(30px, 4vw, 60px) calc(-1 * clamp(0px, 3vw, 40px)) 0; background: var(--ink); color: var(--paper); padding: clamp(32px, 5vw, 64px); }
  .cta h2 { margin: 0 0 12px; font-family: var(--mincho); font-weight: 800; font-size: clamp(24px, 3.4vw, 40px); line-height: 1.45; }
  .cta > p { margin: 0 0 28px; color: #c9c4b6; }
  .btn--inv::before { background: var(--paper); }
  .btn--inv:hover { color: var(--ink); }
  .link--inv { border-color: var(--paper); }
  .blog { padding: clamp(60px, 7vw, 90px) 0 20px; }
  .blog ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .blog li a { display: block; padding: 16px 0; border-bottom: 1px solid var(--line); font-family: var(--mincho); font-weight: 700; font-size: 17px; line-height: 1.6; transition: padding 0.3s, color 0.3s; }
  .blog li a:hover { padding-left: 10px; color: var(--shu); }
  .foot { margin: 0 calc(var(--gutter) + 10px) 40px; border-top: 1px solid var(--ink); padding-top: 20px; font-size: 12.5px; color: var(--ink-2); display: flex; gap: 8px 30px; flex-wrap: wrap; align-items: baseline; }
  .foot p { margin: 0; }
  .foot__n { font-weight: 700; color: var(--ink); }
  .foot__c { margin-left: auto !important; font-family: var(--mono); font-size: 10.5px; }

  @media (max-width: 900px) {
    .wrap { padding-top: 120px; }
    .nav__links > a:not(.nav__cta) { display: none; }
    .nav__cta { font-size: 12px; padding: 8px 12px; box-shadow: 3px 3px 0 var(--ink); }
    .nav__cta svg { display: none; }
    .hero { grid-template-columns: 1fr; }
    .h1 { white-space: normal; }
    .deck { margin-right: 44px; }
    .pts li { grid-template-columns: 1fr; gap: 0; }
    .gal { grid-template-columns: 1fr 1fr; gap: 16px; }
    .steps, .flow { grid-template-columns: 1fr; }
    .steps li, .flow div { border-right: 0; border-bottom: 1px solid var(--ink); }
    .steps li:last-child, .flow div:last-child { border-bottom: 0; }
    .tbl { font-size: 13.5px; }
    .tbl th, .tbl td { padding: 10px 12px; }
    .faq div { grid-template-columns: 1fr; gap: 6px; }
    .cta { margin-inline: -8px; }
    .foot__c { margin-left: 0 !important; }
  }
  @media (max-width: 520px) { .gal { grid-template-columns: 1fr; } }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('#deck');
  if (deck) {
    const imgs = [...deck.querySelectorAll<HTMLImageElement>('img')];
    let busy = false;
    setInterval(() => {
      if (busy || document.hidden || deck.matches(':hover')) return;
      busy = true;
      const top = imgs.find((im) => im.style.getPropertyValue('--i') === '0')!;
      top.classList.add('out');
      setTimeout(() => {
        imgs.forEach((im) => { const i = Number(im.style.getPropertyValue('--i')); im.style.setProperty('--i', String(i === 0 ? imgs.length - 1 : i - 1)); });
        top.classList.remove('out'); busy = false;
      }, 650);
    }, 3200);
  }
</script>
