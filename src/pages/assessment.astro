  .as-flow div::before { content: counter(f); display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--key); color: var(--ink); font: 600 16px var(--num); }
  .as-flow div + div::after { content: ''; position: absolute; left: -23px; top: 50%; width: 9px; height: 9px; margin-top: -5px; border-top: 3px solid var(--ink); border-right: 3px solid var(--ink); transform: rotate(45deg); animation: as-nudge 1.8s ease-in-out infinite; }
  @keyframes as-nudge { 0%, 100% { transform: translateX(-3px) rotate(45deg); } 50% { transform: translateX(3px) rotate(45deg); } }
