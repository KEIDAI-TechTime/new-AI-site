---
/* アセスメント */
import NextLayout from '@/layouts/NextLayout.astro';

const title = 'SAP 導入の AI アセスメント | TechTime';
const description =
  'SAP 導入のプロジェクトの設計書・会議の記録・課題表を全件読み、生成AIが効く工程と、最初に手を打つ所を報告書にまとめます。期日に間に合う確率や、減る工数の見込みも、統計の方法で計算します。';
const SITE = 'https://techtime-jp.com';

const pages = [
  { n: '01', name: '結論', body: '報告書の最初に、3つの問いに答える。どこに AIチームが効くか。何から始めるか。何が変わるか。' },
  { n: '03', name: '読んだもの', body: '預かった資料の種類と量を示す。どの資料から何を読み取ったかも書く。' },
  { n: '07', name: '期日に間に合う確率', body: '未決の課題から、期日に間に合う確率を計算する。どの課題を先に決めればよいかが分かる。' },
  { n: '10', name: '指摘の偏り', body: '設計書を全件点検する。指摘が集中する領域と、指摘の種類を示す。' },
  { n: '12', name: '所見', body: '資料の抜粋を根拠に、起きていることと打ち手を書く。放置した場合の影響も書く。' },
  { n: '20', name: '減る工数の見込み', body: 'AIチームを組み込んだ場合の工数を、幅と前提を付けて示す。' },
];
const docs = [
  ['設計書・機能記述書と、その様式', '全件の点検、指摘の偏り'],
  ['業務フロー、要件一覧', '資料どうしの食い違い、手順と要件の結び付き'],
  ['会議の記録、チャット', '決定が資料に反映されているか、質問の集中'],
  ['課題表', '期日に間に合う確率、先に決める課題'],
  ['追加開発の見積もり', '工数のばらつき、減る工数の見込み'],
];
const reads = [
  ['AIが、預かった資料をすべて読む', '一部だけを読む方法では、結論が「たまたま読んだ資料」に左右されます。'],
  ['同じ資料を2回読ませ、結果を比べる', '2回の結果が違った箇所では、AIの結論を使いません。人が元の資料を読んで確認します。'],
  ['人が、結果の一部を元の資料と比べる', '人は、AIの読み取りの誤りの割合を測ります。測った割合は、報告書に書きます。'],
  ['プロジェクトのリーダーに、事実と違う所を確認する', '報告書は、リーダーの確認を経てから確定します。'],
];
const faqs = [
  ['導入の途中でも受けられますか。', 'はい。構想、要件定義、設計、テスト、稼働後の保守のどの段階でも受けられます。報告書は、いま進めている工程の進め方を中心に書きます。'],
  ['SAP 以外の基幹システムでも受けられますか。', 'はい。SAP 以外の基幹システムでも、読む資料の種類は同じです。SAP の標準機能との比較など、SAP に固有の分析は行いません。'],
  ['出せる資料が少ない場合はどうなりますか。', '出せる資料で行える解析をお伝えします。たとえば、設計書の様式と数本の設計書だけでも、点検の観点と指摘の偏りは示せます。'],
  ['期間と費用はどのくらいですか。', '預かる資料の量と、行う解析で決まります。ご相談のうえで、お見積もりします。'],
  ['預けた資料は、どのように扱われますか。', '秘密保持の取り決めを結んでからお預かりします。資料は、AIの学習に使われない設定で扱います。本番の環境には接続しません。'],
];
const ld = [
  {
    '@type': 'Service',
    '@id': `${SITE}/assessment#service`,
    name: 'SAP 導入の AI アセスメント',
    serviceType: '基幹システム導入のアセスメント',
    description,
    provider: { '@id': `${SITE}/#org` },
    areaServed: 'JP',
    url: `${SITE}/assessment`,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'アセスメント', item: `${SITE}/assessment` },
    ],
  },
];
---

<NextLayout noEnd title={title} description={description} cur="assessment" og="assessment.jpg" ld={ld}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="as-tone" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="1.256 -0.518 0.369 0 -0.024  0.759 -0.021 0.369 0 -0.024  -0.391 1.129 0.369 0 -0.024  0 0 0 1 0" /></filter></svg>

  <section class="hero" data-st="アセスメント">
    <div class="hero__top">
      <div>
        <nav class="kick as-kick" aria-label="現在の位置"><span><a href="/">ホーム</a>／<span>アセスメント</span></span></nav>
        <h1 class="as-h1">SAP 導入のプロジェクトを、<br />資料から診断する。</h1>
      </div>
      <div class="hero__side">
        <p class="as-first"><span>アセスメント</span>SAP 導入の AIチームの最初の一歩</p>
        <p>設計書・会議の記録・課題表をお預かりし、全件を読みます。AIチームが効く工程と、最初に手を打つ所を、報告書にまとめます。</p>
        <div class="act">
          <a href="/downloads/techtime-assessment-sample.pdf" download="TechTime_アセスメント結果報告書_サンプル.pdf" class="btn">報告書のサンプルをダウンロード<i></i></a>
          <a href="/contact?topic=assess" class="btn btn--sub">アセスメントを相談する</a>
        </div>
        <p class="note">サンプルは PDF・29枚・約2MB で、架空の会社を題材にしています。ダウンロードに、お名前などの入力は要りません。</p>
      </div>
    </div>

    <div class="as-top">
      <div class="as-stage">
        <a class="as-deck" id="deck" href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" aria-label="アセスメント結果報告書のサンプルを開く">
          {pages.map((p, i) => <img src={`/images/assess/p${p.n}.webp`} alt={`報告書のサンプルの「${p.name}」の頁`} width="1120" height="792" style={`--i:${i}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />)}
        </a>
      </div>
      <ul class="as-pts">
        <li>
          <svg viewBox="0 0 120 44" aria-hidden="true">{Array.from({ length: 30 }, (_, i) => <rect class="t" x={(i % 10) * 12} y={Math.floor(i / 10) * 15} width="9" height="12" rx="2" style={`--i:${i}`} />)}</svg>
          <b>全件を読む</b>一部だけではなく、預かった資料をすべて読む
        </li>
        <li>
          <svg viewBox="0 0 120 44" aria-hidden="true">{[8, 16, 28, 40, 34, 22, 14, 8, 5].map((h, i) => <rect class:list={['h', i > 4 && 'late']} x={i * 13} y={44 - h} width="10" height={h} rx="2" style={`--i:${i}`} />)}<path class="dl" d="M63.5 0v44" /></svg>
          <b>統計で測る</b>期日に間に合う確率と、減る工数の見込みを計算する
        </li>
        <li>
          <svg viewBox="0 0 120 44" aria-hidden="true"><rect class="q" x="0" y="2" width="52" height="40" rx="5" /><path class="ql" d="M9 13h34M9 22h34M9 31h20" /><rect class="q q--k" x="68" y="2" width="52" height="40" rx="5" /><path class="ql ql--k" d="M77 13h34M77 22h34M77 31h20" /><path class="qa" d="M54 22h12" /></svg>
          <b>根拠を並べる</b>所見ごとに、資料の抜粋を添える
        </li>
      </ul>
    </div>
  </section>

  <section class="sec" data-st="受け取るもの">
    <div class="head rv">
      <p class="kick">受け取るもの</p>
      <h2>報告書には、結論・数字・<br />根拠・進め方を書く。</h2>
      <p class="head__p">報告書は約30枚です。架空の会社を題材にしたサンプルから、6つの頁を示します。</p>
    </div>
    <div class="as-gal">
      {pages.map((p, i) => (
        <figure class="rv" style={`transition-delay:${(i % 3) * 80}ms`}>
          <a href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener"><img src={`/images/assess/p${p.n}.webp`} alt={`報告書のサンプルの「${p.name}」の頁`} width="1120" height="792" loading="lazy" /></a>
          <figcaption><b>{p.name}</b>{p.body}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="sec" data-st="預かる資料">
    <div class="head rv">
      <p class="kick">お預かりする資料</p>
      <h2>預かる資料によって、<br />行える解析が決まる。</h2>
      <p class="head__p">すべての資料がそろわなくても構いません。出せる資料で行える解析を、最初のご相談でお伝えします。</p>
    </div>
    <table class="as-doc rv">
      <thead><tr><th>お預かりする資料</th><th>行える解析</th></tr></thead>
      <tbody>{docs.map(([a, b], i) => <tr style={`--i:${i}`}><th>{a}</th><td>{b}</td></tr>)}</tbody>
    </table>
  </section>

  <section class="sec" data-st="読み方">
    <div class="head rv">
      <p class="kick">読み方</p>
      <h2>AIが全件を読み、<br />人が確認する。</h2>
      <p class="head__p">AIの読み取りには誤りがあります。誤りを前提に、4つの段階で確認します。</p>
    </div>
    <ol class="as-read rv">
      {reads.map(([a, b], i) => (
        <li>
          <svg viewBox="0 0 168 60" aria-hidden="true" class={`as-ic as-ic--${i + 1}`}>
            {i === 0 && Array.from({ length: 42 }, (_, k) => <rect class="t" x={(k % 14) * 12} y={Math.floor(k / 14) * 21} width="9" height="16" rx="2" style={`--i:${k}`} />)}
            {i === 1 && [0, 1].map((r) => Array.from({ length: 14 }, (_, k) => <rect class:list={['t', r === 1 && k === 9 && 'x']} x={k * 12} y={6 + r * 30} width="9" height="16" rx="2" />))}
            {i === 2 && Array.from({ length: 42 }, (_, k) => <rect class:list={['t', [4, 17, 23, 36].includes(k) && 'p']} x={(k % 14) * 12} y={Math.floor(k / 14) * 21} width="9" height="16" rx="2" />)}
            {i === 3 && <><rect class="pg" x="0" y="2" width="96" height="56" rx="6" /><path class="ln" d="M12 16h72M12 28h72M12 40h44" /><circle class="ok" cx="136" cy="30" r="22" /><path class="ck" d="M126 30l7 8 13-16" /></>}
          </svg>
          <b>{a}</b>
          <p>{b}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec" data-st="進め方">
    <div class="head rv">
      <p class="kick">進め方</p>
      <h2>ご相談から報告まで、<br />3つの段階で進める。</h2>
    </div>
    <div class="as-flow rv">
      <div><b>ご相談と、お見積もり</b><p>いまの工程と、お預かりできる資料を伺います。行える解析をお伝えし、お見積もりします。</p></div>
      <div><b>資料を預かり、解析する</b><p>秘密保持の取り決めを結んでから、資料をお預かりします。AIが全件を読み、人が確認します。</p></div>
      <div class="on"><b>報告書をお渡しする</b><p>報告書をもとに、どの工程から AIチームを組み込むかを、一緒に決めます。</p></div>
    </div>
  </section>

  <section class="sec" data-st="質問">
    <div class="head rv">
      <p class="kick">よくある質問</p>
      <h2>途中の工程からでも、<br />資料が少なくても受けられる。</h2>
    </div>
    <dl class="as-qa rv">
      {faqs.map(([q, a]) => <div><dt>{q}</dt><dd>{a}</dd></div>)}
    </dl>
  </section>

  <section class="sec" data-st="同じ分析">
    <div class="as-cta rv">
      <div>
        <h2>貴社の資料で、同じ分析を行います。</h2>
        <p>導入の検討中でも、途中でも、稼働したあとでも構いません。</p>
      </div>
      <div class="act">
        <a href="/contact?topic=assess" class="btn">アセスメントを相談する<i></i></a>
        <a href="/downloads/techtime-assessment-sample.pdf" download="TechTime_アセスメント結果報告書_サンプル.pdf" class="btn btn--sub">報告書のサンプルをダウンロード</a>
      </div>
    </div>
    <div class="as-blog rv">
      <p class="kick">ブログ／アセスメントで使う考え方</p>
      <ul>
        <li><a href="/blog/review-every-document">設計書は全件をレビューする。指摘が集中する所に、未決の課題がある</a></li>
        <li><a href="/blog/answer-with-probability">「間に合いますか」には確率で答える。先に解決すべき課題が分かる</a></li>
        <li><a href="/blog/measure-ai-without-counterfactual">AIの効果は「工数が何割減ったか」では測れない。記録に残る数字で、導入の前と後を比べる</a></li>
      </ul>
    </div>
  </section>
</NextLayout>

<style is:global>
  @keyframes as-up { from { opacity: 0; transform: translateY(18px); } }
  .as-h1 { font-size: clamp(29px, 3vw, 44px); }
  .as-kick a { text-decoration: underline; text-underline-offset: 4px; }
  .as-first { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-bottom: 10px; font-size: 14px !important; font-weight: 700 !important; }
  .as-first span { padding: 0 12px; border-radius: 99px; background: var(--tint); font-size: 12.5px; line-height: 2; }

  /* 頭の図：報告書の頁が、自分でめくれて繰り返す */
  .as-top { display: grid; grid-template-columns: 1.55fr 1fr; gap: 14px; margin-top: clamp(22px, 3.2vw, 44px); }
  .as-stage { padding: clamp(18px, 3vw, 44px) clamp(18px, 3vw, 44px) clamp(10px, 2vw, 26px); border-radius: var(--r); background: var(--card); animation: as-up 0.9s 0.1s both; }
  .as-deck { position: relative; display: block; aspect-ratio: 1120 / 860; margin-right: 60px; }
  .as-deck img { position: absolute; inset: 0; width: 100%; height: auto; border-radius: 10px; background: var(--card); filter: url(#as-tone); box-shadow: 0 10px 28px -12px rgba(17, 23, 26, 0.4);
    transform: translate(calc(var(--i) * 12px), calc(var(--i) * 9px)) rotate(calc(var(--i) * 0.5deg)); z-index: calc(10 - var(--i)); opacity: calc(1 - var(--i) * 0.07); transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.9s; }
  .as-deck img.out { transform: translate(-46%, -6%) rotate(-7deg); opacity: 0; transition: transform 0.6s cubic-bezier(0.6, 0, 0.9, 0.4), opacity 0.5s 0.1s; }
  .as-pts { display: grid; gap: 14px; }
  .as-pts li { display: flex; flex-direction: column; justify-content: center; padding: 20px 26px; border-radius: var(--r); background: var(--tint); font-size: 14px; animation: as-up 0.8s both; }
  .as-pts li:nth-child(1) { animation-delay: 0.2s; }
  .as-pts li:nth-child(2) { animation-delay: 0.3s; }
  .as-pts li:nth-child(3) { animation-delay: 0.4s; }
  .as-pts b { display: block; margin-top: 12px; font-size: clamp(19px, 1.9vw, 25px); font-weight: 900; line-height: 1.5; }
  .as-pts svg { display: block; width: 120px; height: 44px; overflow: visible; }
  .as-pts .t { fill: var(--key); animation: as-read 6s linear infinite; animation-delay: calc(var(--i) * 90ms); }
  @keyframes as-read { 0%, 3% { fill: var(--ink); } 9%, 100% { fill: var(--key); } }
  .as-pts .h { fill: var(--ink); transform-box: fill-box; transform-origin: 50% 100%; animation: as-grow 6s ease-in-out infinite; animation-delay: calc(var(--i) * 70ms); }
  .as-pts .h.late { fill: var(--key); }
  @keyframes as-grow { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.82); } }
  .as-pts .dl { fill: none; stroke: var(--ink); stroke-width: 2; stroke-dasharray: 3 3; }
  .as-pts .q { fill: var(--card); }
  .as-pts .q--k { fill: var(--key); }
  .as-pts .ql { fill: none; stroke: #8a8f94; stroke-width: 3; stroke-linecap: round; }
  .as-pts .ql--k { stroke: var(--ink); stroke-dasharray: 90; animation: as-write 6s ease-in-out infinite; }
  @keyframes as-write { 0% { stroke-dashoffset: 90; } 30%, 100% { stroke-dashoffset: 0; } }
  .as-pts .qa { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linecap: round; }

  /* 受け取るもの */
  .as-gal { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: clamp(22px, 3.2vw, 44px); }
  .as-gal figure { display: flex; flex-direction: column; border-radius: var(--r); background: var(--card); overflow: hidden; }
  .as-gal a { display: block; padding: 14px 14px 0; }
  .as-gal img { display: block; width: 100%; height: auto; border-radius: 8px; background: var(--card); filter: url(#as-tone); box-shadow: 0 6px 18px -10px rgba(17, 23, 26, 0.4); transition: transform 0.35s; }
  .as-gal a:hover img { transform: translateY(-4px) scale(1.01); }
  .as-gal figcaption { padding: 16px 24px 22px; font-size: 14px; color: var(--mute); }
  .as-gal figcaption b { display: block; font-size: clamp(17px, 1.6vw, 20px); font-weight: 900; color: var(--ink); }

  /* 預かる資料 → 行える解析 */
  .as-doc { display: block; margin-top: clamp(22px, 3.2vw, 44px); }
  .as-doc thead, .as-doc tbody { display: block; }
  .as-doc tr { position: relative; display: grid; grid-template-columns: 1fr 1.25fr; gap: 56px; }
  .as-doc thead th { padding: 0 24px 4px; text-align: left; font-size: 12px; font-weight: 700; color: var(--mute); }
  .as-doc tbody tr { margin-top: 8px; }
  .as-doc tbody th, .as-doc tbody td { padding: 16px 24px; border-radius: 12px; text-align: left; font-size: 15px; }
  .as-doc tbody th { background: var(--card); font-size: 16px; font-weight: 900; }
  .as-doc tbody td { background: var(--tint); font-weight: 700; box-shadow: inset 5px 0 0 var(--key); }
  .as-doc tbody tr::before { content: ''; position: absolute; top: 50%; left: calc((100% - 56px) / 2.25 + 8px); width: 40px; height: 3px; margin-top: -1.5px; border-radius: 2px; background: repeating-linear-gradient(90deg, var(--rule) 0 6px, transparent 6px 10px); }
  .as-doc tbody tr::after { content: ''; position: absolute; top: 50%; left: calc((100% - 56px) / 2.25 + 8px); width: 10px; height: 10px; margin-top: -5px; border-radius: 50%; background: var(--key); animation: as-pass 3s linear infinite; animation-delay: calc(var(--i) * 0.45s); }
  @keyframes as-pass { 0% { transform: translateX(0); opacity: 0; } 15% { opacity: 1; } 60% { transform: translateX(30px); opacity: 1; } 75%, 100% { transform: translateX(30px); opacity: 0; } }

  /* 読み方 */
  .as-read { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: clamp(22px, 3.2vw, 44px); counter-reset: s; }
  .as-read li { position: relative; padding: 24px 24px 26px; border-radius: var(--r); background: var(--card); counter-increment: s; }
  .as-read li::before { content: counter(s); display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--key); color: var(--ink); font: 600 16px var(--num); }
  .as-read li + li::after { content: ''; position: absolute; left: -14px; top: 38px; width: 14px; height: 2px; background: var(--key); }
  .as-ic { display: block; width: 100%; max-width: 168px; height: auto; margin: 18px 0 16px; overflow: visible; }
  .as-ic .t { fill: #c9cdcb; }
  .as-ic--1 .t { fill: var(--key); animation: as-read 7s linear infinite; animation-delay: calc(var(--i) * 70ms); }
  .as-ic--2 .t { fill: var(--key); }
  .as-ic--2 .t.x { fill: var(--miss); animation: as-blink 2.4s ease-in-out infinite; }
  @keyframes as-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  .as-ic--3 .t.p { fill: var(--ink); transform-box: fill-box; transform-origin: center; animation: as-pick 3.2s ease-in-out infinite; }
  @keyframes as-pick { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.35); } }
  .as-ic .pg { fill: var(--tint); }
  .as-ic .ln { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; }
  .as-ic .ok { fill: var(--key); }
  .as-ic .ck { fill: none; stroke: var(--ink); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 34; animation: as-check 4s ease-in-out infinite; }
