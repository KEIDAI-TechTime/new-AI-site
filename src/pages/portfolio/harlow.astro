    bgColor: '#FFE5E5',
    image: 'https://readdy.ai/api/search-image?query=Fresh%20strawberry%20ice%20cream%20cone%20with%20real%20strawberry%20pieces%2C%20vibrant%20pink%20color%2C%20handmade%20artisan%20quality%2C%20served%20in%20golden%20waffle%20cone%2C%20simple%20clean%20background%20in%20soft%20pink%20color%2C%201950s%20American%20parlor%20style%2C%20delicious%20and%20inviting&width=400&height=400&seq=flavor-strawberry-001&orientation=squarish',
