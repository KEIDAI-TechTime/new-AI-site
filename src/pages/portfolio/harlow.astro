---
// Harlow Ice Cream LP - Portfolio Demo
// 1950年代アメリカンダイナーをコンセプトにしたハンドメイドアイスクリーム店のLP

const flavorsData = [
  {
    name: 'バニラビーン',
    price: '450',
    bgColor: '#FFF8E7',
    image: 'https://readdy.ai/api/search-image?query=Delicious%20vanilla%20bean%20ice%20cream%20cone%20with%20visible%20vanilla%20bean%20specks%2C%20handmade%20artisan%20style%2C%20creamy%20white%20color%2C%20served%20in%20golden%20waffle%20cone%2C%20simple%20clean%20background%20in%20soft%20cream%20color%2C%201950s%20American%20ice%20cream%20parlor%20aesthetic%2C%20appetizing%20presentation&width=400&height=400&seq=flavor-vanilla-001&orientation=squarish',
