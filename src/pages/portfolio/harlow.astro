const shopsData = [
  {
    name: '神戸本店',
    address: '〒650-0041 神戸市中央区新港町17-3 W102',
    hours: '9:00-17:00',
    brunchHours: '朝食・ブランチ 9:00-14:00',
    closed: '定休日：火曜・金曜',
    phone: 'TEL: 078-585-5388',
    feature: '海沿い、みなとのもり公園・メリケンパークから徒歩圏内',
    image: 'https://readdy.ai/api/search-image?query=Charming%20handmade%20ice%20cream%20shop%20exterior%20by%20the%20seaside%20in%20Kobe%20Japan%2C%20vintage%201950s%20American%20diner%20style%20storefront%20with%20large%20windows%2C%20retro%20mint%20green%20and%20coral%20pink%20signage%2C%20wooden%20details%2C%20welcoming%20entrance%2C%20ocean%20view%20in%20background%2C%20bright%20daylight%2C%20nostalgic%20yet%20modern%20aesthetic&width=600&height=400&seq=kobe-exterior-001&orientation=landscape'
  },
  {
    name: '東京店',
    address: '〒150-0012 東京都渋谷区広尾3-2-12',
    hours: '12:00-18:00',
    brunchHours: '',
    closed: '定休日：火曜・金曜',
    phone: 'TEL: 050-1143-7179',
    feature: '広尾の閑静な住宅街',
    image: 'https://readdy.ai/api/search-image?query=Sophisticated%20handmade%20ice%20cream%20shop%20in%20quiet%20residential%20Hiroo%20Tokyo%20neighborhood%2C%20elegant%20storefront%20with%20vintage%20American%20parlor%20touches%2C%20modern%20minimalist%20exterior%20with%20retro%20elements%2C%20large%20glass%20windows%2C%20soft%20afternoon%20light%2C%20peaceful%20urban%20setting%2C%20refined%20and%20inviting%20atmosphere&width=600&height=400&seq=tokyo-exterior-001&orientation=landscape'
  }
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Harlow Ice Cream | ハンドメイドアイスクリーム</title>
  <meta name="description" content="神戸と東京にあるハンドメイドアイスクリーム店 Harlow。すべて店内で手作り、自家製コーン。1950年代アメリカンパーラーの楽しさと温かみを現代に。" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Pacifico&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Remix Icon -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.0.0/fonts/remixicon.css" rel="stylesheet" />

  <style>
    /* Base styles */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Noto Sans JP', sans-serif;
      background-color: #F4E4D4;
      color: #3D3D3D;
      overflow-x: hidden;
    }

    /* Animations */
    @keyframes bounce-slow {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    @keyframes wave {
      0%, 100% { transform: rotate(-1deg); }
      50% { transform: rotate(1deg); }
    }

    @keyframes bounce-horizontal {
      0%, 100% { transform: translateX(0); }
      50% { transform: translateX(10px); }
    }

    @keyframes neon-flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }

    .animate-bounce-slow {
      animation: bounce-slow 3s ease-in-out infinite;
    }

    .animate-wave {
      animation: wave 2s ease-in-out infinite;
    }

    .animate-bounce-horizontal {
      animation: bounce-horizontal 1s ease-in-out infinite;
    }

    /* 3D Card Flip */
    .perspective-1000 {
      perspective: 1000px;
    }

    .transform-style-3d {
      transform-style: preserve-3d;
    }

    .backface-hidden {
      backface-visibility: hidden;
    }

    .rotate-y-180 {
      transform: rotateY(180deg);
    }

    .duration-600 {
      transition-duration: 600ms;
    }

    /* Back to TechTime button */
    .back-to-techtime {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 1000;
      background: rgba(61, 61, 61, 0.9);
      color: white;
      padding: 12px 20px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: bold;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
    }

    .back-to-techtime:hover {
      background: #5B8C7B;
      transform: translateY(-2px);
    }

    /* Demo badge */
    .demo-badge {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 1000;
      background: linear-gradient(135deg, #E8927C, #F2C94C);
      color: white;
      padding: 8px 16px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <!-- Back to TechTime -->
  <a href="/web-design" class="back-to-techtime">
    <i class="ri-arrow-left-line"></i>
    TechTime 制作実績に戻る
  </a>

  <!-- Demo Badge -->
  <div class="demo-badge">
    <i class="ri-palette-line"></i> Portfolio Demo
  </div>

  <div class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative min-h-screen overflow-hidden bg-gradient-to-br from-[#F4E4D4] via-[#F2C94C]/20 to-[#F4E4D4]">
      <!-- Diagonal Stripe Pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, #F2C94C 0px, #F2C94C 40px, transparent 40px, transparent 80px);"></div>
      </div>

      <!-- Floating Decorations -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <i class="ri-cake-3-line absolute top-20 left-10 text-6xl text-[#5B8C7B] opacity-5"></i>
        <i class="ri-goblet-line absolute top-40 right-20 text-5xl text-[#E8927C] opacity-5"></i>
        <i class="ri-cake-2-line absolute bottom-40 left-20 text-7xl text-[#F2C94C] opacity-5"></i>
        <i class="ri-goblet-fill absolute bottom-20 right-40 text-6xl text-[#5B8C7B] opacity-5"></i>
      </div>

      <!-- Corner Stamps -->
      <div class="absolute top-8 left-8 w-24 h-24 rounded-full border-4 border-[#5B8C7B] border-dashed flex items-center justify-center bg-white/50 rotate-12 shadow-lg hidden md:flex">
        <span class="text-xs font-bold text-[#5B8C7B] text-center leading-tight">FRESH<br/>DAILY</span>
      </div>
      <div class="absolute top-8 right-8 w-24 h-24 rounded-full border-4 border-[#E8927C] border-dashed flex items-center justify-center bg-white/50 -rotate-12 shadow-lg hidden md:flex">
        <span class="text-xs font-bold text-[#E8927C] text-center leading-tight">HAND<br/>MADE</span>
      </div>

      <!-- Navigation -->
      <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <img src="https://public.readdy.ai/ai/img_res/56ad3c3e-1c5a-4e78-923f-f830a384e9cd.png" alt="Harlow" class="w-10 h-10 object-contain" />
            <span class="text-2xl font-black text-[#5B8C7B]" style="font-family: 'Bebas Neue', sans-serif;">HARLOW</span>
          </div>
          <div class="hidden md:flex items-center gap-8">
            <a href="#flavors" class="text-sm font-semibold text-[#3D3D3D] hover:text-[#5B8C7B] transition-colors">FLAVORS</a>
            <a href="#story" class="text-sm font-semibold text-[#3D3D3D] hover:text-[#5B8C7B] transition-colors">STORY</a>
            <a href="#shops" class="text-sm font-semibold text-[#3D3D3D] hover:text-[#5B8C7B] transition-colors">SHOPS</a>
            <a href="#online" class="text-sm font-semibold text-[#3D3D3D] hover:text-[#5B8C7B] transition-colors">ONLINE</a>
          </div>
        </div>
      </nav>

      <!-- Main Content -->
      <div class="relative z-10 flex flex-col items-center justify-center min-h-screen px-4 pt-32 pb-20">
        <!-- Logo Image -->
        <div class="mb-8 animate-bounce-slow">
          <img
            src="https://public.readdy.ai/ai/img_res/56ad3c3e-1c5a-4e78-923f-f830a384e9cd.png"
            alt="Harlow Ice Cream Logo"
            class="w-32 h-32 object-contain drop-shadow-2xl"
          />
        </div>

        <!-- Neon Sign Logo -->
        <div class="flex items-center justify-center gap-2 mb-6" id="neon-sign">
          {['H', 'A', 'R', 'L', 'O', 'W'].map((letter, index) => (
            <span
              class="neon-letter text-6xl sm:text-8xl md:text-9xl font-black text-[#5B8C7B] opacity-0 scale-50 transition-all duration-500"
              style={`font-family: 'Bebas Neue', sans-serif; text-shadow: 0 0 10px rgba(255,255,255,0.8), 0 0 20px rgba(232,146,124,0.6), 0 0 30px rgba(232,146,124,0.4), 2px 2px 0 white, -2px -2px 0 white; transition-delay: ${index * 200}ms;`}
            >
              {letter}
            </span>
          ))}
        </div>

        <!-- Subtitle -->
        <div class="flex items-center gap-3 mb-8">
          <i class="ri-cake-3-line text-2xl text-[#E8927C]"></i>
          <div class="bg-[#F2C94C] px-6 py-2 rounded-full">
            <span class="text-[#3D3D3D] font-bold tracking-widest text-sm">ICE CREAM PARLOR</span>
          </div>
          <i class="ri-cake-3-line text-2xl text-[#E8927C]"></i>
        </div>

        <!-- Ribbon Banner -->
        <div class="relative animate-wave">
          <div
            class="bg-gradient-to-r from-[#E8927C] via-white to-[#E8927C] px-8 sm:px-12 py-4 shadow-2xl transform -rotate-1"
            style="background-image: repeating-linear-gradient(45deg, #E8927C 0px, #E8927C 10px, white 10px, white 20px);"
          >
            <span class="text-white font-bold tracking-wider text-sm sm:text-lg drop-shadow-lg" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">
              HANDMADE WITH LOVE SINCE 2017
            </span>
          </div>
          <div class="absolute -left-6 top-0 w-0 h-0 border-t-[28px] border-t-transparent border-r-[24px] border-r-[#E8927C] border-b-[28px] border-b-transparent"></div>
          <div class="absolute -right-6 top-0 w-0 h-0 border-t-[28px] border-t-transparent border-l-[24px] border-l-[#E8927C] border-b-[28px] border-b-transparent"></div>
        </div>

        <!-- Scroll Indicator -->
        <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce">
          <i class="ri-arrow-down-line text-3xl text-[#5B8C7B]"></i>
        </div>
      </div>
    </section>

    <!-- Flavors Section -->
    <section id="flavors" class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-16">
          <div class="relative inline-block">
            <i class="ri-vip-crown-line text-3xl text-[#F2C94C] absolute -top-8 left-1/2 transform -translate-x-1/2"></i>
            <h2 class="text-5xl md:text-7xl font-black text-[#5B8C7B] mb-4" style="font-family: 'Bebas Neue', sans-serif;">
              OUR FLAVORS
            </h2>
          </div>
          <p class="text-xl text-[#E8927C] mt-4" style="font-family: 'Pacifico', cursive;">
            Made fresh daily in our kitchen
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {flavorsData.map((flavor, index) => (
            <div class="flavor-card relative h-96 cursor-pointer perspective-1000" data-index={index}>
              <div class="card-inner relative w-full h-full transition-transform duration-600 transform-style-3d">
                <!-- Front Side -->
                <div
                  class="card-front absolute inset-0 rounded-3xl border-4 border-white shadow-xl backface-hidden flex flex-col items-center justify-center p-6"
                  style={`background-color: ${flavor.bgColor}; box-shadow: 0 0 0 2px #3D3D3D;`}
                >
                  <div class="relative mb-6">
                    <img src={flavor.image} alt={flavor.name} class="w-48 h-48 object-contain drop-shadow-2xl" />
                    <i class="ri-sparkling-line absolute -top-2 -right-2 text-2xl text-[#F2C94C] animate-pulse"></i>
                    <i class="ri-sparkling-line absolute -bottom-2 -left-2 text-xl text-[#E8927C] animate-pulse"></i>
                  </div>
                  <h3 class="text-3xl font-black text-[#3D3D3D] mb-2 text-center" style="font-family: 'Bebas Neue', sans-serif;">
                    {flavor.name}
                  </h3>
                  <p class="text-2xl font-bold text-[#5B8C7B] mb-4">¥{flavor.price}</p>
                  <div class="w-24 h-1 bg-[#E8927C] rounded-full"></div>
                  <p class="text-xs text-[#3D3D3D]/60 mt-4">クリックで詳細を見る</p>
                </div>

                <!-- Back Side -->
                <div
                  class="card-back absolute inset-0 rounded-3xl border-4 border-white shadow-xl backface-hidden rotate-y-180 flex flex-col items-center justify-center p-8"
                  style={`background-color: ${flavor.bgColor}; box-shadow: 0 0 0 2px #3D3D3D;`}
                >
                  <div class="absolute inset-0 opacity-10 rounded-3xl" style="background-image: radial-gradient(circle, #3D3D3D 1px, transparent 1px); background-size: 20px 20px;"></div>
                  <div class="relative z-10 text-center">
                    <h3 class="text-2xl font-black text-[#3D3D3D] mb-4" style="font-family: 'Bebas Neue', sans-serif;">
                      {flavor.name}
                    </h3>
                    <p class="text-sm text-[#3D3D3D] leading-relaxed mb-6">{flavor.description}</p>
                    <button class="bg-white text-[#3D3D3D] px-8 py-3 rounded-full font-bold text-sm border-4 border-[#E8927C] hover:bg-[#E8927C] hover:text-white transition-all duration-300">
                      TRY ME!
                    </button>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section id="story" class="py-24 bg-gradient-to-b from-white to-[#F4E4D4]/30">
      <div class="max-w-7xl mx-auto px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
          <div class="lg:col-span-2 relative">
            <div class="bg-[#F2C94C]/20 p-8 lg:p-12 rounded-3xl relative">
              <div class="absolute -top-4 -left-4 bg-[#E8927C] text-white px-4 py-2 rounded-full transform -rotate-12 shadow-lg">
                <span class="text-xs font-bold">EST. 2017</span>
              </div>

              <div class="mb-8">
                <h2 class="text-4xl lg:text-5xl text-[#5B8C7B] mb-2" style="font-family: 'Pacifico', cursive;">Our</h2>
                <h2 class="text-6xl lg:text-7xl font-black text-[#3D3D3D]" style="font-family: 'Bebas Neue', sans-serif;">Story</h2>
                <i class="ri-heart-3-fill text-3xl text-[#E8927C] ml-4"></i>
              </div>

              <div class="space-y-6 text-[#3D3D3D]">
                <div class="flex gap-3">
                  <i class="ri-cake-3-line text-xl text-[#5B8C7B] flex-shrink-0 mt-1"></i>
                  <p class="leading-relaxed text-sm">
                    2017年、神戸の海沿いに小さなアイスクリームショップをオープンしました。すべてのフレーバーを店内で手作りし、コーンまで自家製にこだわっています。
                  </p>
                </div>
                <div class="flex gap-3">
                  <i class="ri-cake-3-line text-xl text-[#5B8C7B] flex-shrink-0 mt-1"></i>
                  <p class="leading-relaxed text-sm">
                    私たちのアイスクリームは、1950年代のアメリカンパーラーの楽しさと温かみを現代に蘇らせます。
                  </p>
                </div>
                <div class="flex gap-3">
                  <i class="ri-cake-3-line text-xl text-[#5B8C7B] flex-shrink-0 mt-1"></i>
                  <p class="leading-relaxed text-sm">
                    Beyond Coffee RoastersのコーヒーとSMITH TEAの紅茶と共に、特別なひとときをお楽しみください。
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-3 relative h-[500px] lg:h-[600px]">
            <!-- Stats -->
            <div class="absolute top-0 right-0 z-20 flex gap-4 lg:gap-8">
              <div class="text-right">
                <div class="w-16 h-16 lg:w-24 lg:h-24 rounded-full bg-[#F2C94C] flex items-center justify-center mb-2 shadow-xl">
                  <span class="text-3xl lg:text-5xl font-black text-[#3D3D3D]">2</span>
                </div>
                <span class="text-xs font-semibold text-[#3D3D3D]">LOCATIONS</span>
              </div>
              <div class="text-right">
                <div class="w-16 h-16 lg:w-24 lg:h-24 rounded-full bg-[#F2C94C] flex items-center justify-center mb-2 shadow-xl">
                  <span class="text-2xl lg:text-4xl font-black text-[#3D3D3D]">7+</span>
                </div>
