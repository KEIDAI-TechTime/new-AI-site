---
/* 工程ごとのページ */
import NextLayout from '../../layouts/NextLayout.astro';
import FigMotion from '../../components/next/FigMotion.astro';
import { services } from '../../data/services';
import { copy } from '../../data/koteiCopy';
import { posts } from '../../data/posts';
import { termBySlug } from '../../data/glossary';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const c = copy[s.slug];
const SITE = 'https://techtime-jp.com';
const url = `${SITE}/services/${s.slug}`;
const ld = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: `SAP 導入の${s.name}に、生成AIのチームを組み込むサービス`,
    serviceType: `SAP ${s.name}の支援`,
    description: s.description,
    provider: { '@id': `${SITE}/#org` },
    areaServed: 'JP',
    url,
  },
  {
    '@type': 'FAQPage',
    mainEntity: s.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];

const rel = s.posts.map((x) => posts.find((p) => p.slug === x)!).filter(Boolean);
const tms = s.terms.map(termBySlug).filter(Boolean);
const i = services.findIndex((x) => x.slug === s.slug);
---

<NextLayout title={s.title} description={s.description} cur="kotei" ld={ld} ask={`いまの${s.name}の進め方を、聞かせてください。`}>
  <section class="hero" data-st={s.name}>
    <div class="hero__top">
      <div>
        <p class="kick"><a href="/services">工程</a>／{s.name}</p>
        <h1>{c.h1[0]}<br />{c.h1[1]}</h1>
      </div>
      <div class="hero__side">
        <p>{s.lead}</p>
        <div class="act">
          <a href={`/contact?from=${s.slug}`} class="btn">{s.name}の進め方を相談する<i></i></a>
        </div>
      </div>
    </div>
    <FigMotion slug={s.slug} />
    <ol class="rail" aria-label="工程">
      {services.map((x, j) => <li class:list={[j === i && 'on', j < i && 'past']}><a href={`/services/${x.slug}`}>{x.name}</a></li>)}
    </ol>
  </section>

  <section class="sec sec--near" data-st="要点">
    <ul class="pts rv">{s.pts.map(([a, b]) => <li><b>{a}</b>{b}</li>)}</ul>
  </section>

  <section class="sec" data-st="起きていること">
    <div class="head rv">
      <p class="kick">{s.name}で起きていること</p>
      <h2>次のことに、<br />心当たりはありませんか。</h2>
    </div>
    <div class="pain rv">{s.pains.map(([a, b]) => <div><b>{a}</b><p>{b}</p></div>)}</div>
  </section>

  <section class="sec" data-st="分担">
    <div class="head rv">
      <p class="kick">分担</p>
      <h2>AIチームがすること、<br />人が決めること。</h2>
      <p class="head__p">作業ごとに、AIチームと人の分担を決めます。業務の内容と合否は、人が決めます。</p>
    </div>
    <div class="role rv">
      <p class="role__h"><span>作業</span><span>AIチームがすること</span><span>人が決めること</span></p>
      {s.roles.map(([a, b, d]) => <p class="role__r"><b>{a}</b><span class="ai">{b}</span><span class="man">{d}</span></p>)}
    </div>
  </section>

  <section class="sec" data-st="組み込み方">
    <div class="head rv">
      <p class="kick">組み込み方と、残るもの</p>
      <h2>小さく試してから、<br />広げる。</h2>
      <p class="head__p">お客様の様式と規約に合わせて手順を作ります。手順と記録は、お客様の側に残ります。</p>
    </div>
    <div class="two rv">
      <ol class="stp">{s.steps.map(([a, b]) => <li><b>{a}</b><p>{b}</p></li>)}</ol>
      <ul class="get">
        <li class="get__h">プロジェクトに残るもの</li>
        {s.gets.map(([a, b]) => <li><b>{a}</b><p>{b}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="sec" data-st="質問">
    <div class="head rv">
      <p class="kick">よくある質問</p>
      <h2>{s.name}について、<br />よくいただく質問。</h2>
    </div>
    <dl class="qa rv">{s.faqs.map(([q, a]) => <div><dt>{q}</dt><dd>{a}</dd></div>)}</dl>
  </section>

  <section class="sec" data-st="続き">
    <div class="rel rv">
      <div>
        <p class="kick">{s.name}の進め方を、詳しく読む</p>
        <ul>{rel.map((p) => <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>)}</ul>
      </div>
      <div>
        <p class="kick">関係する言葉</p>
        <ul class="rel__t">{tms.map((t) => <li><a href={`/glossary/${t!.slug}`}>{t!.word}</a></li>)}</ul>
        <p class="kick" style="margin-top:26px">最初の一歩</p>
        <p class="rel__a">貴社の資料を読み、{s.name}でどれだけ効くかを報告書にします。<br /><a href="/assessment" class="more">アセスメントを見る</a></p>
      </div>
    </div>
  </section>
</NextLayout>

<style is:global>
  .kick a { text-decoration: underline; text-underline-offset: 4px; }
  .rail { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-top: clamp(22px, 3.2vw, 44px); }
  .rail a { display: block; padding: 7px 4px; border-radius: 99px; background: var(--card); text-align: center; font-size: 13px; font-weight: 700; color: var(--mute); transition: background 0.2s, color 0.2s; }
  .rail a:hover { background: var(--tint); color: var(--ink); }
  .rail .on a { background: var(--ink); color: #fff; }
  .sec--near { padding-top: clamp(40px, 5vw, 72px); }
  .pts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 14px; }
  .pts li { padding: 18px 22px; border-radius: var(--r); background: var(--tint); font-size: 14px; }
  .pts b { display: block; font-size: 17px; font-weight: 900; }
  .pain { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: clamp(22px, 3.2vw, 44px); }
  .pain div { padding: 24px 26px; border-radius: var(--r); background: var(--card); box-shadow: inset 0 5px 0 var(--miss); }
  .pain b { display: block; font-size: clamp(16px, 1.5vw, 19px); font-weight: 900; line-height: 1.6; }
  .pain p { margin-top: 10px; font-size: 14px; color: var(--mute); }
  .role { margin-top: clamp(22px, 3.2vw, 44px); }
  .role__h, .role__r { display: grid; grid-template-columns: 0.9fr 1.6fr 1.3fr; gap: 8px; }
  .role__h { padding: 0 0 4px; font-size: 12px; font-weight: 700; color: var(--mute); }
  .role__h span { padding: 0 20px; }
  .role__r { margin-top: 8px; }
  .role__r > * { padding: 16px 20px; border-radius: 12px; background: var(--card); font-size: 14.5px; }
  .role__r b { font-size: 16px; font-weight: 900; }
  .role__r .ai { box-shadow: inset 5px 0 0 var(--ai); }
  .role__r .man { background: var(--tint); box-shadow: inset 5px 0 0 var(--ink); font-weight: 700; }
  .two { display: grid; grid-template-columns: 1.3fr 1fr; gap: 18px; margin-top: clamp(22px, 3.2vw, 44px); }
  .stp { display: grid; gap: 8px; counter-reset: s; }
  .stp li { display: grid; grid-template-columns: 44px 1fr; align-items: start; padding: 16px 22px; border-radius: 12px; background: var(--card); counter-increment: s; }
  .stp li::before { content: counter(s); grid-row: 1 / span 2; display: grid; place-items: center; width: 30px; height: 30px; margin-top: 2px; border-radius: 50%; background: var(--ai); color: var(--ink); font: 600 16px var(--num); }
  .stp b { font-size: 16px; font-weight: 900; }
  .stp p { grid-column: 2; font-size: 14px; color: var(--mute); }
  .get { padding: 22px 26px; border-radius: var(--r); background: var(--ink); color: #fff; }
  .get__h { font-size: 13px; font-weight: 700; opacity: 0.85; }
  .get li + li { margin-top: 14px; }
  .get b { font-size: 16.5px; font-weight: 900; }
  .get p { font-size: 13.5px; opacity: 0.92; }
  .qa { display: grid; gap: 8px; margin-top: clamp(22px, 3.2vw, 44px); }
  .qa div { display: grid; grid-template-columns: 1fr 1.3fr; gap: 24px; padding: 20px 26px; border-radius: 12px; background: var(--card); }
  .qa dt { font-weight: 900; font-size: 16px; }
  .qa dd { font-size: 14.5px; }
  .rel { display: grid; grid-template-columns: 1.3fr 1fr; gap: 18px 40px; }
  .rel ul { margin-top: 10px; }
  .rel li a { display: block; padding: 12px 0; border-bottom: 1px solid var(--rule); font-weight: 700; transition: color 0.2s, padding 0.25s; }
  .rel li a:hover { padding-left: 8px; box-shadow: inset 0 -3px 0 var(--key); }
  .rel__t { display: flex; flex-wrap: wrap; gap: 6px; }
  .rel__t li a { padding: 3px 14px; border: 0; border-radius: 99px; background: var(--card); font-size: 13px; }
  .rel__t li a:hover { padding-left: 14px; background: var(--ink); color: #fff; box-shadow: none; }
  .rel__a { margin-top: 8px; font-size: 14.5px; }
  @media (max-width: 900px) {
    .rail { grid-template-columns: repeat(7, auto); overflow-x: auto; }
    .rail a { padding: 7px 14px; white-space: nowrap; }
    .pts, .pain, .two, .rel { grid-template-columns: 1fr; }
    .role__h { display: none; }
    .role__r { grid-template-columns: 1fr; gap: 4px; margin-top: 16px; }
    .qa div { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
