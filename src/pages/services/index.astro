---
import PageLayout from '@/layouts/PageLayout.astro';
import { services } from '@/data/services';
const SITE = 'https://techtime-jp.com';
const title = 'サービス：SAP の導入と運用保守に、生成AIのチームを組み込む | TechTime';
const description =
  'TechTime のサービスの一覧です。SAP の導入と運用保守の工程ごとに、生成AIのチームを組み込みます。要件定義・設計・開発・テスト・移行・運用保守・プロジェクト管理の7つのページで、AIが行うことと人が決めることを説明します。';
const ld = [
  {
    '@type': 'ItemList',
    name: 'TechTime のサービス',
    itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE}/services/${s.slug}` })),
  },
];
const diffs = [
  ['提供するもの', '人の作業時間', '手順と点検の観点。プロジェクトに残る'],
  ['確かめる範囲', '一部を選んで確かめる', 'AIが全件を確かめ、人が判断する'],
  ['担当が替わったとき', '出来が変わる', '同じ手順で、同じ形の成果物が出る'],
  ['稼働したあと', '導入のメンバーが離れ、経緯が分からなくなる', '導入の記録を、保守でそのまま使う'],
];
---

<PageLayout title={title} description={description} mark="SERVICES" crumbs={[{ name: 'サービス' }]} ld={ld}>
  <section class="top">
    <p class="tag"><span>サービス</span>SAP の導入と運用保守</p>
    <h1 class="h1">
      <span class="hl"><span>工程ごとに、</span></span>
      <span class="hl"><span><em>AIチーム</em>を組み込む。</span></span>
    </h1>
    <p class="lead">設計、開発、テスト、点検、進捗管理を受け持つAIを、SAP の導入と運用保守のプロジェクトに組み込みます。お客様の様式と規約に合わせて手順を作り、手順はお客様のものとして残します。</p>
    <div class="act">
      <a href="/assessment" class="btn">最初の一歩：アセスメント<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
      <a href="/check" class="link">10問で自己診断する</a>
    </div>
  </section>

  <section class="sec">
    <p class="tag"><span>01</span>工程から選ぶ</p>
    <h2 class="h2">いま進めている工程から始められる。</h2>
    <p class="sub">導入の途中でも、稼働したあとでも始められます。工程ごとに、AIが行うことと、人が決めることを説明します。</p>
    <div class="cards">
      {services.map((s, i) => (
        <a class="card" href={`/services/${s.slug}`}>
          <span>{String(i + 1).padStart(2, '0')}</span>
          <b>{s.name}</b>
          <p>{s.h1.join('')}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="sec">
    <p class="tag"><span>02</span>工数の提供との違い</p>
    <h2 class="h2">人の作業時間ではなく、仕組みを提供する。</h2>
    <p class="sub">人を増やす方法では、その人が離れると作業が止まります。TechTime は、手順と点検の観点を作り、プロジェクトに残します。支援会社を比べるときに聞く質問は、<a href="/blog/choose-sap-partner-by-what-remains">ブログの記事</a>にまとめています。</p>
    <table class="tbl">
      <thead><tr><th></th><th>工数の提供</th><th>仕組みの提供（TechTime）</th></tr></thead>
      <tbody>{diffs.map(([a, b, c]) => <tr><th>{a}</th><td>{b}</td><td>{c}</td></tr>)}</tbody>
    </table>
  </section>

  <section class="sec">
    <p class="tag"><span>03</span>守ること</p>
    <h2 class="h2">決めるのは人。AIには決めさせない。</h2>
    <div class="cards">
      <div><span>01</span><b>結果は人が確かめて決める</b><p>AIは、材料と下書きを作ります。業務の内容と合否は、人が決めます。</p></div>
      <div><span>02</span><b>本番環境では、AIに操作させない</b><p>AIが画面を操作するのは、検証環境だけです。</p></div>
      <div><span>03</span><b>情報を、AIの学習に使わせない</b><p>お客様の情報は、AIの学習に使われない設定で扱います。</p></div>
    </div>
  </section>

  <section class="cta">
    <h2>どの工程から始めるかを、資料から決めます。</h2>
    <p>アセスメントでは、設計書・会議の記録・課題表を全件読み、AIチームが効く工程を報告書にまとめます。</p>
    <div class="act">
      <a href="/contact?topic=assess" class="btn btn--inv">アセスメントを相談する<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
      <a href="/process" class="link link--inv">進め方とお見積もりを見る</a>
    </div>
  </section>
</PageLayout>
