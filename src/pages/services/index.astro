---
/* 工程の一覧 */
import NextLayout from '../../layouts/NextLayout.astro';
import { services } from '../../data/services';
const does: Record<string, [string, string, string]> = {
  requirements: ['会議の記録から決定と宿題を取り出し、番号を付けて一覧に載せる', '番号の付いた決定の一覧', '一つの決定を、会議から保守まで追う'],
  design: ['設計書の初版を作り、全件を同じ観点で点検する', '設計書と、点検の記録', '214本の設計書を読み、指摘だけを渡す'],
  development: ['設計書から、プログラムと単体テストの初版を作る', 'プログラムと、元の設計との対応', '設計書の一行と、プログラムの一行を結ぶ'],
  test: ['テストケースを作り、検証環境で実施して証跡を残す', 'ケース・結果・証跡', 'NG に、原因の仮説を付けて渡す'],
  migration: ['移行データを全件で突き合わせ、合わない件を理由ごとに分ける', '対応表と、照合の結果', '360件を照合し、合わない件だけを分ける'],
  operations: ['導入時の記録から、経緯と影響範囲を調べる', '問い合わせと対応の記録', '問い合わせから、決定までさかのぼる'],
  'project-management': ['記録から課題とリスクを取り出し、完了の見込みを毎朝出す', '課題の一覧と、見込みの推移', '毎朝の見込みを、幅で並べる'],
};
const title = '工程ごとに、AIチームがすること | TechTime';
const description = 'SAP 導入の要件定義・設計・開発・テスト・移行・運用保守・プロジェクト管理。どの工程にも、担当するAIチームがいます。工程ごとに、AIチームがすることと、プロジェクトに残るものを並べました。';
---

<NextLayout title={title} description={description} cur="kotei">
  <section class="hero" data-st="工程">
    <div class="hero__top">
      <div>
        <p class="kick">工程</p>
        <h1>どの工程にも、<br />担当するAIチームがいる。</h1>
      </div>
      <div class="hero__side">
        <p>要件定義から運用保守まで、工程ごとにAIチームを組み込みます。その工程ですることを、それぞれのページで図にしました。困っている工程から見てください。</p>
      </div>
    </div>
    <div class="kl">
      <p class="kl__h"><span>工程</span><span>AIチームがすること</span><span>プロジェクトに残るもの</span><span>このページの図</span></p>
      {services.map((s, i) => (
        <a href={`/services/${s.slug}`} class="kl__r rv" style={`transition-delay:${i * 50}ms`}>
          <b>{s.name}</b>
          <span>{does[s.slug][0]}</span>
          <span class="kl__l">{does[s.slug][1]}</span>
          <span class="more">{does[s.slug][2]}</span>
        </a>
      ))}
    </div>
  </section>
</NextLayout>

<style is:global>
  .kl { margin-top: clamp(22px, 3.2vw, 44px); }
  .kl__h, .kl__r { display: grid; grid-template-columns: 1.1fr 2fr 1.2fr 1.5fr; gap: 22px; align-items: center; }
  .kl__h { padding: 0 26px 6px; font-size: 12px; font-weight: 700; color: var(--mute); }
  .kl__r { margin-top: 8px; padding: 20px 26px; border-radius: var(--r); background: var(--card); font-size: 14.5px; transition: opacity 0.8s, transform 0.5s, background 0.25s, color 0.25s; }
  .kl__r b { font-size: clamp(18px, 1.6vw, 22px); font-weight: 900; white-space: nowrap; }
  .kl__l { color: var(--mute); }
  .kl__r .more { font-size: 13.5px; justify-content: space-between; }
  .kl__r:hover { background: var(--ink); color: #fff; }
  .kl__r:hover .kl__l { color: #c9cdd0; }
  .kl__r:hover .more { color: #fff; }
  @media (max-width: 900px) {
    .kl__h { display: none; }
    .kl__r { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
