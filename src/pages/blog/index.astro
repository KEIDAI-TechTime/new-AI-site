---
import DraftLayout from '@/layouts/DraftLayout.astro';
import { posts, catOrder } from '@/data/posts';

const title = 'ブログ | TechTime';
const description = 'SAP 導入の困りごとを、AIでどう解決するか。要件定義からテスト、運用保守まで、工程ごとに、明日から試せる手順を書きます。';
const sorted = [...posts].sort((a, b) => Number(b.no) - Number(a.no));
const cats = catOrder.filter((c) => posts.some((p) => p.cat === c));
const count = (c: string) => posts.filter((p) => p.cat === c).length;
const SITE = 'https://techtime-jp.com';
const ld = [{
  '@type': 'Blog', '@id': `${SITE}/blog#blog`, name: 'TechTime ブログ', url: `${SITE}/blog`, inLanguage: 'ja', publisher: { '@id': `${SITE}/#org` },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: `${SITE}/blog/${p.slug}`, datePublished: p.date.replace(/\./g, '-'), image: `${SITE}/images/blog/${p.slug}.jpg` })),
}];
---

<DraftLayout title={title} description={description} og="blog.jpg" ld={ld}>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="frame" aria-hidden="true"><span class="frame__tl">TECHTIME CO., LTD.</span><span class="frame__tr">BLOG</span></div>

  <header class="nav">
    <a href="/" class="nav__logo">TechTime<i></i></a>
    <nav class="nav__links">
      <a href="/services" class="nav__page">サービス</a>
      <a href="/assessment" class="nav__page">アセスメント</a>
      <a href="/contact?topic=assess" class="nav__cta">アセスメントの相談はこちら</a>
    </nav>
  </header>

  <main class="wrap">
    <div class="head">
      <p class="tag"><span>ブログ</span>導入と保守の現場から</p>
      <h1 class="h1">SAP 導入の困りごとを、<br /><em>AI</em>でどう解決するか。</h1>
      <p class="lead">要件定義からテスト、運用保守まで。工程ごとに、明日から試せる手順を書きます。</p>
    </div>

    <!-- 探し方：1行の帯にまとめる -->
    <div class="bar" role="search">
      <div class="chips" role="group" aria-label="工程で絞り込む">
        <button type="button" class="chip is-on" data-cat="">すべて<span>{posts.length}</span></button>
        {cats.map((c) => <button type="button" class="chip" data-cat={c}>{c}<span>{count(c)}</span></button>)}
      </div>
      <div class="tools">
        <label class="q"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" /><path d="M13 13l5 5" /></svg><input type="search" id="q" placeholder="言葉で探す" autocomplete="off" aria-label="言葉で探す" /></label>
        <select id="sort" aria-label="並び順"><option value="new">新しい順</option><option value="phase">工程の順</option></select>
      </div>
    </div>
    <p class="hit"><b id="hit">{posts.length}</b> 本<button type="button" id="clear" hidden>絞り込みを解除</button></p>

    <ol class="cards" id="list">
      {sorted.map((p, i) => (
        <li class="card" style={`--d:${Math.min(i, 8) * 0.06}s`} data-cat={p.cat} data-no={p.no} data-order={catOrder.indexOf(p.cat)} data-text={[p.title, p.dek, p.problem, p.cat, ...p.words].join(' ').toLowerCase()}>
          <a href={`/blog/${p.slug}`}>
            <div class="card__img">
              <img src={`/images/blog/${p.slug}.webp`} alt={`記事「${p.short}」の図`} loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
              <span class="card__no">{p.no}</span>
            </div>
            <div class="card__body">
              <p class="card__meta"><b>{p.cat}</b><em>読む時間 約{p.min}分</em></p>
              <h2 class="card__t">{p.title}</h2>
              <p class="card__p"><span>こんな困りごとに</span>{p.problem}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
    <p class="none" id="none" hidden>当てはまる記事がありません。言葉を変えるか、絞り込みを解除してください。</p>

    <aside class="cta">
      <div>
        <p class="cta__k">貴社のプロジェクトの状況を、資料から確認します</p>
        <h2>記事で書いた分析を、貴社の資料で行います。</h2>
      </div>
      <div class="cta__act">
        <a href="/assessment" class="btn">アセスメントの内容を見る</a>
        <a href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" class="link">報告書のサンプル（PDF）</a>
      </div>
    </aside>
  </main>

  <footer class="foot">
    <p class="foot__n">TechTime株式会社</p>
    <p>東京都渋谷区渋谷2-19-15 宮益坂ビルディング609</p>
    <p><a href="/">ホーム</a></p>
    <p><a href="/services">サービス</a></p>
    <p><a href="/assessment">アセスメント</a></p>
    <p><a href="/blog">ブログ</a></p>
    <p><a href="/glossary">用語集</a></p>
    <p><a href="/resources">資料とひな形</a></p>
    <p><a href="/faq">よくある質問</a></p>
    <p><a href="/company">会社概要</a></p>
    <p class="foot__c">© TechTime Co., Ltd.</p>
  </footer>
</DraftLayout>

<style>
  .grid-bg { position: fixed; inset: 0; z-index: -1; background-image: linear-gradient(var(--hair) 1px, transparent 1px), linear-gradient(90deg, var(--hair) 1px, transparent 1px), linear-gradient(rgba(28, 27, 24, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(28, 27, 24, 0.035) 1px, transparent 1px); background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px; }
  .frame { position: fixed; inset: 10px; border: 1px solid var(--ink); pointer-events: none; z-index: 40; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em; color: var(--ink-2); }
  .frame span { position: absolute; top: -9px; background: var(--paper); padding: 2px 10px; line-height: 1.4; }
  .frame__tl { left: 22px; }
  .frame__tr { right: 22px; }
  .nav { position: fixed; top: 10px; left: 10px; right: 10px; z-index: 30; display: flex; justify-content: space-between; align-items: center; padding: 22px var(--gutter) 14px; background: linear-gradient(var(--paper) 60%, transparent); }
  .nav__logo { font-family: var(--mincho); font-weight: 800; font-size: 21px; display: flex; align-items: center; gap: 7px; }
  .nav__logo i { width: 8px; height: 8px; background: var(--shu); display: block; }
  .nav__links { display: flex; align-items: center; gap: 22px; }
  .nav__page { font-size: 13.5px; font-weight: 700; white-space: nowrap; }
  .nav__cta { background: var(--shu); color: var(--paper); font-weight: 700; font-size: 13.5px; padding: 9px 18px; box-shadow: 4px 4px 0 var(--ink); transition: box-shadow 0.25s, transform 0.25s; white-space: nowrap; }
  .nav__cta:hover { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }

  .wrap { max-width: 1240px; margin: 0 auto; padding: 128px calc(var(--gutter) + 10px) 80px; }
  .head { display: grid; grid-template-columns: auto 1fr; gap: 6px 48px; align-items: end; margin-bottom: 30px; }
  .tag { grid-column: 1 / -1; font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--ink-2); margin: 0; display: flex; align-items: center; gap: 14px; }
  .tag span { color: var(--paper); background: var(--ink); padding: 1px 9px; font-family: var(--gothic); }
  .h1 { font-family: var(--mincho); font-weight: 800; font-size: clamp(25px, 3.1vw, 40px); line-height: 1.4; margin: 0; }
  .h1 em { font-style: normal; color: var(--shu); }
  .lead { margin: 0 0 6px; color: var(--ink-2); font-size: 14.5px; max-width: 460px; justify-self: end; }
  @keyframes up { from { opacity: 0; transform: translateY(18px); } }

  /* 探し方の帯 */
  .bar { position: sticky; top: 84px; z-index: 20; display: flex; gap: 10px 14px; align-items: center; justify-content: space-between; flex-wrap: nowrap; padding: 8px 10px; border: 1px solid var(--ink); background: rgba(242, 238, 228, 0.94); backdrop-filter: blur(6px); }
  .chips { flex: 1 1 auto; display: flex; gap: 5px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; min-width: 0; }
  .chips::-webkit-scrollbar { display: none; }
  .chips.more { -webkit-mask-image: linear-gradient(to right, #000 85%, transparent); mask-image: linear-gradient(to right, #000 85%, transparent); }
  .chip { flex: none; font: inherit; font-size: 12.5px; font-weight: 700; color: var(--ink); background: var(--paper); border: 1px solid var(--line); padding: 6px 9px; cursor: pointer; display: flex; align-items: baseline; gap: 6px; white-space: nowrap; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .chip span { font-family: var(--mono); font-weight: 500; font-size: 11px; color: var(--shu); }
  .chip:hover { border-color: var(--ink); }
  .chip.is-on { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chip.is-on span { color: #ff8a70; }
  .tools { display: flex; gap: 6px; align-items: center; flex: 0 0 auto; }
  .q { display: flex; align-items: center; gap: 8px; border: 1px solid var(--ink); background: var(--paper); padding: 0 10px; width: 210px; }
  .q svg { width: 16px; height: 16px; fill: none; stroke: var(--ink-2); stroke-width: 1.6; flex: none; }
  .q input { font: inherit; font-size: 16px; color: var(--ink); background: transparent; border: 0; outline: none; padding: 8px 0; width: 100%; -webkit-appearance: none; appearance: none; border-radius: 0; }
  .q input::placeholder { color: var(--line); font-size: 13px; }
  .q:focus-within { border-color: var(--shu); box-shadow: 0 0 0 1px var(--shu); }
  #sort { font: inherit; font-size: 13px; font-weight: 700; color: var(--ink); background: var(--paper); border: 1px solid var(--ink); border-radius: 0; padding: 9px 10px; cursor: pointer; }
  .hit { margin: 14px 0 0; font-size: 12.5px; color: var(--ink-2); }
  .hit b { font-family: var(--mono); font-weight: 500; font-size: 17px; color: var(--ink); }
  .hit button { font: inherit; font-size: 12.5px; color: var(--shu); background: none; border: 0; border-bottom: 1px solid var(--shu); padding: 0; margin-left: 12px; cursor: pointer; }

  /* カード */
  .cards { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .card { animation: up 0.7s var(--d) both; }
  .card.is-off { display: none; }
  .card a { display: flex; flex-direction: column; height: 100%; border: 1px solid var(--ink); background: var(--paper); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s; }
  .card a:hover { transform: translate(-4px, -4px); box-shadow: 6px 6px 0 var(--ink); }
  .card__img { position: relative; aspect-ratio: 16 / 10; border-bottom: 1px solid var(--ink); overflow: hidden;
    background: #f2eee4 linear-gradient(var(--hair) 1px, transparent 1px) 0 0 / 14px 14px; }
  .card__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 6px; transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .card a:hover .card__img img { transform: scale(1.04); }
  .card__no { position: absolute; left: 0; top: 0; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: 12px; padding: 2px 9px; }
  .card a:hover .card__no { background: var(--shu); }
  .card__body { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .card__meta { margin: 0; display: flex; gap: 10px; align-items: center; font-size: 11.5px; color: var(--ink-2); }
  .card__meta b { border: 1px solid var(--ink); color: var(--ink); padding: 0 8px; font-size: 11.5px; }
  .card__meta em { font-style: normal; }
  .card__t { margin: 0; font-family: var(--mincho); font-weight: 800; font-size: 17.5px; line-height: 1.6; }
  .card__p { margin: auto 0 0; padding-top: 10px; border-top: 1px solid var(--line); font-size: 12.5px; line-height: 1.7; color: var(--ink-2); }
  .card__p span { display: block; font-size: 11px; font-weight: 700; color: var(--shu); }
  .cards :global(mark) { background: linear-gradient(transparent 55%, rgba(212, 65, 42, 0.35) 55%); color: inherit; }
  .none { margin: 40px 0; color: var(--ink-2); }

  .cta { margin-top: 64px; display: flex; justify-content: space-between; align-items: center; gap: 20px 40px; flex-wrap: wrap; background: var(--ink); color: var(--paper); padding: clamp(24px, 4vw, 40px); }
  .cta__k { margin: 0 0 6px; font-size: 12.5px; font-weight: 700; color: #ff8a70; }
  .cta h2 { margin: 0; font-family: var(--mincho); font-weight: 800; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.5; }
  .cta__act { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .btn { background: var(--shu); color: var(--paper); font-weight: 700; font-size: 14.5px; padding: 13px 22px; transition: background 0.25s, color 0.25s; }
  .btn:hover { background: var(--paper); color: var(--ink); }
  .link { font-size: 13.5px; border-bottom: 1px solid var(--paper); padding-bottom: 2px; }

  .foot { margin: 0 calc(var(--gutter) + 10px) 40px; border-top: 1px solid var(--ink); padding-top: 20px; font-size: 12.5px; color: var(--ink-2); display: flex; gap: 8px 30px; flex-wrap: wrap; align-items: baseline; }
  .foot p { margin: 0; }
  .foot__n { font-weight: 700; color: var(--ink); }
  .foot__c { margin-left: auto !important; font-family: var(--mono); font-size: 10.5px; }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bar { flex-wrap: wrap; }
    .tools { flex: 1 1 100%; }
    .q { flex: 1; width: auto; }
  }
  @media (max-width: 760px) {
    .wrap { padding-top: 108px; }
    .nav__page { display: none; }
    .nav__cta { font-size: 12px; padding: 8px 12px; box-shadow: 3px 3px 0 var(--ink); }
    .head { grid-template-columns: 1fr; margin-bottom: 20px; }
    .lead { justify-self: start; font-size: 13.5px; }
    .bar { position: static; padding: 8px; }
    .cards { grid-template-columns: 1fr; gap: 16px; }
    .card__t { font-size: 17px; }
    .foot__c { margin-left: 0 !important; }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('#list')!;
  const items = [...list.querySelectorAll<HTMLElement>('li')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const hit = document.querySelector<HTMLElement>('#hit')!;
  const none = document.querySelector<HTMLElement>('#none')!;
  const clear = document.querySelector<HTMLButtonElement>('#clear')!;
  const st = { cat: '', q: '', sort: 'new' };

  /* 開いたときの絞り込みは、アドレスの ?cat= ?q= ?sort= から読む（記事の上の工程名から来た場合など） */
  const sp = new URLSearchParams(location.search);
  st.cat = sp.get('cat') || ''; st.q = sp.get('q') || ''; st.sort = sp.get('sort') === 'phase' ? 'phase' : 'new';
  q.value = st.q; sort.value = st.sort;

  const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const mark = (el: HTMLElement, words: string[]) => {
    const raw = el.dataset.raw ?? (el.dataset.raw = el.textContent || '');
    if (!words.length) { el.textContent = raw; return; }
    const re = new RegExp(`(${words.map(esc).join('|')})`, 'gi');
    el.innerHTML = raw.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!)).replace(re, '<mark>$1</mark>');
  };
  const apply = () => {
    const words = st.q.toLowerCase().split(/[\s　、,]+/).filter(Boolean);
    let n = 0;
    items.forEach((li) => {
      const ok = (!st.cat || li.dataset.cat === st.cat) && words.every((w) => li.dataset.text!.includes(w));
      li.classList.toggle('is-off', !ok); if (ok) n++;
      mark(li.querySelector('.card__t')!, words);
    });
    chips.forEach((b) => b.classList.toggle('is-on', b.dataset.cat === st.cat));
    [...items].sort((a, b) => st.sort === 'phase'
      ? Number(a.dataset.order) - Number(b.dataset.order) || Number(a.dataset.no) - Number(b.dataset.no)
      : Number(b.dataset.no) - Number(a.dataset.no)).forEach((li) => list.appendChild(li));
    hit.textContent = String(n); none.hidden = n > 0; clear.hidden = !st.cat && !st.q;
    const p = new URLSearchParams(); if (st.cat) p.set('cat', st.cat); if (st.q) p.set('q', st.q); if (st.sort === 'phase') p.set('sort', 'phase');
    history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
  };
  chips.forEach((b) => b.addEventListener('click', () => {
    st.cat = b.dataset.cat || ''; apply();
    b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
  }));
  sort.addEventListener('change', () => { st.sort = sort.value; apply(); });
  q.addEventListener('input', () => { st.q = q.value.trim(); apply(); });
  clear.addEventListener('click', () => { st.cat = ''; st.q = ''; q.value = ''; apply(); });
  apply();

  /* 工程のボタンが帯に収まらないときは、右端を薄くして横に動かせることを示す */
  const chipBox = document.querySelector<HTMLElement>('.chips')!;
  const edge = () => chipBox.classList.toggle('more', chipBox.scrollLeft + chipBox.clientWidth < chipBox.scrollWidth - 4);
  chipBox.addEventListener('scroll', edge, { passive: true }); addEventListener('resize', edge); edge();
</script>
