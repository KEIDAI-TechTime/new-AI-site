---
import DraftLayout from '@/layouts/DraftLayout.astro';
import { posts, cats, catOrder } from '@/data/posts';

const title = 'ブログ | TechTime';
const description = 'SAP の導入と保守で、生成AIをどの作業に、どう使うか。要件定義からプロジェクト管理まで、手順と測り方を書きます。';
const count = (c: string) => posts.filter((p) => p.cat === c).length;
const sorted = [...posts].sort((a, b) => Number(b.no) - Number(a.no));
---

<DraftLayout title={title} description={description}>
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="frame" aria-hidden="true"><span class="frame__tl">TECHTIME CO., LTD.</span><span class="frame__tr">BLOG</span></div>

  <header class="nav">
    <a href="/" class="nav__logo">TechTime<i></i></a>
    <a href="/contact?topic=assess" class="nav__cta">アセスメントの相談はこちら</a>
  </header>

  <main class="wrap">
    <p class="tag"><span>ブログ</span>導入と保守の現場から</p>
    <h1 class="h1">
      <span class="hl"><span>効果があった進め方を、</span></span>
      <span class="hl"><span>手順と測り方まで書く。</span></span>
    </h1>
    <p class="lead">SAP の導入と保守で、生成AIをどの作業に、どう使うか。考え方に加えて、明日から試せる手順まで書きます。</p>

    <!-- 探し方 1：工程から -->
    <section class="find" aria-label="工程から探す">
      <p class="find__k">工程から探す</p>
      <div class="phase">
        <div class="phase__line">
          {cats.line.map((c) => (
            <button type="button" class="ph" data-cat={c} disabled={count(c) === 0}><b>{c}</b><span>{count(c)}本</span></button>
          ))}
        </div>
        <div class="phase__cross">
          {cats.cross.map((c) => (
            <button type="button" class="ph ph--x" data-cat={c} disabled={count(c) === 0}><b>{c}</b><span>{count(c)}本</span><em>すべての工程に関わる</em></button>
          ))}
        </div>
      </div>
    </section>

    <!-- 探し方 2：困りごとから -->
    <section class="find" aria-label="困りごとから探す">
      <p class="find__k">困りごとから探す</p>
      <ul class="prob">
        {sorted.slice().reverse().map((p) => (
          <li data-cat={p.cat}><a href={`/blog/${p.slug}`}><span>{p.problem}</span><svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg><em>{p.no}</em></a></li>
        ))}
      </ul>
    </section>

    <!-- 探し方 3：言葉で -->
    <section class="find find--bar" aria-label="言葉で探す">
      <label class="q">
        <span>言葉で探す</span>
        <input type="search" id="q" placeholder="例：議事録、レビュー、期日" autocomplete="off" />
      </label>
      <div class="sort" role="group" aria-label="並び順">
        <button type="button" data-sort="new" class="is-on">新しい順</button>
        <button type="button" data-sort="phase">工程の順</button>
      </div>
      <p class="hit"><b id="hit">{posts.length}</b> / {posts.length}本<button type="button" id="clear" hidden>絞り込みを解除</button></p>
    </section>

    <ol class="list" id="list">
      {sorted.map((p) => (
        <li data-cat={p.cat} data-no={p.no} data-order={catOrder.indexOf(p.cat)} data-text={[p.title, p.dek, p.problem, p.cat, ...p.words].join(' ').toLowerCase()}>
          <a href={`/blog/${p.slug}`}>
            <span class="no">{p.no}</span>
            <div>
              <p class="meta"><b>{p.cat}</b><time>{p.date}</time><em>読む時間 約{p.min}分</em></p>
              <h2>{p.title}</h2>
              <p class="dek">{p.dek}</p>
            </div>
            <svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg>
          </a>
        </li>
      ))}
    </ol>
    <p class="none" id="none" hidden>当てはまる記事がありません。言葉を変えるか、絞り込みを解除してください。</p>
  </main>

  <footer class="foot">
    <p class="foot__n">TechTime株式会社</p>
    <p>東京都渋谷区渋谷2-19-15 宮益坂ビルディング609</p>
    <p class="foot__c">© TechTime Co., Ltd.</p>
  </footer>
</DraftLayout>

<style>
  .grid-bg { position: fixed; inset: 0; z-index: -1; background-image: linear-gradient(var(--hair) 1px, transparent 1px), linear-gradient(90deg, var(--hair) 1px, transparent 1px), linear-gradient(rgba(28, 27, 24, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(28, 27, 24, 0.035) 1px, transparent 1px); background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px; }
  .frame { position: fixed; inset: 10px; border: 1px solid var(--ink); pointer-events: none; z-index: 40; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em; color: var(--ink-2); }
  .frame span { position: absolute; top: -9px; background: var(--paper); padding: 2px 10px; line-height: 1.4; }
  .frame__tl { left: 22px; }
  .frame__tr { right: 22px; }
  .nav { position: fixed; top: 10px; left: 10px; right: 10px; z-index: 30; display: flex; justify-content: space-between; align-items: center; padding: 22px var(--gutter) 14px; background: linear-gradient(var(--paper) 60%, transparent); }
  .nav__logo { font-family: var(--mincho); font-weight: 800; font-size: 21px; display: flex; align-items: center; gap: 7px; }
  .nav__logo i { width: 8px; height: 8px; background: var(--shu); display: block; }
  .nav__cta { background: var(--shu); color: var(--paper); font-weight: 700; font-size: 13.5px; padding: 9px 18px; box-shadow: 4px 4px 0 var(--ink); transition: box-shadow 0.25s, transform 0.25s; white-space: nowrap; }
  .nav__cta:hover { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 160px calc(var(--gutter) + 10px) 90px; }
  .tag { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--ink-2); margin: 0 0 26px; display: flex; align-items: center; gap: 14px; }
  .tag span { color: var(--paper); background: var(--ink); padding: 1px 9px; font-family: var(--gothic); }
  .h1 { font-family: var(--mincho); font-weight: 800; font-size: clamp(27px, 4.6vw, 58px); line-height: 1.36; margin: 0 0 22px; }
  .hl { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hl > span { display: inline-block; transform: translateY(108%); animation: rise 1.1s cubic-bezier(0.16, 0.9, 0.2, 1) forwards; }
  .hl:nth-child(2) > span { animation-delay: 0.16s; }
  @keyframes rise { to { transform: none; } }
  @keyframes up { from { opacity: 0; transform: translateY(24px); } }
  .lead { max-width: 620px; color: var(--ink-2); margin: 0 0 54px; animation: up 0.9s 0.4s both; }
  svg[viewBox='0 0 40 10'] { width: 40px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1.2; flex: none; transition: transform 0.35s; }

  /* 探し方 */
  .find { margin-bottom: 34px; animation: up 0.8s 0.5s both; }
  .find__k { margin: 0 0 10px; font-size: 12.5px; font-weight: 700; display: flex; align-items: center; gap: 9px; }
  .find__k::before { content: ''; width: 8px; height: 8px; background: var(--ink); }
  .phase { border: 1px solid var(--ink); background: var(--paper); }
  .phase__line { display: grid; grid-template-columns: repeat(6, 1fr); }
  .phase__cross { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--ink); }
  .ph { font: inherit; text-align: left; background: transparent; color: var(--ink); border: 0; border-right: 1px solid var(--ink); padding: 14px 16px 15px; cursor: pointer; position: relative; display: grid; gap: 2px; transition: background 0.25s, color 0.25s; }
  .ph:last-child { border-right: 0; }
  .phase__line .ph:not(:last-child)::after { content: ''; position: absolute; right: -7px; top: 50%; width: 12px; height: 12px; background: var(--paper); border-top: 1px solid var(--ink); border-right: 1px solid var(--ink); transform: translateY(-50%) rotate(45deg); z-index: 1; transition: background 0.25s; }
  .ph b { font-family: var(--mincho); font-weight: 700; font-size: clamp(14px, 1.5vw, 18px); }
  .ph span { font-family: var(--mono); font-size: 11.5px; color: var(--shu); }
  .ph em { font-style: normal; font-size: 11px; color: var(--ink-2); position: absolute; right: 14px; top: 50%; transform: translateY(-50%); }
  .ph:hover:not(:disabled) { background: var(--paper-2); }
  .ph:hover:not(:disabled)::after { background: var(--paper-2); }
  .ph.is-on { background: var(--ink); color: var(--paper); }
  .ph.is-on::after { background: var(--ink) !important; }
  .ph.is-on span, .ph.is-on em { color: #ff8a70; }
  .ph:disabled { cursor: default; color: var(--line); }
  .ph:disabled span { color: var(--line); }
  .prob { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 8px; }
  .prob a { display: grid; grid-template-columns: 1fr auto auto; gap: 12px; align-items: center; border: 1px solid var(--line); background: var(--paper); padding: 11px 14px; font-size: 14px; line-height: 1.6; height: 100%; transition: border-color 0.25s, background 0.25s; }
  .prob a::before { content: ''; }
  .prob a { grid-template-columns: 1fr auto auto; }
  .prob a::before { display: none; }
  .prob svg { width: 22px; color: var(--shu); }
  .prob em { font-style: normal; font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); }
  .prob a:hover { border-color: var(--ink); background: var(--paper-2); }
  .prob a:hover svg { transform: translateX(4px); }
  .prob li.is-off { display: none; }
  .find--bar { display: grid; grid-template-columns: 1fr auto auto; gap: 14px 22px; align-items: end; margin: 46px 0 0; padding-top: 22px; border-top: 1px solid var(--ink); }
  .q { display: grid; gap: 6px; }
  .q span { font-size: 12.5px; font-weight: 700; display: flex; align-items: center; gap: 9px; }
  .q span::before { content: ''; width: 8px; height: 8px; background: var(--ink); }
  .q input { font: inherit; font-size: 16px; color: var(--ink); background: var(--paper); border: 1px solid var(--ink); border-radius: 0; padding: 11px 14px; outline: none; width: 100%; -webkit-appearance: none; appearance: none; }
  .q input:focus { border-color: var(--shu); box-shadow: 0 0 0 1px var(--shu); }
  .q input::placeholder { color: var(--line); }
  .sort { display: flex; border: 1px solid var(--ink); }
  .sort button { font: inherit; font-size: 13px; font-weight: 700; background: var(--paper); color: var(--ink); border: 0; padding: 12px 16px; cursor: pointer; white-space: nowrap; }
  .sort button + button { border-left: 1px solid var(--ink); }
  .sort button.is-on { background: var(--ink); color: var(--paper); }
  .hit { margin: 0; font-size: 13px; color: var(--ink-2); padding-bottom: 12px; white-space: nowrap; }
  .hit b { font-family: var(--mono); font-weight: 500; font-size: 22px; color: var(--ink); }
  .hit button { font: inherit; font-size: 12.5px; color: var(--shu); background: none; border: 0; border-bottom: 1px solid var(--shu); padding: 0; margin-left: 14px; cursor: pointer; }

  /* 一覧 */
  .list { list-style: none; margin: 18px 0 0; padding: 0; border-top: 1px solid var(--ink); }
  .list li { border-bottom: 1px solid var(--ink); }
  .list li.is-off { display: none; }
  .list a { display: grid; grid-template-columns: clamp(60px, 9vw, 120px) 1fr auto; gap: clamp(14px, 3vw, 40px); align-items: center; padding: clamp(22px, 3vw, 40px) 0; transition: background 0.35s, padding 0.35s; }
  .list a:hover { background: var(--ink); color: var(--paper); padding-inline: clamp(12px, 2vw, 28px); }
  .no { font-family: var(--mono); font-weight: 500; font-size: clamp(38px, 6vw, 84px); line-height: 1; letter-spacing: -0.04em; color: var(--shu); }
  .meta { margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); transition: color 0.35s; }
  .meta b { font-family: var(--gothic); border: 1px solid currentColor; padding: 0 9px; color: var(--ink); transition: color 0.35s; }
  .meta em { font-style: normal; font-family: var(--gothic); }
  .list a:hover .meta, .list a:hover .meta b, .list a:hover .dek { color: #c9c4b6; }
  .list h2 { margin: 0 0 8px; font-family: var(--mincho); font-weight: 800; font-size: clamp(19px, 2.6vw, 29px); line-height: 1.5; }
  .dek { margin: 0; font-size: 14.5px; color: var(--ink-2); max-width: 660px; transition: color 0.35s; }
  .list a:hover svg { transform: translateX(8px); }
  .list :global(mark) { background: linear-gradient(transparent 55%, rgba(212, 65, 42, 0.35) 55%); color: inherit; }
  .none { margin: 40px 0; color: var(--ink-2); }
  .foot { margin: 0 calc(var(--gutter) + 10px) 40px; border-top: 1px solid var(--ink); padding-top: 20px; font-size: 12.5px; color: var(--ink-2); display: flex; gap: 8px 30px; flex-wrap: wrap; align-items: baseline; }
  .foot p { margin: 0; }
  .foot__n { font-weight: 700; color: var(--ink); }
  .foot__c { margin-left: auto !important; font-family: var(--mono); font-size: 10.5px; }
  @media (max-width: 760px) {
    .wrap { padding-top: 120px; }
    .nav__cta { font-size: 12px; padding: 8px 12px; box-shadow: 3px 3px 0 var(--ink); }
    .phase__line { grid-template-columns: repeat(3, 1fr); }
    .phase__line .ph:nth-child(3) { border-right: 0; }
    .phase__line .ph:nth-child(-n + 3) { border-bottom: 1px solid var(--ink); }
    .phase__line .ph:nth-child(3)::after { display: none; }
    .phase__cross { grid-template-columns: 1fr; }
    .phase__cross .ph { border-right: 0; }
    .phase__cross .ph + .ph { border-top: 1px solid var(--ink); }
    .ph { padding: 11px 12px; }
    .prob { grid-template-columns: 1fr; }
    .find--bar { grid-template-columns: 1fr; }
    .sort button { flex: 1; }
    .hit { padding-bottom: 0; }
    .list a { grid-template-columns: 1fr; gap: 6px; }
    .list a > svg { display: none; }
    .foot__c { margin-left: 0 !important; }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('#list')!;
  const items = [...list.querySelectorAll<HTMLElement>('li')];
  const probs = [...document.querySelectorAll<HTMLElement>('.prob li')];
  const phs = [...document.querySelectorAll<HTMLButtonElement>('.ph')];
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const hit = document.querySelector<HTMLElement>('#hit')!;
  const none = document.querySelector<HTMLElement>('#none')!;
  const clear = document.querySelector<HTMLButtonElement>('#clear')!;
  const sorts = [...document.querySelectorAll<HTMLButtonElement>('.sort button')];
  const st = { cat: '', q: '', sort: 'new' };

  /* 開いたときの絞り込みは、アドレスの ?cat= と ?q= から読む（記事から工程を押して来た場合など） */
  const sp = new URLSearchParams(location.search);
  st.cat = sp.get('cat') || ''; st.q = sp.get('q') || ''; st.sort = sp.get('sort') === 'phase' ? 'phase' : 'new';
  q.value = st.q;

  const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const mark = (el: HTMLElement, words: string[]) => {
    const raw = el.dataset.raw ?? (el.dataset.raw = el.textContent || '');
    if (!words.length) { el.textContent = raw; return; }
    const re = new RegExp(`(${words.map(esc).join('|')})`, 'gi');
    el.innerHTML = raw.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!)).replace(re, '<mark>$1</mark>');
  };
  const apply = () => {
    const words = st.q.toLowerCase().split(/[\s　、,]+/).filter(Boolean);
    let n = 0;
    items.forEach((li) => {
      const ok = (!st.cat || li.dataset.cat === st.cat) && words.every((w) => li.dataset.text!.includes(w));
      li.classList.toggle('is-off', !ok); if (ok) n++;
      mark(li.querySelector('h2')!, words); mark(li.querySelector('.dek')!, words);
    });
    probs.forEach((li) => li.classList.toggle('is-off', !!st.cat && li.dataset.cat !== st.cat));
    phs.forEach((b) => b.classList.toggle('is-on', b.dataset.cat === st.cat));
    sorts.forEach((b) => b.classList.toggle('is-on', b.dataset.sort === st.sort));
    [...items].sort((a, b) => st.sort === 'phase'
      ? Number(a.dataset.order) - Number(b.dataset.order) || Number(a.dataset.no) - Number(b.dataset.no)
      : Number(b.dataset.no) - Number(a.dataset.no)).forEach((li) => list.appendChild(li));
    hit.textContent = String(n); none.hidden = n > 0; clear.hidden = !st.cat && !st.q;
    const p = new URLSearchParams(); if (st.cat) p.set('cat', st.cat); if (st.q) p.set('q', st.q); if (st.sort === 'phase') p.set('sort', 'phase');
    history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
  };
  phs.forEach((b) => b.addEventListener('click', () => { st.cat = st.cat === b.dataset.cat ? '' : b.dataset.cat!; apply(); }));
  sorts.forEach((b) => b.addEventListener('click', () => { st.sort = b.dataset.sort!; apply(); }));
  q.addEventListener('input', () => { st.q = q.value.trim(); apply(); });
  clear.addEventListener('click', () => { st.cat = ''; st.q = ''; q.value = ''; apply(); });
  apply();
</script>
