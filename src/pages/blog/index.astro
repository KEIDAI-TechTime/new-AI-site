---
/* 記事の一覧。絞り込み・並び替え・言葉で探す動きは前のまま */
import NextLayout from '@/layouts/NextLayout.astro';
import { posts, catOrder } from '@/data/posts';

const title = 'ブログ | TechTime';
const description = 'SAP 導入の困りごとを、AIでどう解決するか。要件定義からテスト、運用保守まで、工程ごとに、明日から試せる手順を書きます。';
const sorted = [...posts].sort((a, b) => Number(b.no) - Number(a.no));
const cats = catOrder.filter((c) => posts.some((p) => p.cat === c));
const count = (c: string) => posts.filter((p) => p.cat === c).length;
const SITE = 'https://techtime-jp.com';
const ld = [{
  '@type': 'Blog', '@id': `${SITE}/blog#blog`, name: 'TechTime ブログ', url: `${SITE}/blog`, inLanguage: 'ja', publisher: { '@id': `${SITE}/#org` },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: `${SITE}/blog/${p.slug}`, datePublished: p.date.replace(/\./g, '-'), image: `${SITE}/images/blog/${p.slug}.jpg` })),
}];
---

<NextLayout noEnd title={title} description={description} cur="blog" og="blog.jpg" ld={ld}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="bl-tone" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="1.256 -0.518 0.369 0 -0.024  0.759 -0.021 0.369 0 -0.024  -0.391 1.129 0.369 0 -0.024  0 0 0 1 0" /></filter></svg>

  <section class="hero" data-st="記事">
    <div class="hero__top">
      <div>
        <p class="kick">ブログ／導入と保守の現場から</p>
        <h1 class="bl-h1">SAP 導入の困りごとを、<br /><em>AI</em>でどう解決するか。</h1>
      </div>
      <div class="hero__side">
        <p>要件定義からテスト、運用保守まで。工程ごとに、明日から試せる手順を書きます。</p>
      </div>
    </div>

    <!-- 探し方：1行の帯にまとめる -->
    <div class="bl-bar" role="search">
      <div class="bl-chips" role="group" aria-label="工程で絞り込む">
        <button type="button" class="bl-chip is-on" data-cat="">すべて<span>{posts.length}</span></button>
        {cats.map((c) => <button type="button" class="bl-chip" data-cat={c}>{c}<span>{count(c)}</span></button>)}
      </div>
      <div class="bl-tools">
        <label class="bl-q"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" /><path d="M13 13l5 5" /></svg><input type="search" id="q" placeholder="言葉で探す" autocomplete="off" aria-label="言葉で探す" /></label>
        <select id="sort" aria-label="並び順"><option value="new">新しい順</option><option value="phase">工程の順</option></select>
      </div>
    </div>
    <p class="bl-hit"><b id="hit">{posts.length}</b> 本<button type="button" id="clear" hidden>絞り込みを解除</button></p>

    <ol class="bl-cards" id="list">
      {sorted.map((p, i) => (
        <li class="bl-card" style={`--d:${Math.min(i, 8) * 0.06}s`} data-cat={p.cat} data-no={p.no} data-order={catOrder.indexOf(p.cat)} data-text={[p.title, p.dek, p.problem, p.cat, ...p.words].join(' ').toLowerCase()}>
          <a href={`/blog/${p.slug}`}>
            <div class="bl-card__img">
              <img src={`/images/blog/${p.slug}.webp`} alt={`記事「${p.short}」の図`} loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async" />
            </div>
            <div class="bl-card__body">
              <p class="bl-card__meta"><b>{p.cat}</b><em>読む時間 約{p.min}分</em><span class="bl-card__no">{p.no}</span></p>
              <h2 class="bl-card__t">{p.title}</h2>
              <p class="bl-card__p"><span>こんな困りごとに</span>{p.problem}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
    <p class="bl-none" id="none" hidden>当てはまる記事がありません。言葉を変えるか、絞り込みを解除してください。</p>

    <aside class="bl-cta rv">
      <div>
        <p class="kick">貴社のプロジェクトの状況を、資料から確認します</p>
        <h2>記事で書いた分析を、貴社の資料で行います。</h2>
      </div>
      <div class="act">
        <a href="/assessment" class="btn">アセスメントの内容を見る<i></i></a>
        <a href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" class="more">報告書のサンプル（PDF）</a>
      </div>
    </aside>
  </section>
</NextLayout>

<style is:global>
  @keyframes bl-up { from { opacity: 0; transform: translateY(18px); } }
  .bl-h1 { font-size: clamp(29px, 3.4vw, 50px); }
  .bl-h1 em { font-style: normal; background: linear-gradient(transparent 62%, var(--key) 62% 94%, transparent 94%); }

  /* 探し方の帯 */
  .bl-bar { position: sticky; top: 92px; z-index: 15; display: flex; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin-top: clamp(22px, 3.2vw, 44px); padding: 8px; border-radius: 99px; background: var(--card); box-shadow: 0 10px 24px -18px rgba(17, 23, 26, 0.5); }
  .bl-chips { flex: 1 1 auto; display: flex; gap: 4px; min-width: 0; overflow-x: auto; border-radius: 99px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
  .bl-chips::-webkit-scrollbar { display: none; }
  .bl-chips.bl-fade { -webkit-mask-image: linear-gradient(to right, #000 85%, transparent); mask-image: linear-gradient(to right, #000 85%, transparent); }
  .bl-chip { flex: none; display: flex; align-items: baseline; gap: 6px; padding: 5px 14px; border-radius: 99px; font-size: 13px; font-weight: 700; white-space: nowrap; transition: background 0.2s, color 0.2s; }
  .bl-chip span { font: 600 14px var(--num); color: var(--mute); }
  .bl-chip:hover { background: var(--tint); }
  .bl-chip.is-on { background: var(--ink); color: #fff; }
  .bl-chip.is-on span { color: var(--key); }
  .bl-tools { flex: 0 0 auto; display: flex; align-items: center; gap: 6px; }
  .bl-q { display: flex; align-items: center; gap: 8px; width: 210px; padding: 0 14px; border-radius: 99px; background: var(--bg); box-shadow: inset 0 0 0 2px transparent; transition: box-shadow 0.2s; }
  .bl-q svg { flex: none; width: 16px; height: 16px; fill: none; stroke: var(--mute); stroke-width: 1.8; stroke-linecap: round; }
  .bl-q input { width: 100%; padding: 6px 0; border: 0; border-radius: 0; outline: none; background: transparent; font: inherit; font-size: 16px; color: var(--ink); -webkit-appearance: none; appearance: none; }
  .bl-q input::placeholder { font-size: 13px; color: var(--mute); }
  .bl-q:focus-within { box-shadow: inset 0 0 0 2px var(--key); }
  #sort { padding: 8px 14px; border: 0; border-radius: 99px; background: var(--bg); font: inherit; font-size: 13px; font-weight: 700; color: var(--ink); cursor: pointer; }
  .bl-hit { margin-top: 16px; font-size: 13px; color: var(--mute); }
  .bl-hit b { margin-right: 2px; font: 600 26px/1 var(--num); color: var(--ink); }
  .bl-hit button { margin-left: 14px; font-size: 13px; font-weight: 700; color: var(--ink); text-decoration: underline; text-decoration-color: var(--key); text-decoration-thickness: 3px; text-underline-offset: 5px; }

  /* カード */
  .bl-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 12px; }
  .bl-card { animation: bl-up 0.7s var(--d) both; }
  .bl-card.is-off { display: none; }
  .bl-card a { display: flex; flex-direction: column; height: 100%; border-radius: var(--r); background: var(--card); overflow: hidden; transition: transform 0.3s, box-shadow 0.3s; }
  .bl-card a:hover { transform: translateY(-4px); box-shadow: 0 14px 30px -18px rgba(17, 23, 26, 0.45); }
  .bl-card__img { position: relative; aspect-ratio: 2 / 1; margin: 10px 10px 0; border-radius: 10px; background: #fff; overflow: hidden; }
  .bl-card__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; filter: url(#bl-tone); transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .bl-card a:hover .bl-card__img img { transform: scale(1.04); }
  .bl-card__body { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 14px 24px 22px; }
  .bl-card__meta { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--mute); }
  .bl-card__meta b { padding: 0 12px; border-radius: 99px; background: var(--tint); font-size: 12px; line-height: 2; color: var(--ink); }
  .bl-card__meta em { font-style: normal; }
  .bl-card__no { margin-left: auto; font: 600 17px/1 var(--num); color: #8a8f94; }
  .bl-card__t { font-size: clamp(16.5px, 1.45vw, 19px); font-weight: 900; line-height: 1.6; letter-spacing: 0; }
  .bl-card__p { margin-top: auto; padding: 12px 16px; border-radius: 10px; background: var(--bg); font-size: 13px; line-height: 1.7; }
  .bl-card__p span { display: block; font-size: 11.5px; font-weight: 700; color: var(--mute); }
  .bl-cards mark { background: linear-gradient(transparent 55%, var(--key) 55%); color: inherit; }
  .bl-none { margin: 40px 0; font-weight: 500; }

  .bl-cta { display: grid; grid-template-columns: 1.25fr 1fr; gap: 20px clamp(24px, 5vw, 80px); align-items: center; margin-top: clamp(40px, 6vw, 90px); padding: clamp(26px, 4vw, 56px); border-radius: var(--r); background: var(--tint); }
  .bl-cta h2 { margin-top: 10px; font-size: clamp(22px, 2.6vw, 36px); }
  .bl-cta .act { gap: 14px 22px; }

  @media (max-width: 1000px) {
    .bl-bar { flex-wrap: wrap; border-radius: 22px; }
    .bl-tools { flex: 1 1 100%; }
    .bl-q { flex: 1; width: auto; }
  }
  @media (max-width: 900px) {
    .bl-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bl-cta { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .bl-bar { position: static; }
    .bl-cards { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .bl-card { animation: none; } }
</style>

<script>
  const list = document.querySelector<HTMLElement>('#list')!;
  const items = [...list.querySelectorAll<HTMLElement>('li')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.bl-chip')];
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const hit = document.querySelector<HTMLElement>('#hit')!;
  const none = document.querySelector<HTMLElement>('#none')!;
  const clear = document.querySelector<HTMLButtonElement>('#clear')!;
  const st = { cat: '', q: '', sort: 'new' };

  /* 開いたときの絞り込みは、アドレスの ?cat= ?q= ?sort= から読む（記事の上の工程名から来た場合など） */
  const sp = new URLSearchParams(location.search);
  st.cat = sp.get('cat') || ''; st.q = sp.get('q') || ''; st.sort = sp.get('sort') === 'phase' ? 'phase' : 'new';
  q.value = st.q; sort.value = st.sort;

  const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const mark = (el: HTMLElement, words: string[]) => {
    const raw = el.dataset.raw ?? (el.dataset.raw = el.textContent || '');
    if (!words.length) { el.textContent = raw; return; }
    const re = new RegExp(`(${words.map(esc).join('|')})`, 'gi');
    el.innerHTML = raw.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!)).replace(re, '<mark>$1</mark>');
  };
  const apply = () => {
    const words = st.q.toLowerCase().split(/[\s　、,]+/).filter(Boolean);
    let n = 0;
    items.forEach((li) => {
      const ok = (!st.cat || li.dataset.cat === st.cat) && words.every((w) => li.dataset.text!.includes(w));
      li.classList.toggle('is-off', !ok); if (ok) n++;
      mark(li.querySelector('.bl-card__t')!, words);
    });
    chips.forEach((b) => b.classList.toggle('is-on', b.dataset.cat === st.cat));
    [...items].sort((a, b) => st.sort === 'phase'
      ? Number(a.dataset.order) - Number(b.dataset.order) || Number(a.dataset.no) - Number(b.dataset.no)
      : Number(b.dataset.no) - Number(a.dataset.no)).forEach((li) => list.appendChild(li));
    hit.textContent = String(n); none.hidden = n > 0; clear.hidden = !st.cat && !st.q;
    const p = new URLSearchParams(); if (st.cat) p.set('cat', st.cat); if (st.q) p.set('q', st.q); if (st.sort === 'phase') p.set('sort', 'phase');
    history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
  };
  chips.forEach((b) => b.addEventListener('click', () => {
    st.cat = b.dataset.cat || ''; apply();
    b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
  }));
  sort.addEventListener('change', () => { st.sort = sort.value; apply(); });
  q.addEventListener('input', () => { st.q = q.value.trim(); apply(); });
  clear.addEventListener('click', () => { st.cat = ''; st.q = ''; q.value = ''; apply(); });
  apply();

  /* 工程のボタンが帯に収まらないときは、右端を薄くして横に動かせることを示す */
  const chipBox = document.querySelector<HTMLElement>('.bl-chips')!;
  const edge = () => chipBox.classList.toggle('bl-fade', chipBox.scrollLeft + chipBox.clientWidth < chipBox.scrollWidth - 4);
  chipBox.addEventListener('scroll', edge, { passive: true }); addEventListener('resize', edge); edge();
</script>
