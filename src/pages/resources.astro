---
import PageLayout from '@/layouts/PageLayout.astro';
const title = '資料とひな形：SAP 導入で使える Excel のひな形 | TechTime';
const description = 'SAP の導入で使える資料とひな形を配布しています。アセスメント結果報告書のサンプル、設計書レビューの観点表、移行データの照合の記録表、会議の決定と未決の記録表を、入力なしでダウンロードできます。';
const items = [
  { tag: 'PDF・29枚', name: 'アセスメント結果報告書のサンプル', body: '架空の会社を題材にした報告書です。期日に間に合う確率、設計書の指摘の偏り、減る工数の見込みを掲載しています。', file: '/downloads/techtime-assessment-sample.pdf', save: 'TechTime_アセスメント結果報告書_サンプル.pdf', more: ['/assessment', 'アセスメントの内容'] },
  { tag: 'Excel', name: '設計書レビューの観点表', body: 'レビューで確かめる12の観点と、設計書ごとの結果を記録する表です。観点を文章にすると、誰がレビューしても同じ基準で確かめられます。', file: '/downloads/techtime-design-review-viewpoints.xlsx', save: 'TechTime_設計書レビューの観点表.xlsx', more: ['/blog/review-every-document', '設計書は全件をレビューする'] },
  { tag: 'Excel', name: '移行データの照合の記録表', body: '移行の前と後の件数と合計を、対象ごとに比べる表です。合わない項目は、理由を3つに分けて記録します。', file: '/downloads/techtime-migration-reconciliation.xlsx', save: 'TechTime_移行データの照合の記録表.xlsx', more: ['/blog/reconcile-all-migration-data', '移行データは全件を照合する'] },
  { tag: 'Excel', name: '会議の決定と未決の記録表', body: '会議で決まったことを、要件一覧や設計書に反映するまで追いかける表です。決まらなかった議題は、理由と一緒に残します。', file: '/downloads/techtime-meeting-decisions.xlsx', save: 'TechTime_会議の決定と未決の記録表.xlsx', more: ['/blog/decisions-that-never-reach-the-design', '会議の決定が設計書に反映されないのは、反映する担当がいないからだ'] },
];
---

<PageLayout
  title={title}
  description={description}
  crumbs={[{ name: '資料とひな形' }]}
  tag="入力なしでダウンロードできます"
  h1={['SAP 導入で使える、', '資料とひな形。']}
  lead="ブログで説明している進め方を、すぐに試せる形にしました。お名前などの入力は要りません。ひな形は、自由に書き換えてお使いください。"
>
  <section class="sec pg-near" data-st="ダウンロード">
    <p class="kick rv">ダウンロード</p>
    <div class="dl rv">
      {items.map((x) => (
        <article>
          <p class="dl__k">{x.tag}</p>
          <h2>{x.name}</h2>
          <p>{x.body}</p>
          <div class="act">
            <a class="btn" href={x.file} download={x.save} data-dl>ダウンロード<i></i></a>
            <a class="more" href={x.more[0]}>{x.more[1]}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sec" data-st="アセスメント">
    <div class="pg-nx rv">
      <h2>貴社の設計書と移行データで、点検と照合を全件行います。</h2>
      <div>
        <p>ひな形は、人が記録するための表です。AIチームを組み込むと、点検と照合を全件で行えます。</p>
        <div class="act">
          <a href="/assessment" class="btn">アセスメントの内容を見る<i></i></a>
          <a href="/services" class="more">サービスの一覧を見る</a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style is:global>
  .dl { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 16px; }
  .dl article { display: flex; flex-direction: column; gap: 10px; padding: 26px 28px 28px; border-radius: var(--r); background: var(--card); }
  .dl__k { align-self: flex-start; padding: 1px 12px; border-radius: 99px; background: var(--tint); font-size: 12px; font-weight: 700; }
  .dl h2 { font-size: clamp(19px, 1.8vw, 24px); line-height: 1.5; }
  .dl article > p:not(.dl__k) { font-size: 14.5px; color: var(--mute); }
  .dl .act { margin-top: auto; padding-top: 12px; gap: 14px 22px; }
  .dl .btn { height: 48px; font-size: 14px; }
  .dl .more { font-size: 13.5px; }
  @media (max-width: 900px) { .dl { grid-template-columns: 1fr; } }
</style>
