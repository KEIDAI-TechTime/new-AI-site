---
import NextLayout from '@/layouts/NextLayout.astro';
import { posts } from '@/data/posts';
import { serviceByCat, serviceBySlug } from '@/data/services';

interface Props {
  slug: string;
  points: string[];
}
const { slug, points } = Astro.props;
const post = posts.find((p) => p.slug === slug)!;
/* 関連する記事：posts.ts の related の順。足りなければ同じ工程の記事で補う。3本まで */
const bySlug = (s: string) => posts.find((p) => p.slug === s)!;
const rel = post.related.map(bySlug);
const same = posts.filter((p) => p.slug !== slug && p.cat === post.cat && !post.related.includes(p.slug));
const others = [...rel, ...same].slice(0, 3);
const svc = serviceByCat[post.cat] ? serviceBySlug(serviceByCat[post.cat]) : null;
const SITE = 'https://techtime-jp.com';
const url = `${SITE}/blog/${slug}`;
const iso = post.date.replace(/\./g, '-');
const ld = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.title,
    alternativeHeadline: post.short,
    description: post.dek,
    datePublished: iso,
    dateModified: iso,
    inLanguage: 'ja',
    articleSection: post.cat,
    keywords: post.words.join(','),
    image: `${SITE}/og/${slug}.jpg`,
    mainEntityOfPage: url,
    author: { '@id': `${SITE}/#org` },
    publisher: { '@id': `${SITE}/#org` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'ブログ', item: `${SITE}/blog` },
      { '@type': 'ListItem', position: 3, name: post.short, item: url },
    ],
  },
];
---

<NextLayout title={`${post.short} | TechTime`} description={post.dek} cur="blog" og={`${slug}.jpg`} type="article" published={iso} ld={ld}>
  <article class="post">
    <header class="post__head" data-st={post.cat}>
      <nav class="kick post__crumb" aria-label="現在の位置"><a href="/">ホーム</a>／<a href="/blog">記事</a>／<a href={`/blog?cat=${encodeURIComponent(post.cat)}`}>{post.cat}</a></nav>
      <h1>{post.title}</h1>
      <p class="post__dek">{post.dek}</p>
      <p class="post__meta"><a href={`/blog?cat=${encodeURIComponent(post.cat)}`} class="post__cat">{post.cat}</a><time>{post.date}</time><em>読む時間 約{post.min}分</em></p>
      <div class="gist">
        <p class="kick">この記事の要点</p>
        <ol>
          {points.map((p) => <li><span set:html={p} /></li>)}
        </ol>
      </div>
    </header>

    <div class="post__body" data-st="本文">
      <slot />
    </div>

    <aside class="pcta" data-st="アセスメント">
      <p class="kick">貴社のプロジェクトの状況を、資料から確認します</p>
      <h2>貴社の資料を読み、どこに効くかを報告書にします。</h2>
      <p>設計書や会議の記録をお預かりし、この記事の内容を貴社の資料で確認します。架空の会社を題材にした、結果報告書のサンプルをご覧いただけます。</p>
      <div class="act">
        <a href="/downloads/techtime-assessment-sample.pdf" target="_blank" rel="noopener" class="btn">アセスメントのサンプルを見る<small>PDF・29枚</small><i></i></a>
        <a href="/assessment" class="btn btn--sub">アセスメントの内容を見る</a>
        <a href="/contact?topic=assess" class="btn btn--sub">アセスメントを相談する</a>
      </div>
    </aside>

    <nav class="rel" data-st="関連する記事">
      <p class="kick">あわせて読みたい記事</p>
      <div class="rel__list">
        {others.map((o) => (
          <a href={`/blog/${o.slug}`}>
            <em>{o.cat}</em>
            <b>{o.title}</b>
          </a>
        ))}
      </div>
      <p class="rel__more">
        {svc
          ? <a href={`/services/${svc.slug}`} class="more">{svc.name}に、AIチームを組み込む進め方を見る</a>
          : <a href="/services" class="more">工程ごとの、AIチームの組み込み方を見る</a>}
        <a href="/blog" class="more">すべての記事を、工程や言葉で探す</a>
      </p>
    </nav>
  </article>
</NextLayout>

<style is:global>
  /* 記事。本文は背景の上に置き、図・表・囲みは白い面にする */
  .post { --acc: #a36d00; --soft: #e4e7e5; --gry: #8a8f94; max-width: 760px; margin: 0 auto; padding-top: clamp(28px, 4.4vw, 60px); }
  .post *::before, .post *::after { box-sizing: border-box; }
  .post__crumb { flex-wrap: wrap; gap: 4px 6px; }
  .post__crumb::before { margin-right: 4px; }
  .post__crumb a { text-decoration: underline; text-underline-offset: 4px; }
  .post h1 { margin-top: 16px; font-size: clamp(27px, 3.6vw, 44px); line-height: 1.4; }
  .post__dek { margin-top: 20px; font-size: clamp(15.5px, 1.5vw, 17.5px); font-weight: 500; line-height: 2; }
  .post__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin-top: 18px; font-size: 13px; color: var(--mute); }
  .post__meta time { font: 500 12.5px var(--mono); }
  .post__meta em { font-style: normal; }
  .post__cat { padding: 2px 14px; border-radius: 99px; background: var(--card); color: var(--ink); font-weight: 700; transition: background 0.25s; }
  .post__cat:hover { background: var(--tint); }
  .gist { margin-top: 30px; padding: clamp(20px, 3vw, 30px) clamp(20px, 3.4vw, 34px); border-radius: var(--r); background: var(--card); }
  .gist ol { margin-top: 8px; counter-reset: g; }
  .gist li { counter-increment: g; display: grid; grid-template-columns: 1.9em 1fr; align-items: baseline; padding: 11px 0; font-weight: 500; line-height: 1.85; }
  .gist li + li { border-top: 1px solid var(--rule); }
  .gist li::before { content: counter(g); font: 600 21px/1 var(--num); color: var(--ink); }
  .gist li b, .post__body b { font-weight: 700; background: linear-gradient(transparent 64%, rgba(242, 169, 0, 0.42) 64%); }

  .post__body { margin-top: clamp(44px, 6vw, 70px); font-size: 16.5px; line-height: 2.05; }
  .post__body > p { margin: 0 0 1.5em; }
  .post__body h2 { margin: clamp(64px, 8vw, 96px) 0 24px; font-size: clamp(22px, 2.7vw, 30px); font-weight: 900; line-height: 1.55; }
  .post__body h2 > i { display: flex; align-items: center; gap: 9px; margin-bottom: 10px; font: 600 17px/1 var(--num); font-style: normal; letter-spacing: 0.06em; color: var(--mute); }
  .post__body h2 > i::before { content: ''; flex: none; width: 9px; height: 14px; border-left: 3px solid var(--ink); border-right: 3px solid var(--key); }
  .post__body h3 { margin: 46px 0 14px; font-size: 19px; font-weight: 900; line-height: 1.6; }
  .post__body > ul { margin: 0 0 1.6em; }
  .post__body > ul > li { position: relative; padding: 7px 0 7px 26px; line-height: 1.9; }
  .post__body > ul > li::before { content: ''; position: absolute; left: 4px; top: 1.25em; width: 9px; height: 9px; border-radius: 50%; background: var(--key); }
  .post__body ol.n { margin: 0 0 1.6em; counter-reset: n; padding: 6px clamp(18px, 3vw, 28px); border-radius: var(--r); background: var(--card); }
  .post__body ol.n > li { counter-increment: n; position: relative; padding: 14px 0 14px 44px; line-height: 1.9; font-size: 15.5px; }
  .post__body ol.n > li + li { border-top: 1px solid var(--rule); }
  .post__body ol.n > li::before { content: counter(n); position: absolute; left: 2px; top: 15px; font: 600 25px/1.2 var(--num); color: var(--ink); }
  .post__body ol.n > li strong { display: block; font-size: 17px; font-weight: 900; }
  .post__body strong { font-weight: 700; }
  .post__body .lead2 { margin: 0 0 1.3em; font-size: clamp(18px, 2.1vw, 22px); font-weight: 700; line-height: 1.85; }

  /* 現場のひとこと */
  .say { margin: 36px 0; padding: clamp(20px, 3vw, 28px) clamp(20px, 3.4vw, 32px); border-radius: var(--r); background: var(--tint); }
  .say p { font-size: clamp(17px, 1.9vw, 20px); font-weight: 900; line-height: 1.8; }
  .say span { display: block; margin-top: 8px; font-size: 13.5px; line-height: 1.85; color: var(--mute); }
  /* 注意・落とし穴 */
  .trap { margin: 34px 0; padding: clamp(18px, 2.6vw, 24px) clamp(20px, 3.4vw, 30px); border-radius: var(--r); background: var(--card); }
  .trap > b { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; font-size: 13.5px; font-weight: 700; color: var(--miss); background: none; }
  .trap > b::before { content: ''; flex: none; width: 9px; height: 14px; border-left: 3px solid var(--ink); border-right: 3px solid var(--miss); }
  .trap p { line-height: 1.95; font-size: 15.5px; }
  /* 明日からできること */
  .todo { margin: 34px 0; padding: clamp(20px, 3vw, 28px) clamp(20px, 3.4vw, 32px) 12px; border-radius: var(--r); background: var(--card); }
  .todo > b { display: block; margin-bottom: 8px; font-size: 19px; font-weight: 900; background: none; }
  .todo li { display: grid; grid-template-columns: 34px 1fr; padding: 12px 0; border-top: 1px solid var(--rule); line-height: 1.85; font-size: 15.5px; }
  .todo li::before { content: ''; width: 18px; height: 18px; margin-top: 6px; border-radius: 6px; background: var(--tint); box-shadow: inset 0 0 0 2px var(--key); }

  /* 表 */
  .tbl { width: 100%; margin: 30px 0; border-collapse: separate; border-spacing: 0; border-radius: var(--r); background: var(--card); overflow: hidden; font-size: 14.5px; line-height: 1.75; }
  .tbl th, .tbl td { padding: 12px 16px; text-align: left; vertical-align: top; }
  .tbl tbody tr + tr > * { border-top: 1px solid var(--rule); }
  .tbl thead th { padding-top: 14px; font-size: 12.5px; font-weight: 700; color: var(--mute); white-space: nowrap; border-bottom: 2px solid var(--ink); }
  .tbl tbody th { font-weight: 700; white-space: nowrap; }
  .tbl td.x { color: var(--mute); }
  .tbl td.o { font-weight: 700; }
  .tbl .m { font-family: var(--num); font-weight: 600; font-size: 1.15em; }

  /* ---------- 図 ---------- */
  .post .fig { --out: clamp(0px, calc((100vw - 760px) / 2 - var(--pad) - 8px), 80px); margin: 40px calc(-1 * var(--out)); border-radius: var(--r); background: var(--card); overflow: hidden; }
  .fig__h { padding: 18px clamp(18px, 3vw, 30px) 0; font-size: 15px; font-weight: 900; line-height: 1.6; }
  .fig__h span { margin-right: 12px; font-size: 12.5px; font-weight: 700; color: var(--mute); white-space: nowrap; }
  .fig__b { position: relative; padding: clamp(16px, 2.4vw, 26px) clamp(18px, 3vw, 30px); overflow: hidden; font-size: 13px; line-height: 1.6; }
  .fig__c { padding: 0 clamp(18px, 3vw, 30px) 18px; font-size: 12.5px; line-height: 1.75; color: var(--mute); }
  :where(.post) .fig svg { width: 100%; height: auto; display: block; overflow: visible; }
  :where(.post) .fig svg text { font-family: var(--sans); font-size: 13px; fill: var(--ink); }
  :where(.post) .fig svg .mo { font-family: var(--num); font-weight: 600; }
  :where(.post) .fig svg .sm { font-size: 11px; fill: var(--mute); }
  :where(.post) .fig svg .bd { font-weight: 700; }
  :where(.post) .fig i, :where(.post) .fig em, :where(.post) .fig u { font-style: normal; text-decoration: none; }
  /* 共通の枠が同じ名前のクラスを持つので、記事の中では打ち消す */
  :where(.post) td.b, :where(.post) i.b { display: revert; width: auto; height: auto; border-radius: 0; background: none; }
  :where(.post) p.note { margin-top: 0; font-size: inherit; color: inherit; }
  :where(.post) i.end { margin: 0; padding: 0; border-radius: 0; background: none; }
  /* 図の中の動き：.run が付くたびに最初から再生する */
  .fig.run .p { animation: fpop 0.55s var(--t, 0s) cubic-bezier(0.3, 1.4, 0.5, 1) both; }
  .fig.run .f { animation: ffade 0.6s var(--t, 0s) both; }
  .fig.run .ty { animation: fty 0.6s var(--t, 0s) cubic-bezier(0.2, 0.8, 0.2, 1) both; transform-origin: left; transform-box: fill-box; }
  .fig.run .up { animation: fup 0.7s var(--t, 0s) cubic-bezier(0.2, 0.8, 0.2, 1) both; transform-origin: bottom; transform-box: fill-box; }
  .fig.run .dr { stroke-dasharray: 1; animation: fdr 0.8s var(--t, 0s) cubic-bezier(0.5, 0, 0.2, 1) both; }
  @keyframes fpop { from { opacity: 0; transform: translateY(12px) scale(0.92); } }
  @keyframes ffade { from { opacity: 0; } }
  @keyframes fty { from { transform: scaleX(0); } }
  @keyframes fup { from { transform: scaleY(0); } }
  @keyframes fdr { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  /* ---------- 記事の後 ---------- */
  .pcta { margin-top: clamp(64px, 8vw, 100px); padding: clamp(24px, 4vw, 44px); border-radius: var(--r); background: var(--tint); }
  .pcta h2 { margin-top: 12px; font-size: clamp(21px, 2.6vw, 30px); line-height: 1.5; }
  .pcta > p:not(.kick) { margin-top: 14px; font-size: 15px; line-height: 2; }
  .pcta .act { margin-top: 24px; }
  .pcta .btn small { font-size: 11.5px; font-weight: 500; opacity: 0.85; white-space: nowrap; }
  .pcta .btn { height: auto; min-height: 54px; padding-top: 8px; padding-bottom: 8px; line-height: 1.5; }
  .rel { margin-top: clamp(48px, 6vw, 72px); }
  .rel__list { display: grid; gap: 10px; margin-top: 16px; }
  .rel__list a { display: block; padding: 18px clamp(18px, 3vw, 26px); border-radius: var(--r); background: var(--card); transition: background 0.25s; }
  .rel__list a:hover { background: var(--tint); }
  .rel__list em { display: block; font-style: normal; font-size: 12.5px; font-weight: 700; color: var(--mute); }
  .rel__list b { display: block; margin-top: 2px; font-size: clamp(16px, 1.8vw, 18.5px); font-weight: 900; line-height: 1.6; }
  .rel__more { display: flex; flex-wrap: wrap; gap: 14px 32px; margin-top: 24px; }

  @media (max-width: 760px) {
    .post__body { font-size: 16px; line-height: 2; }
    .tbl { font-size: 13.5px; }
    .tbl th, .tbl td { padding: 9px 10px; }
    .tbl thead th, .tbl tbody th { white-space: normal; }
    .post .fig { margin-left: calc(-1 * var(--pad) + 8px); margin-right: calc(-1 * var(--pad) + 8px); }
    .fig__h, .fig__c { padding-left: 14px; padding-right: 14px; }
    .fig__b { padding-left: 12px; padding-right: 12px; }
  }
</style>

<script>
  /* 図は、見えている間だけ、決めた間隔でくり返し再生する */
  const live = new Set<HTMLElement>();
  const play = (f: HTMLElement) => { f.classList.remove('run'); void f.offsetWidth; f.classList.add('run'); f.dispatchEvent(new CustomEvent('fig:play')); };
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const f = e.target as HTMLElement;
    if (e.isIntersecting) { if (!live.has(f)) { live.add(f); play(f); } } else live.delete(f);
  }), { threshold: 0.25 });
  document.querySelectorAll<HTMLElement>('.post .fig').forEach((f) => {
    io.observe(f);
    const ms = Number(f.dataset.loop || 0);
    if (ms) setInterval(() => { if (live.has(f) && !document.hidden) play(f); }, ms);
  });
</script>
