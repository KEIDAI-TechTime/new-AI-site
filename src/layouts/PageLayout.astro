---
/* サービス・会社概要・用語集など、記事とトップ以外のページの共通の型。
   枠・ヘッダー・パンくず・フッターと、本文で使う部品の見た目をここで持つ。 */
import DraftLayout from '@/layouts/DraftLayout.astro';

interface Crumb { name: string; href?: string }
interface Props {
  title: string;
  description: string;
  og?: string;
  /* 右上の枠に出す英字の札 */
  mark: string;
  /* パンくず。ホームは自動で先頭に入る。最後の要素がいまのページ */
  crumbs: Crumb[];
  ld?: object[];
  /* ヘッダー右の朱のボタン。既定はアセスメントの相談 */
  cta?: { href: string; label: string };
}
const { title, description, og = 'site.jpg', mark, crumbs, ld = [], cta = { href: '/contact?topic=assess', label: 'アセスメントの相談はこちら' } } = Astro.props;
const SITE = 'https://techtime-jp.com';
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const crumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE}/` },
    ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: `${SITE}${c.href ?? here}` })),
  ],
};
---

<DraftLayout title={title} description={description} og={og} ld={[...ld, crumbLd]}>
  <div class="pg">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="frame" aria-hidden="true"><span class="frame__tl">TECHTIME CO., LTD.</span><span class="frame__tr">{mark}</span></div>

    <header class="nav">
      <a href="/" class="nav__logo">TechTime<i></i></a>
      <nav class="nav__links">
        <a href="/services">サービス</a>
        <a href="/assessment">アセスメント</a>
        <a href="/blog">ブログ</a>
        <a href="/company">会社概要</a>
        <a href={cta.href} class="nav__cta">{cta.label}<svg viewBox="0 0 40 10"><path d="M0 5h38M33 1l5 4-5 4" /></svg></a>
      </nav>
    </header>

    <main class="wrap">
      <nav class="crumb" aria-label="現在の位置">
        <a href="/">ホーム</a>
        {crumbs.map((c, i) => (<><i>/</i>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span>{c.name}</span>}</>))}
      </nav>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot__cols">
        <div>
          <p class="foot__h">サービス</p>
          <a href="/services">サービスの一覧</a>
          <a href="/services/requirements">要件定義</a>
          <a href="/services/design">設計</a>
          <a href="/services/development">開発</a>
          <a href="/services/test">テスト</a>
          <a href="/services/migration">移行</a>
          <a href="/services/operations">運用保守</a>
          <a href="/services/project-management">プロジェクト管理</a>
        </div>
        <div>
          <p class="foot__h">はじめる</p>
          <a href="/assessment">アセスメント</a>
          <a href="/check">AI活用の自己診断</a>
          <a href="/process">進め方とお見積もり</a>
          <a href="/faq">よくある質問</a>
          <a href="/contact">相談する</a>
        </div>
        <div>
          <p class="foot__h">読む</p>
          <a href="/blog">ブログ</a>
          <a href="/glossary">用語集</a>
          <a href="/resources">資料とひな形</a>
          <a href="/company">会社概要</a>
        </div>
      </div>
      <div class="foot__base">
        <p class="foot__n">TechTime株式会社</p>
        <p>東京都渋谷区渋谷2-19-15 宮益坂ビルディング609</p>
        <p class="foot__c">© TechTime Co., Ltd.</p>
      </div>
    </footer>
  </div>
</DraftLayout>

<style is:global>
  .pg .grid-bg { position: fixed; inset: 0; z-index: -1; background-image: linear-gradient(var(--hair) 1px, transparent 1px), linear-gradient(90deg, var(--hair) 1px, transparent 1px); background-size: 40px 40px; }
  .pg .frame { position: fixed; inset: 10px; border: 1px solid var(--ink); pointer-events: none; z-index: 40; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em; color: var(--ink-2); }
  .pg .frame span { position: absolute; top: -9px; background: var(--paper); padding: 2px 10px; line-height: 1.4; }
  .pg .frame__tl { left: 22px; }
  .pg .frame__tr { right: 22px; }
  .pg .nav { position: fixed; top: 10px; left: 10px; right: 10px; z-index: 30; display: flex; justify-content: space-between; align-items: center; padding: 22px var(--gutter) 14px; background: linear-gradient(var(--paper) 60%, transparent); }
  .pg .nav__logo { font-family: var(--mincho); font-weight: 800; font-size: 21px; display: flex; align-items: center; gap: 7px; }
  .pg .nav__logo i { width: 8px; height: 8px; background: var(--shu); display: block; }
  .pg .nav__links { display: flex; align-items: center; gap: clamp(14px, 2.2vw, 28px); font-size: 13.5px; font-weight: 500; }
  .pg .nav__links > a:not(.nav__cta) { border-bottom: 1px solid transparent; padding-bottom: 2px; transition: border-color 0.25s; }
  .pg .nav__links > a:not(.nav__cta):hover { border-color: var(--ink); }
  .pg .nav__cta { display: flex; align-items: center; gap: 12px; background: var(--shu); color: var(--paper); font-weight: 700; padding: 10px 16px 10px 20px; box-shadow: 4px 4px 0 var(--ink); transition: box-shadow 0.25s, transform 0.25s; white-space: nowrap; }
  .pg .nav__cta:hover { box-shadow: 1px 1px 0 var(--ink); transform: translate(3px, 3px); }
  .pg svg[viewBox='0 0 40 10'] { width: 30px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1.2; flex: none; transition: transform 0.35s; }

  .pg .wrap { max-width: 1180px; margin: 0 auto; padding: 132px calc(var(--gutter) + 10px) 60px; }
  .pg .crumb { display: flex; flex-wrap: wrap; gap: 6px 10px; margin: 0 0 30px; font-size: 12px; color: var(--ink-2); }
  .pg .crumb a { border-bottom: 1px solid var(--line); }
  .pg .crumb i { font-style: normal; color: var(--line); }
  .pg .tag { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--ink-2); margin: 0 0 22px; display: flex; align-items: center; gap: 14px; }
  .pg .tag span { color: var(--paper); background: var(--ink); padding: 1px 9px; font-family: var(--gothic); }
  @keyframes pgrise { to { transform: none; } }
  @keyframes pgup { from { opacity: 0; transform: translateY(22px); } }
  .pg .top { padding-bottom: clamp(50px, 7vw, 90px); max-width: 900px; }
  .pg .h1 { font-family: var(--mincho); font-weight: 800; font-size: clamp(26px, 3.6vw, 48px); line-height: 1.4; margin: 0 0 22px; }
  .pg .hl { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .pg .hl > span { display: inline-block; transform: translateY(108%); animation: pgrise 1.1s cubic-bezier(0.16, 0.9, 0.2, 1) forwards; }
  .pg .hl:nth-child(2) > span { animation-delay: 0.16s; }
  .pg .h1 em { font-style: normal; color: var(--shu); }
  .pg .lead { margin: 0 0 26px; color: var(--ink-2); max-width: 680px; font-size: 16.5px; line-height: 2; animation: pgup 0.9s 0.4s both; }
  .pg .pts { list-style: none; margin: 0 0 30px; padding: 0; border-top: 1px solid var(--ink); max-width: 760px; animation: pgup 0.9s 0.5s both; }
  .pg .pts li { display: grid; grid-template-columns: 9em 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14.5px; color: var(--ink-2); align-items: baseline; }
  .pg .pts b { font-family: var(--mincho); font-size: 16px; color: var(--ink); }
  .pg .act { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; animation: pgup 0.9s 0.6s both; }
  .pg .btn { display: inline-flex; align-items: center; gap: 18px; background: var(--shu); color: var(--paper); padding: 15px 22px 15px 28px; font-weight: 700; font-size: 15px; letter-spacing: 0.04em; position: relative; overflow: hidden; isolation: isolate; border: 0; cursor: pointer; font-family: inherit; }
  .pg .btn::before { content: ''; position: absolute; inset: 0; background: var(--ink); transform: translateX(-101%); transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: -1; }
  .pg .btn:hover::before { transform: none; }
  .pg .btn:hover svg { transform: translateX(6px); }
  .pg .link { font-size: 14px; font-weight: 500; border-bottom: 1px solid var(--ink); padding-bottom: 2px; }
  .pg .note { margin: 14px 0 0; font-size: 12.5px; color: var(--ink-2); }

  .pg .sec { padding: clamp(54px, 7vw, 96px) 0; border-top: 1px solid var(--ink); }
  .pg .h2 { font-family: var(--mincho); font-weight: 800; font-size: clamp(22px, 2.8vw, 36px); line-height: 1.45; margin: 0 0 14px; }
  .pg .sub { margin: 0 0 34px; color: var(--ink-2); max-width: 720px; line-height: 2; }
  .pg .prose { max-width: 760px; }
  .pg .prose p { margin: 0 0 18px; line-height: 2.05; }
  .pg .prose a, .pg .sub a, .pg dd a, .pg td a { border-bottom: 1px solid var(--shu); }
  .pg .tbl { width: 100%; border-collapse: collapse; background: var(--paper); font-size: 15px; }
  .pg .tbl th, .pg .tbl td { border: 1px solid var(--ink); padding: 13px 18px; text-align: left; line-height: 1.75; vertical-align: top; }
  .pg .tbl thead th { background: var(--ink); color: var(--paper); font-size: 13px; }
  .pg .tbl tbody th { background: var(--paper-2); width: 30%; font-weight: 700; }
  .pg .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--ink); background: var(--paper); }
  .pg .cards > * { padding: 22px 24px 26px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); margin-bottom: -1px; margin-right: -1px; display: block; }
  .pg .cards span { font-family: var(--mono); font-size: 13px; color: var(--shu); }
  .pg .cards b { display: block; font-family: var(--mincho); font-size: 19px; line-height: 1.55; margin: 4px 0 8px; }
  .pg .cards p { margin: 0; font-size: 14px; line-height: 1.9; color: var(--ink-2); }
  .pg a.card { transition: background 0.3s, color 0.3s; }
  .pg a.card:hover { background: var(--ink); color: var(--paper); }
  .pg a.card:hover p { color: #c9c4b6; }
  .pg .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--ink); background: var(--paper); }
  .pg .steps li { padding: 20px 20px 22px; border-right: 1px solid var(--ink); display: grid; gap: 10px; align-content: start; }
  .pg .steps li:last-child { border-right: 0; }
  .pg .steps span { font-family: var(--mono); font-size: 26px; color: var(--shu); line-height: 1; }
  .pg .steps b { font-family: var(--mincho); font-size: 17px; line-height: 1.55; display: block; }
  .pg .steps p { margin: 6px 0 0; font-size: 13.5px; line-height: 1.85; color: var(--ink-2); }
  .pg .steps em { font-style: normal; display: block; margin-top: 8px; font-size: 12.5px; color: var(--ink); border-top: 1px solid var(--line); padding-top: 8px; }
  .pg .faq { margin: 0; border-top: 1px solid var(--ink); }
  .pg .faq div { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .pg .faq dt { font-family: var(--mincho); font-weight: 700; font-size: 17px; line-height: 1.6; }
  .pg .faq dt::before { content: 'Q'; font-family: var(--mono); color: var(--shu); margin-right: 12px; }
  .pg .faq dd { margin: 0; font-size: 15px; line-height: 1.95; color: var(--ink-2); }
  .pg .cta { margin: clamp(30px, 4vw, 60px) calc(-1 * clamp(0px, 3vw, 40px)) 0; background: var(--ink); color: var(--paper); padding: clamp(32px, 5vw, 64px); }
  .pg .cta h2 { margin: 0 0 12px; font-family: var(--mincho); font-weight: 800; font-size: clamp(23px, 3.2vw, 38px); line-height: 1.45; }
  .pg .cta > p { margin: 0 0 28px; color: #c9c4b6; max-width: 640px; line-height: 1.95; }
  .pg .cta .act { animation: none; }
  .pg .btn--inv::before { background: var(--paper); }
  .pg .btn--inv:hover { color: var(--ink); }
  .pg .link--inv { border-color: var(--paper); }
  .pg .list { padding: clamp(50px, 6vw, 80px) 0 10px; }
  .pg .list ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .pg .list li a { display: grid; grid-template-columns: 7em 1fr; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--line); font-family: var(--mincho); font-weight: 700; font-size: 17px; line-height: 1.6; transition: padding 0.3s, color 0.3s; align-items: baseline; }
  .pg .list li a small { font-family: var(--gothic); font-weight: 500; font-size: 12px; color: var(--ink-2); }
  .pg .list li a:hover { padding-left: 10px; color: var(--shu); }

  .pg .foot { margin: 60px calc(var(--gutter) + 10px) 40px; border-top: 1px solid var(--ink); padding-top: 26px; font-size: 13px; color: var(--ink-2); }
  .pg .foot__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 220px)); gap: 26px 40px; margin-bottom: 30px; }
  .pg .foot__cols a { display: block; padding: 3px 0; }
  .pg .foot__cols a:hover { color: var(--shu); }
  .pg .foot__h { margin: 0 0 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; color: var(--ink); }
  .pg .foot__base { display: flex; gap: 8px 30px; flex-wrap: wrap; align-items: baseline; border-top: 1px solid var(--line); padding-top: 16px; font-size: 12.5px; }
  .pg .foot p { margin: 0; }
  .pg .foot__n { font-weight: 700; color: var(--ink); }
  .pg .foot__c { margin-left: auto !important; font-family: var(--mono); font-size: 10.5px; }

  @media (max-width: 900px) {
    .pg .wrap { padding-top: 110px; }
    .pg .nav__links > a:not(.nav__cta) { display: none; }
    .pg .nav__cta { font-size: 12px; padding: 8px 12px; box-shadow: 3px 3px 0 var(--ink); }
    .pg .nav__cta svg { display: none; }
    .pg .pts li { grid-template-columns: 1fr; gap: 0; }
    .pg .cards { grid-template-columns: 1fr; }
    .pg .steps { grid-template-columns: 1fr; }
    .pg .steps li { border-right: 0; border-bottom: 1px solid var(--ink); }
    .pg .steps li:last-child { border-bottom: 0; }
    .pg .tbl { font-size: 13.5px; }
    .pg .tbl th, .pg .tbl td { padding: 10px 12px; }
    .pg .faq div { grid-template-columns: 1fr; gap: 6px; }
    .pg .cta { margin-inline: -8px; }
    .pg .list li a { grid-template-columns: 1fr; gap: 2px; }
    .pg .foot__cols { grid-template-columns: 1fr 1fr; }
    .pg .foot__c { margin-left: 0 !important; }
  }
</style>
