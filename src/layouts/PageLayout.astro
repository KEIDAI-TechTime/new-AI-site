---
/* 会社概要・用語集・よくある質問など、記事とトップと工程以外のページの共通の型。
   枠（ヘッダー・フッター・相談の面）は NextLayout が持つ。ここはページの頭と、本文で使う部品の見た目を持つ。 */
import NextLayout from '@/layouts/NextLayout.astro';

interface Crumb { name: string; href?: string }
interface Props {
  title: string;
  description: string;
  og?: string;
  /* パンくず。最後の要素がいまのページ。構造化データには、ホームを先頭に足して出す */
  crumbs: Crumb[];
  /* パンくずの右に添える短い言葉 */
  tag?: string;
  /* 見出し。要素ごとに改行する */
  h1: string[];
  lead: string;
  ld?: object[];
  /* ヘッダーのメニューで、いまの位置として示す項目 */
  cur?: string;
  /* 下の相談の面に出す言葉 */
  ask?: string;
}
const { title, description, og = 'site.jpg', crumbs, tag, h1, lead, ld = [], cur = '', ask } = Astro.props;
const SITE = 'https://techtime-jp.com';
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const crumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE}/` },
    ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: `${SITE}${c.href ?? here}` })),
  ],
};
const last = crumbs[crumbs.length - 1];
/* 1行が長い見出しは、折り返さない大きさに下げる */
const long = Math.max(...h1.map((l) => l.length)) > 12;
---

<NextLayout title={title} description={description} og={og} cur={cur} ask={ask} ld={[...ld, crumbLd]}>
  <section class="hero" data-st={last.name}>
    <div class="hero__top">
      <div>
        <p class="kick pg-crumb" aria-label="現在の位置">
          <span>{crumbs.map((c, i) => (<>{i > 0 && '／'}{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : c.name}</>))}</span>
          {tag && <small>{tag}</small>}
        </p>
        <h1 class:list={[long && 'pg-h1s']}>{h1.map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h1>
      </div>
      <div class="hero__side">
        <p>{lead}</p>
        <slot name="act" />
      </div>
    </div>
  </section>
  <slot />
</NextLayout>

<style is:global>
  [hidden] { display: none !important; }
  .pg-crumb { flex-wrap: wrap; }
  .pg-crumb a { text-decoration: underline; text-underline-offset: 4px; }
  .pg-crumb small { font-size: 12.5px; font-weight: 500; color: var(--mute); }

  .pg-h1s { font-size: clamp(28px, 3.1vw, 44px); line-height: 1.3; }
  .pg-near { padding-top: clamp(40px, 5vw, 72px); }
  .pg-body { margin-top: clamp(22px, 3.2vw, 44px); }
  /* 左に見出し、右に中身 */
  .pg-grp { display: grid; grid-template-columns: 1fr 2.6fr; gap: 16px clamp(24px, 4vw, 60px); align-items: start; }
  .pg-grp > h2 { position: sticky; top: 110px; font-size: clamp(21px, 2.1vw, 30px); line-height: 1.4; }

  /* 表：行ごとに白い面 */
  .pg-tbl { width: 100%; border-collapse: separate; border-spacing: 0 8px; margin: -8px 0; font-size: 14.5px; }
  .pg-tbl.pg-body { margin-top: clamp(14px, 2.6vw, 36px); }
  .pg-tbl th, .pg-tbl td { padding: 16px 22px; background: var(--card); text-align: left; vertical-align: top; }
  .pg-tbl tr > :first-child { border-radius: 12px 0 0 12px; }
  .pg-tbl tr > :last-child { border-radius: 0 12px 12px 0; }
  .pg-tbl thead th { padding: 0 22px; background: none; font-size: 12px; font-weight: 700; color: var(--mute); }
  .pg-tbl tbody th { width: 26%; font-size: 15.5px; font-weight: 900; }
  .pg-tbl small { font-size: 12.5px; color: var(--mute); }
  .pg-tbl a, .pg-prose a, .pg-lnk { text-decoration: underline; text-decoration-color: var(--key); text-decoration-thickness: 3px; text-underline-offset: 5px; font-weight: 700; }

  /* 並べる面 */
  .pg-cds { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .pg-cds > * { display: block; padding: 24px 26px; border-radius: var(--r); background: var(--card); transition: background 0.25s, color 0.25s; }
  .pg-cds b { display: block; font-size: clamp(17px, 1.5vw, 20px); font-weight: 900; line-height: 1.55; }
  .pg-cds p { margin-top: 8px; font-size: 14px; color: var(--mute); }
  .pg-cds a b { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pg-cds a b::after { content: ''; flex: none; width: 8px; height: 8px; margin-right: 4px; border-top: 2px solid; border-right: 2px solid; transform: rotate(45deg); }
  .pg-cds a:hover { background: var(--ink); color: #fff; }
  .pg-cds a:hover p { color: #c9cdd0; }
  .pg-cds--tint > * { background: var(--tint); }
  .pg-cds--tint p { color: var(--ink); }

  /* 順に進むもの：番号は小さな丸 */
  .pg-flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; counter-reset: f; }
  .pg-flow--5 { grid-template-columns: repeat(5, 1fr); }
  .pg-flow li { display: flex; flex-direction: column; padding: 20px 22px 22px; border-radius: var(--r); background: var(--card); counter-increment: f; }
  .pg-flow li::before, .pg-nums li::before { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--key); color: var(--ink); font: 600 16px var(--num); }
  .pg-flow li::before { content: counter(f); }
  .pg-flow b { display: block; margin-top: 12px; font-size: 17px; font-weight: 900; line-height: 1.5; }
  .pg-flow p { margin-top: 6px; font-size: 14px; color: var(--mute); }
  .pg-flow em { display: block; margin-top: auto; padding: 5px 12px; border-radius: 8px; background: var(--tint); font-style: normal; font-size: 12.5px; font-weight: 700; }
  .pg-flow p + em { margin-top: auto; }
  .pg-flow p { margin-bottom: 14px; }
  .pg-nums { display: grid; gap: 8px; counter-reset: n; }
  .pg-nums li { display: grid; grid-template-columns: 44px 1fr; align-items: center; padding: 14px 22px; border-radius: 12px; background: var(--card); font-weight: 700; counter-increment: n; }
  .pg-nums li::before { content: counter(n); }

  /* 問いと答え、言葉と意味 */
  .pg-qa { display: grid; gap: 8px; }
  .pg-qa div { display: grid; grid-template-columns: 1fr 1.5fr; gap: 24px; padding: 20px 26px; border-radius: 12px; background: var(--card); }
  .pg-qa dt { font-weight: 900; font-size: 16px; line-height: 1.7; }
  .pg-qa dd { font-size: 14.5px; }

  /* 文章 */
  .pg-prose { padding: clamp(22px, 2.6vw, 34px) clamp(22px, 3vw, 40px); border-radius: var(--r); background: var(--card); }
  .pg-prose p + p { margin-top: 14px; }

  /* 続きのリンクの並び */
  .pg-rel { display: grid; grid-template-columns: 1.3fr 1fr; gap: 30px 40px; }
  .pg-rel ul { margin-top: 10px; }
  .pg-rel li a { display: grid; grid-template-columns: 8em 1fr; gap: 12px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--rule); font-weight: 700; transition: padding 0.25s, box-shadow 0.2s; }
  .pg-rel li a small { font-size: 12px; font-weight: 500; color: var(--mute); }
  .pg-rel li a:hover { padding-left: 8px; box-shadow: inset 0 -3px 0 var(--key); }
  .pg-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .pg-chips li a { display: block; padding: 3px 14px; border: 0; border-radius: 99px; background: var(--card); font-size: 13px; }
  .pg-chips li a:hover { padding-left: 14px; background: var(--ink); color: #fff; box-shadow: none; }

  /* 次に見るもの */
  .pg-nx { display: grid; grid-template-columns: 1.25fr 1fr; gap: 18px clamp(24px, 5vw, 80px); align-items: center; padding: clamp(26px, 3.6vw, 48px) clamp(22px, 4vw, 56px); border-radius: var(--r); background: var(--card); }
  .pg-nx h2 { font-size: clamp(20px, 2.2vw, 30px); line-height: 1.45; }
  .pg-nx p { font-size: 14.5px; }
  .pg-nx .act { margin-top: 18px; gap: 14px 22px; }
  .pg-tail { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 26px; margin-top: clamp(40px, 5vw, 72px); font-weight: 500; }

  @media (max-width: 900px) {
    .pg-grp, .pg-cds, .pg-flow, .pg-flow--5, .pg-rel, .pg-nx { grid-template-columns: 1fr; }
    .pg-grp > h2 { position: static; }
    .pg-tbl, .pg-tbl tbody, .pg-tbl tr, .pg-tbl th, .pg-tbl td { display: block; width: auto; }
    .pg-tbl, .pg-tbl.pg-body { margin: 0; }
    .pg-tbl.pg-body { margin-top: 22px; }
    .pg-tbl thead { display: none; }
    .pg-tbl tr { padding: 16px 20px; border-radius: 12px; background: var(--card); }
    .pg-tbl tr + tr { margin-top: 8px; }
    .pg-tbl tbody th, .pg-tbl td { width: auto; padding: 0; border-radius: 0 !important; background: none; }
    .pg-tbl td { margin-top: 6px; }
    .pg-qa div { grid-template-columns: 1fr; gap: 6px; padding: 18px 20px; }
    .pg-rel li a { grid-template-columns: 1fr; gap: 0; }
  }
</style>
