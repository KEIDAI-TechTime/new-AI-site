---
interface Props {
  title: string;
  description: string;
  /* 共有したときの画像。/og/ 以下のファイル名。無ければサイト共通の画像 */
  og?: string;
  /* 記事なら 'article' */
  type?: 'website' | 'article';
  published?: string;
  /* ページごとの構造化データ（JSON-LD）。会社とサイトの分は全ページに自動で入る */
  ld?: object[];
}
const { title, description, og = 'site.jpg', type = 'website', published, ld = [] } = Astro.props;
const SITE = 'https://techtime-jp.com';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE).href;
const ogImage = `${SITE}/og/${og}`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#org`,
  name: 'TechTime株式会社',
  alternateName: 'TechTime',
  url: `${SITE}/`,
  logo: `${SITE}/images/logo.png`,
  description: 'SAP を中心とした基幹システムの導入と運用保守に、生成AIで設計・開発・テスト・点検・進捗管理を進める仕組みを組み込む会社。',
  foundingDate: '2020-04-01',
  telephone: '+81-3-4222-3363',
  address: { '@type': 'PostalAddress', addressCountry: 'JP', addressRegion: '東京都', addressLocality: '渋谷区', postalCode: '150-0002', streetAddress: '渋谷2-19-15 宮益坂ビルディング609' },
};
const site = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE}/#site`, name: 'TechTime', url: `${SITE}/`, inLanguage: 'ja', publisher: { '@id': `${SITE}/#org` } };
const graph = [org, site, ...ld];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V7Q3QV7HGR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-V7Q3QV7HGR');
      /* アセスメントのサンプル（PDF）が開かれた・保存された回数を、押された場所と一緒に記録する */
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href$=".pdf"], a[href$=".xlsx"]') : null;
        if (!a) return;
        var sec = a.closest('[id]'), part = a.closest('header, footer, aside');
        var where = sec ? '#' + sec.id : (part ? '(' + part.tagName.toLowerCase() + ')' : '');
        gtag('event', 'sample_download', {
          file_name: a.getAttribute('href').split('/').pop(),
          link_place: location.pathname + where,
          link_text: (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 40)
        });
      }, true);
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TechTime株式会社" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="TechTime ブログ" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Shippori+Mincho+B1:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Shippori+Mincho+B1:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : { '@context': 'https://schema.org', '@graph': graph.map(({ ['@context']: _, ...g }: any) => g) })} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper: #f2eee4;
    --paper-2: #e9e4d7;
    --ink: #1c1b18;
    --ink-2: #57544c;
    --line: #b9b3a3;
    --hair: rgba(28, 27, 24, 0.09);
    --shu: #d4412a;
    --mincho: 'Shippori Mincho B1', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
    --gothic: 'Zen Kaku Gothic New', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
    --mono: 'DM Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --gutter: clamp(16px, 4vw, 56px);
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--gothic);
    font-size: 16px;
    line-height: 1.9;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ::selection {
    background: var(--shu);
    color: var(--paper);
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
