---
/* 新しいサイトの案の共通の枠。公開前の確認用で、検索には載せない */
interface Props { title: string; description: string; cur?: string; ask?: string; live?: boolean }
const { title, description, cur = '', ask = 'いまの工程と、困っていることを聞かせてください。', live = false } = Astro.props;
const menu = live
  ? [
      { k: 'kotei', n: '工程', h: '/services' },
      { k: 'assessment', n: 'アセスメント', h: '/assessment' },
      { k: 'blog', n: '記事', h: '/blog' },
      { k: 'company', n: '会社概要', h: '/company' },
    ]
  : [
      { k: 'shikumi', n: 'しくみ', h: '/next/shikumi' },
      { k: 'kotei', n: '工程', h: '/next/kotei' },
      { k: 'assessment', n: 'アセスメント', h: '/assessment' },
      { k: 'blog', n: '記事', h: '/blog' },
    ];
const SITE = 'https://techtime-jp.com';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE).href;
const ogImage = `${SITE}/og/site.jpg`;
const graph = [
  {
    '@type': 'Organization', '@id': `${SITE}/#org`, name: 'TechTime株式会社', alternateName: 'TechTime', url: `${SITE}/`, logo: `${SITE}/images/logo.png`,
    description: 'SAP を中心とした基幹システムの導入と運用保守に、生成AIで設計・開発・テスト・点検・進捗管理を進める仕組みを組み込む会社。',
    foundingDate: '2020-04-01', telephone: '+81-3-4222-3363',
    address: { '@type': 'PostalAddress', addressCountry: 'JP', addressRegion: '東京都', addressLocality: '渋谷区', postalCode: '150-0002', streetAddress: '渋谷2-19-15 宮益坂ビルディング609' },
  },
  { '@type': 'WebSite', '@id': `${SITE}/#site`, name: 'TechTime', url: `${SITE}/`, inLanguage: 'ja', publisher: { '@id': `${SITE}/#org` } },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!live && <meta name="robots" content="noindex" />}
    {live && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V7Q3QV7HGR"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-V7Q3QV7HGR');
        </script>
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="TechTime株式会社" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta property="og:locale" content="ja_JP" />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" type="application/rss+xml" title="TechTime ブログ" href="/rss.xml" />
        <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body>
    <!-- 上の目盛り。ページのどこを読んでいるかを、針で示す -->
    <div class="ruler" aria-hidden="true"><i id="hand"><b id="handT"></b></i></div>
    <header class="nav">
      <a href={live ? '/' : '/next'} class="logo" aria-label="TechTime"><svg viewBox="0 0 28 28"><circle cx="14" cy="14" r="12.5" /><path d="M14 5v9l6 3.6" /></svg>TechTime</a>
      <nav>
        {menu.map((m) => <a href={m.h} aria-current={cur === m.k ? 'page' : undefined}>{m.n}</a>)}
      </nav>
      <a href="/contact" class="cta">相談する<span>24時間以内に返信</span></a>
    </header>

    <main>
      <slot />
      <section class="end rv" data-st="相談">
        <h2>{ask}</h2>
        <div class="act">
          <a href="/contact" class="btn btn--inv">相談する<i></i></a>
          <span>24時間以内に、メールで返信します。</span>
        </div>
      </section>
    </main>

    <footer class="ft">
      <span class="logo"><svg viewBox="0 0 28 28"><circle cx="14" cy="14" r="12.5" /><path d="M14 5v9l6 3.6" /></svg>TechTime</span>
      <nav>
        {!live && <a href="/next/shikumi">しくみ</a>}
        <a href={live ? '/services' : '/next/kotei'}>工程</a><a href="/assessment">アセスメント</a><a href="/blog">記事</a><a href="/glossary">用語集</a><a href="/resources">ひな形</a><a href="/check">自己診断</a><a href="/process">進め方</a><a href="/faq">よくある質問</a><a href="/company">会社概要</a><a href="/contact">相談する</a>
      </nav>
      <small>© TechTime Co., Ltd.</small>
    </footer>

    <script is:inline>
      (() => {
        const hand = document.getElementById('hand'), handT = document.getElementById('handT');
        const secs = [...document.querySelectorAll('[data-st]')];
        const onScroll = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          const p = max > 0 ? scrollY / max : 0;
          hand.style.transform = `translateX(${p * (innerWidth - 2)}px)`;
          let name = secs.length ? secs[0].dataset.st : '';
          secs.forEach((s) => { if (s.getBoundingClientRect().top < innerHeight * 0.5) name = s.dataset.st; });
          handT.textContent = name;
          handT.classList.toggle('r', p > 0.85);
        };
        addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); onScroll();
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.1 });
        document.querySelectorAll('.rv').forEach((e) => io.observe(e));
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f1f0ec;
    --card: #ffffff;
    --tint: #f6ecd0;
    --key: #f2a900;
    --ink: #15171a;
    --mute: #5f6b70;
    --rule: #cdd3d0;
    --hair: rgba(17, 23, 26, 0.1);
    --ai: #008a68;
    --ai-2: #5fc7a6;
    --amber: #e59a00;
    --miss: #cf2f66;
    --pad: clamp(18px, 4.4vw, 64px);
    --r: 16px;
    --sans: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
    --num: 'Barlow Condensed', 'Noto Sans JP', sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: 96px; }
  body { background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 15.5px; line-height: 1.9; -webkit-font-smoothing: antialiased; font-feature-settings: 'palt'; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; }
  ul, ol { list-style: none; }
  main { max-width: 1400px; margin: 0 auto; padding: 0 var(--pad); }
  h1, h2 { font-weight: 900; line-height: 1.24; letter-spacing: 0.01em; }
  h1 { font-size: clamp(32px, 4.1vw, 58px); line-height: 1.22; }
  .hero--top h1 { font-size: clamp(36px, 4.8vw, 70px); line-height: 1.16; }
  h2 { font-size: clamp(26px, 3.6vw, 48px); }

  /* 上の目盛り */
  .ruler { position: fixed; inset: 0 0 auto 0; z-index: 30; height: 22px; background: var(--ink); background-image: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.32) 0 1px, transparent 1px 10px), repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.7) 0 1px, transparent 1px 100px); background-size: 100% 6px, 100% 11px; background-repeat: no-repeat; background-position: 0 100%, 0 100%; }
  .ruler i { position: absolute; left: 0; top: 0; width: 2px; height: 22px; background: var(--amber); will-change: transform; }
  .ruler b { position: absolute; left: 8px; top: 2px; font: 500 10.5px/1.6 var(--sans); letter-spacing: 0.12em; color: #fff; white-space: nowrap; }
  .ruler b.r { left: auto; right: 8px; }

  .nav { position: sticky; top: 22px; z-index: 20; display: flex; align-items: center; gap: 30px; height: 64px; padding: 0 var(--pad); background: rgba(241, 240, 236, 0.9); backdrop-filter: blur(10px); }
  .nav nav { display: flex; gap: 6px; margin-left: auto; font-size: 14px; font-weight: 700; }
  .nav nav a { padding: 5px 16px; border-radius: 99px; transition: background 0.25s; }
  .nav nav a:hover { background: var(--card); }
  .nav nav a[aria-current] { background: var(--ink); color: #fff; }
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 900; font-size: 19px; }
  .logo svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  .logo svg path { stroke: var(--key); }
  .cta { display: inline-flex; align-items: center; gap: 10px; height: 42px; padding: 0 20px; border-radius: 99px; background: var(--key); color: var(--ink); font-weight: 700; font-size: 14px; transition: background 0.25s, color 0.25s; }
  .cta span { font-size: 11px; font-weight: 500; opacity: 0.85; }
  .cta:hover { background: var(--ink); color: #fff; }

  /* 小見出し：時計の目盛りを2本 */
  .kick { display: flex; align-items: center; gap: 10px; font-size: 13.5px; font-weight: 700; color: var(--ink); }
  .kick::before { content: ''; flex: none; width: 9px; height: 14px; border-left: 3px solid var(--ink); border-right: 3px solid var(--key); }

  .btn { display: inline-flex; align-items: center; gap: 14px; height: 54px; padding: 0 12px 0 26px; border-radius: 99px; background: var(--key); color: var(--ink); font-weight: 700; font-size: 15px; transition: background 0.25s, color 0.25s; }
  .btn i { position: relative; width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.45); transition: transform 0.3s; }
  .btn i::before { content: ''; position: absolute; left: 10px; top: 11px; width: 8px; height: 8px; border-top: 2px solid currentColor; border-right: 2px solid currentColor; transform: rotate(45deg); }
  .btn:hover { background: var(--ink); color: #fff; }
  .btn:hover i { transform: translateX(3px); }
  .btn--sub { padding: 0 24px; background: var(--card); color: var(--ink); }
  .btn--sub:hover { background: var(--ink); color: #fff; }
  .btn--inv { background: #fff; color: var(--ink); }
  .btn--inv i { background: var(--tint); }
  .btn--inv:hover { background: var(--ink); color: #fff; }
  .btn--inv:hover i { background: rgba(255, 255, 255, 0.22); }
  .act { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .more { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14.5px; color: var(--ink); text-decoration: underline; text-decoration-color: var(--key); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .more::after { content: ''; width: 7px; height: 7px; border-top: 2px solid; border-right: 2px solid; transform: rotate(45deg); transition: transform 0.25s; }
  .more:hover::after { transform: translateX(4px) rotate(45deg); }

  /* ページの頭 */
  .hero { padding: clamp(28px, 4.4vw, 60px) 0 0; }
  .hero__top { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(24px, 5vw, 80px); align-items: end; }
  .hero h1 { margin-top: 14px; }
  .hero__side p { font-size: clamp(15px, 1.25vw, 17px); font-weight: 500; }
  .hero__side .act { margin-top: 22px; }

  /* 章 */
  .sec { padding-top: clamp(72px, 10vw, 150px); }
  .head { display: grid; grid-template-columns: 1.25fr 1fr; gap: 12px clamp(24px, 5vw, 80px); align-items: end; }
  .head .kick { grid-column: 1 / -1; }
  .head__p { font-weight: 500; }
  .rv { opacity: 0; transform: translateY(22px); transition: opacity 0.8s, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .rv.in { opacity: 1; transform: none; }

  /* 図を置く面 */
  .fig { margin-top: clamp(22px, 3.2vw, 44px); border-radius: var(--r); background: var(--card); overflow: hidden; }
  .fig__bar { padding: 14px 22px 0; font-size: 13px; color: var(--mute); }
  .fig__bar b { margin-right: 14px; color: var(--ink); font-weight: 700; font-size: 14px; }
  .fig__scroll { overflow-x: auto; padding: 6px 6px 0; }
  .fig__scroll svg { display: block; width: 100%; min-width: 980px; height: auto; }
  .fig__scroll svg text { font-family: var(--sans); }
  .fig__lg { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 24px; padding: 12px 22px 14px; font-size: 12.5px; }
  .fig__lg span { display: inline-flex; align-items: center; gap: 8px; }
  .fig__lg em { margin-left: auto; font-style: normal; color: var(--mute); }
  .b { display: inline-block; width: 18px; height: 11px; border-radius: 2px; background: #4b565b; }
  .b--w { background: repeating-linear-gradient(45deg, #8b9498 0 2px, transparent 2px 5px); box-shadow: inset 0 0 0 1px #8b9498; }
  .b--k { background: var(--miss); }
  .b--a { background: var(--ai); }
  .b--d { width: 9px; background: var(--amber); }
  .note { margin-top: 12px; font-size: 12px; color: var(--mute); }

  /* 図の中で共通に使うもの */
  .g { stroke: var(--hair); }
  .g--b { stroke: rgba(17, 23, 26, 0.2); }
  .d-wk { font: 500 11px var(--mono) !important; fill: var(--mute); }
  .t-ttl { font-size: 19px; font-weight: 900; fill: var(--ink); }
  .t-ttl--ai { fill: var(--ai); }
  .t-ln { font: 500 11.5px var(--mono) !important; fill: var(--mute); }

  .late { fill: rgba(207, 47, 102, 0.07); }
  .late__t { font-size: 11.5px; font-weight: 700; fill: var(--miss); }
  .dead { stroke: var(--ink); stroke-width: 2; }
  .dead__b { fill: var(--ink); }
  .dead__t { font-size: 12px; font-weight: 700; fill: #fff; }
  .d-lb { font-size: 12px; font-weight: 700; fill: var(--ink); }
  .d-n { font: 600 58px var(--num) !important; fill: var(--ink); }
  .d-of { font: 500 20px var(--num) !important; fill: var(--mute); }
  .c-ai .d-n { fill: var(--ai); }
  .d-n.d-n--miss { fill: var(--miss); }
  .fm-say { font-size: 13.5px; font-weight: 700; }
  .fm-say--miss { fill: var(--miss); }
  .fm-say--ai { fill: var(--ai); }
  .fm-say--amber { fill: #a36d00; }

  /* 相談 */
  .end { margin: clamp(72px, 10vw, 150px) 0 var(--pad); padding: clamp(34px, 5.4vw, 80px) clamp(20px, 5vw, 72px); border-radius: var(--r); background: var(--key); color: var(--ink); }
  .end h2 { font-size: clamp(24px, 3vw, 40px); }
  .end .act { margin-top: 28px; gap: 20px; font-size: 14px; }

  .ft { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 30px; max-width: 1400px; margin: 0 auto; padding: 22px var(--pad) 40px; font-size: 13px; }
  .ft nav { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-left: auto; }
  .ft small { width: 100%; font: 500 11px var(--mono); color: var(--mute); }

  @media (max-width: 900px) {
    .nav { gap: 12px; }
    .nav nav { display: none; }
    .cta { margin-left: auto; }
    .cta span { display: none; }
    .hero__top, .head { grid-template-columns: 1fr; }
    h1 br, h2 br { display: none; }
    .fig__lg em { margin-left: 0; }
    .act .btn { flex: 1 1 100%; justify-content: space-between; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv { opacity: 1; transform: none; }
  }
</style>
