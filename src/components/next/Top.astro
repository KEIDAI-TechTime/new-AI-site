---
/* 新しいトップの案。約束を一目で伝え、3つの行き先へ送る */
import NextLayout from '../../layouts/NextLayout.astro';
import { services } from '../../data/services';
import { copy } from '../../data/koteiCopy';
import FigMotion from './FigMotion.astro';
interface Props { live?: boolean }
const { live = false } = Astro.props;
const kotei = '/services';
const title = live ? 'TechTime | SAP 導入を、速く。抜けなく。' : 'SAP 導入を、速く。抜けなく。| TechTime';
const flow = ['受注', '与信の確認', '在庫の引当', '出荷', '請求', '入金'];
const description = 'SAP の導入と保守に、AIチームを組み込みます。設計書やテストの初版は AI が作り、全件を点検します。決めたことは、要件からテストまで同じ番号でつなぎます。';
---

<NextLayout title={title} description={description} live={live}>
  <!-- 最初の画面。映像は、何もしなくても自分で流れて繰り返す -->
  <section class="hero hero--top" data-st="はじめに">
    <div class="hero__top">
      <div>
        <p class="kick">SAP の導入・保守を進める、プロジェクト責任者の方へ</p>
        <h1>SAP 導入を、<br />速く。抜けなく。</h1>
      </div>
      <div class="hero__side">
        <p>設計書やテストの初版は、AIチームが作り、全件を点検します。人は、決めることに集中できます。</p>
        <div class="act">
          <a href="/contact" class="btn">相談する<i></i></a>
          <a href="#requirements" class="btn btn--sub">工程ごとに見る</a>
          <a href="/downloads/techtime-assessment-sample.pdf" download class="btn btn--ink">アセスメントのサンプル<small>PDF・29枚</small><i class="dli"></i></a>
        </div>
      </div>
    </div>
    <div class="reel" id="reel">
      <svg id="flow" viewBox="0 0 1200 330" role="img" aria-label="受注から入金までの業務の流れを伝票が流れ続け、AIチームが手順から手順へ移りながら点検していく図">
        <defs>
          <clipPath id="fl-c0"><rect id="fl-r0" x="0" y="0" width="150" height="330" /></clipPath>
          <clipPath id="fl-c1"><rect id="fl-r1" x="150" y="0" width="1050" height="330" /></clipPath>
        </defs>
        <path id="fl-p" class="fl__path" d="M30 190C150 80 290 80 410 180S670 290 790 180S1050 80 1170 190" />
        {['fl-c0', 'fl-c1'].map((c, g) => (
          <g class={`fl__dots fl__dots--${g}`} clip-path={`url(#${c})`}>
            {Array.from({ length: 30 }, (_, i) => (
              <circle r="4.5"><animateMotion dur="15s" begin={`${-(i * 0.5).toFixed(2)}s`} repeatCount="indefinite"><mpath href="#fl-p" /></animateMotion></circle>
            ))}
          </g>
        ))}
        {flow.map((n, i) => (
          <g class="fl__st" data-i={i}>
            <rect x="-66" y="-30" width="132" height="60" rx="30" />
            <text y="7" text-anchor="middle">{n}</text>
            <g class="fl__ok" transform="translate(52 -26)"><circle r="11" /><path d="M-5 0l3.5 3.5L5 -4" /></g>
          </g>
        ))}
        {[0, 1, 2].map((k) => <g class="fl__ai" data-k={k}><line y1="20" y2="34" /><circle r="20" /><text y="6" text-anchor="middle">AI</text></g>)}
      </svg>
      <p class="fl__lg">
        <span><i class="fl__d"></i>伝票の流れ（受注から入金まで）</span>
        <span><i class="fl__a"></i>AIチームの点検</span>
        <span class="fl__n">点検した伝票<b id="flN">0</b>件</span>
        <em>架空の例です</em>
      </p>
    </div>
  </section>

  <section class="smp rv" id="assessment-sample" data-st="サンプル">
    <div class="smp__pg" aria-hidden="true">
      {[0, 1, 2].map((k) => (
        <div class={`pg pg${k}`}>
          <b></b><i></i><i></i><i></i>
          <span>{[34, 58, 26, 70, 44, 52].map((h) => <u style={`height:${h}%`}></u>)}</span>
        </div>
      ))}
    </div>
    <div class="smp__t">
      <p class="kick">アセスメントの報告書（サンプル）</p>
      <h2>貴社では、どこにどれだけ効くのか。<br />報告書の実物を、見てください。</h2>
      <p>架空の会社を題材にした、29枚の報告書です。結論・数字・根拠・進め方まで、そのまま読めます。</p>
    </div>
    <div class="smp__a">
      <a href="/downloads/techtime-assessment-sample.pdf" download class="btn btn--ink btn--big">サンプルをダウンロード<i class="dli"></i></a>
      <p>PDF・29枚・約2MB。お名前などの入力は要りません。</p>
      <a href="/assessment" class="more">アセスメントの内容を見る</a>
    </div>
  </section>

  {services.map((sv, i) => (
    <section class="sec tp" id={sv.slug} data-st={sv.name}>
      <div class="tp__h rv">
        <p class="kick">工程 {i + 1}／{sv.name}</p>
        <h2>{copy[sv.slug].h1[0]}{copy[sv.slug].h1[1]}</h2>
        <a href={`/services/${sv.slug}`} class="more">{sv.name}のページへ</a>
      </div>
      <FigMotion slug={sv.slug} />
    </section>
  ))}

  <section class="sec" data-st="次の一歩">
    <div class="go go--2">
      <div class="go__c rv" id="sample">
        <p class="kick">アセスメント</p>
        <h2>貴社では、どこに<br />どれだけ効くのか。</h2>
        <p>貴社の資料を読み、効く所を数字にした報告書を出します。架空の会社を題材にした報告書のサンプルを、そのままダウンロードできます。お名前などの入力は要りません。</p>
        <svg class="go__g go__g--r" viewBox="0 0 300 74" aria-hidden="true">
          <rect class="p" x="0" y="0" width="58" height="74" rx="4" /><path class="l" d="M9 14h40M9 26h30M9 38h40M9 50h22" />
          {[30, 52, 22, 64, 40, 48, 16].map((h, i) => <rect x={84 + i * 31} y={74 - h} width="22" height={h} rx="4" />)}
        </svg>
        <div class="act">
          <a href="/downloads/techtime-assessment-sample.pdf" download class="btn">サンプルをダウンロード<i></i></a>
          <a href="/assessment" class="more">アセスメントの内容を見る</a>
        </div>
      </div>
      <div class="go__c rv">
        <p class="kick">読みもの</p>
        <h2>現場で起きることを、<br />書いています。</h2>
        <p>SAP 導入の現場で起きることと、その進め方を、記事・用語集・ひな形にまとめています。</p>
        <ul class="go__l"><li><a href="/blog">記事</a></li><li><a href="/glossary">用語集</a></li><li><a href="/resources">ひな形</a></li><li><a href="/check">自己診断</a></li></ul>
        <a href="/blog" class="more">記事の一覧を見る</a>
      </div>
    </div>
  </section>
</NextLayout>

<script is:inline>
  (() => {
    const svg = document.getElementById('flow'), path = document.getElementById('fl-p');
    // 画面が狭いときは、縦に流す
    if (innerWidth < 700) {
      svg.setAttribute('viewBox', '0 0 400 600');
      path.setAttribute('d', 'M110 20C110 90 290 80 290 150S110 220 110 290S290 360 290 430S110 500 110 590');
      const r0 = document.getElementById('fl-r0'), r1 = document.getElementById('fl-r1');
      r0.setAttribute('width', 400); r0.setAttribute('height', 62); r1.setAttribute('x', 0); r1.setAttribute('y', 62); r1.setAttribute('width', 400); r1.setAttribute('height', 540);
      svg.classList.add('tall');
    }
    const L = path.getTotalLength();
    const sts = [...document.querySelectorAll('.fl__st')], ais = [...document.querySelectorAll('.fl__ai')], out = document.getElementById('flN');
    const pts = sts.map((g, i) => { const p = path.getPointAtLength(L * (0.07 + i * 0.172)); g.setAttribute('transform', `translate(${p.x} ${p.y})`); return p; });
    const tall = svg.classList.contains('tall');
    const put = (g, i) => { g.style.transform = tall ? `translate(${pts[i].x + (pts[i].x < 200 ? -1 : 1) * 0}px, ${pts[i].y - 58}px)` : `translate(${pts[i].x}px, ${pts[i].y - 64}px)`; };
    const pos = [0, 2, 4]; let n = 0;
    ais.forEach((g, k) => put(g, pos[k]));
    const visit = (i) => { const g = sts[i]; g.classList.add('ok'); g.classList.remove('hit'); void g.getBBox(); g.classList.add('hit'); };
    pos.forEach(visit);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { sts.forEach((_, i) => visit(i)); return; }
    document.getElementById('reel').classList.add('live');
    // 点検した件数は、止まらずに増えていく
    setInterval(() => { n += 3; out.textContent = n.toLocaleString('ja-JP'); }, 90);
    // AI は順に、次の手順へ移る
    let turn = 0;
    setInterval(() => {
      const k = turn++ % 3, g = ais[k], to = (pos[k] + 1) % sts.length;
      if (to === 0) { g.classList.add('jump'); setTimeout(() => { put(g, 0); setTimeout(() => { g.classList.remove('jump'); visit(0); }, 60); }, 300); }
      else { put(g, to); setTimeout(() => visit(to), 650); }
      pos[k] = to;
    }, 800);
  })();
</script>

<style is:global>
  .reel { position: relative; margin-top: clamp(16px, 2.4vw, 32px); padding: clamp(10px, 2vw, 26px) clamp(8px, 2vw, 26px) 0; border-radius: var(--r); background: var(--card); overflow: hidden; }
  #flow { display: block; width: 100%; height: auto; overflow: visible; }
  .fl__path { fill: none; stroke: var(--bg); stroke-width: 22; stroke-linecap: round; }
  .fl__dots--0 circle { fill: #8a8f94; }
  .fl__dots--1 circle { fill: var(--key); }
  .fl__st rect { fill: var(--card); stroke: var(--rule); stroke-width: 2.5; transition: stroke 0.4s; }
  .fl__st text { font-family: var(--sans); font-size: 21px; font-weight: 900; fill: var(--ink); }
  .fl__st.ok rect { stroke: var(--key); }
  .fl__st.hit rect { animation: flhit 0.8s both; }
  @keyframes flhit { 0% { stroke-width: 12; stroke: var(--key); } 100% { stroke-width: 2.5; } }
  .fl__ok { opacity: 0; transition: opacity 0.3s; }
  .fl__ok circle { fill: var(--ink); }
  .fl__ok path { fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .fl__st.ok .fl__ok { opacity: 1; }
  .fl__ai { transition: transform 0.65s cubic-bezier(0.5, 0, 0.2, 1), opacity 0.25s; }
  .fl__ai.jump { opacity: 0; transition: opacity 0.25s; }
  .fl__ai circle { fill: var(--key); }
  .fl__ai line { stroke: var(--key); stroke-width: 4; stroke-linecap: round; }
  .fl__ai text { font-family: var(--mono); font-size: 15px; font-weight: 600; fill: var(--ink); }
  .live .fl__ai circle { animation: flai 1.6s ease-in-out infinite; }
  @keyframes flai { 0%, 100% { stroke: rgba(242, 169, 0, 0.5); stroke-width: 0; } 50% { stroke: rgba(242, 169, 0, 0); stroke-width: 22; } }
  .fl__lg { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 26px; padding: 6px 12px 16px; font-size: 13px; }
  .fl__lg span { display: inline-flex; align-items: center; gap: 8px; }
  .fl__d { margin: 0 3px; }
  .fl__d { width: 10px; height: 10px; border-radius: 50%; background: #8a8f94; }
  .fl__a { width: 16px; height: 16px; border-radius: 50%; background: var(--key); }
  .fl__n { margin-left: auto; font-weight: 700; }
  .fl__n b { min-width: 3.2em; font: 600 clamp(24px, 2.6vw, 36px)/1 var(--num); text-align: right; }
  .fl__lg em { font-style: normal; font-size: 11.5px; color: var(--mute); }
  @media (max-width: 900px) {
    .fl__path { stroke-width: 16; }
    .fl__n { margin-left: 0; width: 100%; }
  }

  .tp { padding-top: clamp(56px, 8vw, 120px); }
  .tp__h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 26px; }
  .tp__h .kick { width: 100%; }
  .tp__h h2 { font-size: clamp(26px, 3.6vw, 50px); }
  .tp__h .more { margin-left: auto; }
  .tp .fig { margin-top: clamp(14px, 2vw, 26px); }
  .go--2 { grid-template-columns: repeat(2, 1fr) !important; }
  .btn--ink { background: var(--ink); color: #fff; }
  .btn--ink:hover { background: var(--key); color: var(--ink); }
  .btn--ink small { font-size: 11.5px; font-weight: 500; opacity: 0.75; }
  .btn--ink i { background: rgba(255, 255, 255, 0.18); }
  .dli::before { left: 11px !important; top: 8px !important; transform: rotate(135deg) !important; }
  .dli::after { content: ''; position: absolute; left: 9px; right: 9px; bottom: 8px; height: 2px; background: currentColor; }
  .btn--big { height: 66px; padding: 0 16px 0 32px; font-size: 18px; }
  .btn--big i { width: 40px; height: 40px; }
  .btn--big .dli::before { left: 15px !important; top: 11px !important; }
  .btn--big .dli::after { left: 12px; right: 12px; bottom: 11px; }
  /* 報告書のサンプルの面 */
  .smp { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(20px, 3.4vw, 56px); margin-top: clamp(18px, 2.4vw, 32px); padding: clamp(24px, 3.2vw, 46px) clamp(22px, 3.6vw, 56px); border-radius: var(--r); background: var(--key); }
  .smp h2 { margin-top: 8px; font-size: clamp(22px, 2.5vw, 34px); line-height: 1.45; }
  .smp__t > p:last-child { margin-top: 8px; font-size: 15px; font-weight: 500; }
  .smp .kick::before { border-right-color: #fff; }
  .smp__a { display: grid; justify-items: start; gap: 8px; }
  .smp__a p { font-size: 12.5px; font-weight: 500; }
  .smp__a .more { text-decoration-color: var(--ink); }
  .smp__pg { position: relative; width: clamp(120px, 12vw, 170px); aspect-ratio: 1.3; }
  .pg { position: absolute; inset: 0; display: grid; align-content: start; gap: 7px; padding: 14px 14px 0; border-radius: 6px; background: #fff; box-shadow: 0 6px 18px -8px rgba(21, 23, 26, 0.5); transform-origin: 50% 120%; animation: pgfan 6s ease-in-out infinite; }
  .pg b { height: 10px; width: 62%; border-radius: 3px; background: var(--ink); }
  .pg i { height: 5px; border-radius: 2px; background: var(--rule); }
  .pg i:nth-of-type(2) { width: 80%; } .pg i:nth-of-type(3) { width: 55%; }
  .pg span { display: flex; align-items: flex-end; gap: 5px; height: clamp(30px, 3.4vw, 48px); margin-top: 4px; }
  .pg u { flex: 1; border-radius: 2px 2px 0 0; background: var(--key); }
  .pg u:nth-child(4) { background: var(--ink); }
  .pg0 { --a: -9deg; } .pg1 { --a: 0deg; animation-delay: 0.15s; } .pg2 { --a: 9deg; animation-delay: 0.3s; }
  @keyframes pgfan { 0%, 100% { transform: rotate(0); } 35%, 70% { transform: rotate(var(--a)); } }
  .go .act { margin-top: 8px; gap: 12px 22px; }
  .go { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .go__c { display: flex; flex-direction: column; gap: 12px; padding: clamp(22px, 2.6vw, 36px); border-radius: var(--r); background: var(--card); }
  a.go__c { transition: transform 0.3s, box-shadow 0.3s; }
  a.go__c:hover { transform: translateY(-4px); box-shadow: 0 14px 30px -18px rgba(17, 23, 26, 0.45); }
  .go h2 { font-size: clamp(22px, 2.3vw, 31px); line-height: 1.4; }
  .go__c > p:not(.kick) { font-size: 14.5px; }
  .go__g { width: 100%; max-width: 300px; margin-top: auto; padding-top: 10px; fill: var(--key); }
  .go__g--r .p { fill: var(--tint); }
  .go__g--r .l { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; }
  .go__g--r rect:nth-of-type(5) { fill: var(--ink); }
  .go__l { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 10px; }
  .go__l a { display: block; padding: 3px 14px; border-radius: 99px; background: var(--tint); font-size: 13px; font-weight: 700; transition: background 0.2s, color 0.2s; }
  .go__l a:hover { background: var(--ink); color: #fff; }
  .go .more { margin-top: 6px; }
  @media (max-width: 900px) { .go, .go--2 { grid-template-columns: 1fr !important; } .tp__h .more { margin-left: 0; } .smp { grid-template-columns: 1fr; } .smp__pg { margin: 0 auto 6px; } .smp h2 br { display: none; } .btn--big { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { .pg { animation: none; transform: rotate(var(--a)); } }
</style>
