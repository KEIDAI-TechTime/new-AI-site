---
/* 工程ごとの動く図（開発・テスト・移行・運用保守）。開くと自分で流れ、繰り返す。どれも架空の例 */
import FigForecast from './FigForecast.astro';
interface Props { slug: string }
const { slug } = Astro.props;
const caps: Record<string, string[]> = {
  requirements: ['会議で決まったことを、AIが取り出す。', '決定に番号を付け、一覧に載せる。', '設計書・プログラム・テストに、同じ番号が残る。', '保守まで、同じ番号でたどれる。'],
  design: ['AIが、設計書の初版を作る。', '214本すべてを、同じ6つの観点で読む。', '指摘は、3か所だけ。', '直すかどうかは、人が決める。'],
  'project-management': ['毎朝、記録から課題とリスクを取り出す。', '完了の見込みを、幅で出す。', '課題を解くたびに、幅が左へ動く。', '見込みを最も早める課題から、手を打つ。'],
  development: ['設計書から、プログラムの初版を作る。', '処理ごとに、設計書の行と結ぶ。', '片方にしかない行を、見つける。', '残すか、足りない分を作るかは、人が決める。'],
  test: ['AIが、検証環境の画面を操作する。', '手順ごとに、証跡を残す。', 'NG が出たら、そこで止める。', '原因の仮説を付けて、担当者に渡す。'],
  migration: ['全件を、1件ずつ照合する。', '合わない件だけが、残る。', '合わない件を、理由ごとに分ける。', '人が見るのは、この15件だけ。'],
  operations: ['本番稼働の半年後、問い合わせが来る。', '導入時の記録を、さかのぼる。', '決めた場と理由まで、届く。', '作った人を探さずに、答えられる。'],
};
const cap = caps[slug];
const spec = [
  { id: '3.2-1', t: '締め日までに出荷が完了した受注を対象にする', c: 'SELECT … WHERE wadat_ist <= lv_closing' },
  { id: '3.2-2', t: '締め日は毎月20日とする', c: "lv_closing = closing_day( iv_day = '20' )" },
  { id: '3.2-3', t: '締め日が休日のときは前の営業日とする', c: 'rv_date = previous_workday( lv_closing )' },
  { id: '3.3-1', t: '対象が0件のときは、請求書を作らず記録だけ残す', c: '' },
  { id: '', t: '', c: 'PERFORM send_mail_to_sales.' },
];
const steps = ['受注を登録', '与信を確認', '在庫を引き当て', '出荷を指示', '出荷を記録', '請求書を発行'];
const cells = Array.from({ length: 360 }, (_, i) => (i % 47 === 9 ? 'ma' : i % 83 === 30 ? 'mb' : i % 131 === 77 ? 'mc' : ''));
const cnt = (k: string) => cells.filter((c) => c === k).length;
const bad = cells.filter((c) => c).length;
const why = [{ k: 'ma', n: '桁があふれる' }, { k: 'mb', n: 'コードの変換先がない' }, { k: 'mc', n: '日付の形式が違う' }];
const yarn = [
  { d: '4/08', n: '会議', k: '業務検討会', t: '「請求の締め日は、毎月20日にします」', s: 0 },
  { d: '4/08', n: '決定の一覧', k: 'D-0142', t: '請求の締め日を毎月20日にする', s: 1 },
  { d: '4/10', n: '設計書', k: 'SD-031 3.2', t: '締め日は、毎月20日とする', s: 2 },
  { d: '4/15', n: 'プログラム', k: 'ZSD_BILLING_CLOSE', t: "iv_day = '20'", s: 2 },
  { d: '5/12', n: 'テスト', k: 'TC-118', t: '20日までの出荷が当月の請求に入る　OK', s: 2 },
  { d: '11/20', n: '保守', k: '問い合わせ', t: '「なぜ20日なのか」に、決定の記録で答える', s: 3 },
];
const views = ['要件との対応', '項目の桁数と型', '命名のきまり', '他の設計書との食い違い', '例外の扱い', 'テストへのつながり'];
const vflag = [1, 3, 4];
const doc = [
  { w: 92 }, { w: 64, f: '受注側は 13,2。桁が合わない' }, { w: 86 }, { w: 78 },
  { w: 46, f: 'SD-027 は「出荷指示の時点」と書いている' }, { w: 88 }, { w: 38, f: '対象が0件のときの扱いがない' }, { w: 70 },
];
const chain = [
  { k: 'テスト', v: 'TC-118　OK', d: '5/12' },
  { k: 'プログラム', v: 'ZSD_BILLING_CLOSE', d: '4/15' },
  { k: '設計書', v: 'SD-031　3.2', d: '4/10' },
  { k: '決定', v: 'D-0142　業務検討会', d: '4/08' },
];
---

{cap && (
  <div class={`fig mo mo-${slug}`} data-mo data-caps={JSON.stringify(cap)} data-dur={slug === 'requirements' ? '[1700,1700,2600,2600]' : undefined}>
    <div class="mo__h">
      <p class="mo__cap">{cap[0]}</p>
      <ol class="mo__seg" aria-hidden="true">{cap.map(() => <li></li>)}</ol>
    </div>

    {slug === 'requirements' && (
      <ol class="rq">
        {yarn.map((y, i) => (
          <li class={`rq${y.s}`} style={`--i:${i}`}>
            <span>{y.d}</span><i></i><b>{y.n}</b>
            <div><small>{y.k}</small><p>{y.t}</p>{i > 0 && <em>D-0142</em>}</div>
          </li>
        ))}
      </ol>
    )}

    {slug === 'design' && (
      <div class="dg">
        <div class="dg__doc">
          <p class="dg__h"><b>外部設計書 SD-031</b>請求書発行<span>031 / 214</span></p>
          <div class="dg__b"><u></u>{doc.map((d, i) => <p class:list={[d.f && 'f']} style={`--w:${d.w}%;--i:${i}`}>{d.f && <em>{d.f}</em>}</p>)}</div>
          <div class="dg__all">{Array.from({ length: 214 }, (_, i) => <i class:list={[i % 31 === 7 && 'w']} style={`--i:${i}`}></i>)}</div>
        </div>
        <div class="dg__v">
          <ul>{views.map((v, i) => <li class:list={[vflag.includes(i) && 'flag']} style={`--i:${i}`}><span>{v}</span><b>{vflag.includes(i) ? '指摘 1' : '済'}</b></li>)}</ul>
          <p class="dg__out"><b>人に渡すのは、指摘のあった3か所だけ。</b>設計者が読み、直すかどうかを決めます。</p>
        </div>
      </div>
    )}

    {slug === 'project-management' && <div class="pm"><FigForecast bare /></div>}

    {slug === 'development' && (
      <div class="dv">
        <p class="dv__t"><span>外部設計書 SD-031</span><span></span><span>プログラム ZSD_BILLING_CLOSE</span></p>
        {spec.map((r, i) => (
          <p class:list={['dv__r', (!r.c || !r.t) && 'odd']} style={`--i:${i}`}>
            {r.t ? <span class="dv__d"><i>{r.id}</i>{r.t}</span> : <span class="dv__none">設計書にない処理</span>}
            <b></b>
            {r.c ? <code class="dv__c">{r.c}</code> : <span class="dv__none">対応するプログラムがない</span>}
            {(!r.c || !r.t) && <em class="dv__man">{r.c ? '人：消すと決める' : '人：作ると決める'}</em>}
          </p>
        ))}
      </div>
    )}

    {slug === 'test' && (
      <div class="ts">
        <ol class="ts__run">
          {steps.map((n, i) => (
            <li class:list={[i === 3 && 'ng', i > 3 && 'yet']} style={`--i:${i}`}>
              <div class="ts__scr"><i></i><i></i><i></i><i></i><u></u></div>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <b>{n}</b>
              <em>{i < 3 ? 'OK' : i === 3 ? 'NG' : '実施しない'}</em>
              <small>証跡</small>
            </li>
          ))}
        </ol>
        <div class="ts__hyp">
          <p><b>手順 04 の原因の仮説</b></p>
          <p>出荷指示の画面で「出荷ポイントが決まらない」。倉庫 W02 に出荷ポイントの割り当てがない可能性が高い（マスタの設定）。直すか、テストデータを変えるかは、担当者が決めます。</p>
        </div>
      </div>
    )}

    {slug === 'migration' && (
      <div class="mg">
        <div class="mg__g">{cells.map((c, i) => <i class={c} style={`--i:${i}`}></i>)}</div>
        <div class="mg__s">
          <p class="mg__n"><b data-t={JSON.stringify(['360', String(360 - bad), String(360 - bad), String(360 - bad)])}>360</b><span data-t={JSON.stringify(['件を照合', '件は一致', '件は一致', '件は一致'])}>件を照合</span></p>
          <p class="mg__k">合わない <b>{bad}</b> 件</p>
          <ul>{why.map((w, j) => <li class={w.k} style={`--j:${j}`}><span>{w.n}</span><u style={`--n:${cnt(w.k)}`}></u><b>{cnt(w.k)}</b>件</li>)}</ul>
          <p class="mg__m">人が見るのは、この {bad} 件だけ</p>
        </div>
      </div>
    )}

    {slug === 'operations' && (
      <div class="op">
        <p class="op__q"><em>保守の問い合わせ</em><span>請求の締め日は、なぜ20日なのか</span></p>
        <ol class="op__c">
          {chain.map((c, i) => <li class:list={[i === chain.length - 1 && 'hit']} style={`--i:${i}`}><em>{c.k}</em><b>{c.v}</b><small>{c.d}</small></li>)}
        </ol>
        <div class="op__a">
          <p><b>答え：4/08 の業務検討会で決めた（D-0142）。</b></p>
          <p>得意先の多くが20日締めで、月末締めだと入金の確認が月初の作業に重なるため。</p>
          <em>担当者が確認して回答</em>
        </div>
      </div>
    )}
    <p class="fig__lg"><em>架空の例です。{slug === 'test' && '合否は人が決めます。本番の環境では動かしません。'}</em></p>
  </div>
)}

<script is:inline>
  (() => {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('[data-mo]').forEach((el) => {
      if (el.dataset.run) return; el.dataset.run = '1';
      const caps = JSON.parse(el.dataset.caps), cap = el.querySelector('.mo__cap'), segs = [...el.querySelectorAll('.mo__seg li')], texts = [...el.querySelectorAll('[data-t]')];
      const DUR = el.dataset.dur ? JSON.parse(el.dataset.dur) : [3400, 3400, 3400, 4600];
      let s = -1, timer, started = false;
      const set = (n) => {
        s = n;
        for (let k = 0; k < caps.length; k++) el.classList.toggle('k' + k, k <= n);
        cap.textContent = caps[n]; cap.classList.remove('in'); void cap.offsetWidth; cap.classList.add('in');
        segs.forEach((e, i) => e.classList.toggle('on', i === n));
        texts.forEach((e) => { e.textContent = JSON.parse(e.dataset.t)[n]; });
      };
      const next = () => {
        if (s === caps.length - 1) { for (let k = 0; k < caps.length; k++) el.classList.remove('k' + k); timer = setTimeout(() => { set(0); timer = setTimeout(next, DUR[0]); }, 500); return; }
        set(s + 1); timer = setTimeout(next, DUR[s]);
      };
      if (still) { set(caps.length - 1); return; }
      new IntersectionObserver((e) => { if (e[0].isIntersecting && !started) { started = true; set(0); timer = setTimeout(next, DUR[0]); } }, { threshold: 0.25 }).observe(el);
    });
  })();
</script>

<style is:global>
  .mo__h { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 26px 0; }
  .mo__cap { font-size: clamp(19px, 2.5vw, 34px); font-weight: 900; line-height: 1.4; }
  .mo__cap.in { animation: mocap 0.5s both; }
  @keyframes mocap { from { opacity: 0; transform: translateY(8px); } }
  .mo__seg { display: flex; gap: 6px; flex: none; }
  .mo__seg li { width: 26px; height: 5px; border-radius: 3px; background: var(--rule); transition: background 0.3s, width 0.3s; }
  .mo__seg li.on { width: 46px; background: var(--key); }
  .mo * { transition-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1); }

  /* 要件定義：同じ番号が6つの場所に残る */
  .rq { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; margin: 22px 26px 6px; }
  .rq li { position: relative; display: grid; justify-items: center; gap: 2px; opacity: 0.3; transition: opacity 0.3s; }
  .rq li::before { content: ''; position: absolute; left: calc(-50% - 5px); right: 50%; top: 41px; height: 4px; background: var(--key); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .rq li:first-child::before { display: none; }
  .rq li > span { font: 600 22px/1.2 var(--num); color: var(--mute); }
  .rq li > i { position: relative; z-index: 1; width: 22px; height: 22px; margin: 6px 0; border-radius: 50%; background: var(--rule); box-shadow: 0 0 0 5px var(--card); transition: background 0.4s, transform 0.4s; }
  .rq li > b { font-size: clamp(14px, 1.4vw, 18px); font-weight: 900; }
  .rq li > div { position: relative; width: 100%; min-height: 150px; margin-top: 10px; padding: 16px 16px 44px; border-radius: 14px; background: var(--bg); text-align: left; transition: background 0.4s; }
  .rq small { font: 500 11.5px var(--mono); color: var(--mute); }
  .rq p { margin-top: 4px; font-size: clamp(13px, 1.1vw, 15px); font-weight: 700; line-height: 1.7; }
  .rq em { position: absolute; left: 14px; bottom: 12px; padding: 0 12px; border-radius: 99px; background: var(--ink); color: #fff; font: 500 12px/2 var(--mono); font-style: normal; opacity: 0; transform: scale(0.6); transition: opacity 0.35s, transform 0.35s; }
  .k0 .rq0, .k1 .rq1, .k2 .rq2, .k3 .rq3 { opacity: 1; }
  .k0 .rq0 > i, .k1 .rq1 > i, .k2 .rq2 > i, .k3 .rq3 > i { background: var(--key); transform: scale(1.2); }
  .k1 .rq1::before, .k2 .rq2::before, .k3 .rq3::before { transform: none; }
  .k1 .rq1 em, .k2 .rq2 em, .k3 .rq3 em { opacity: 1; transform: none; transition-delay: 0.25s; }
  .k2 .rq2, .k2 .rq2 > i, .k2 .rq2::before { transition-delay: calc((var(--i) - 2) * 0.4s); }
  .k2 .rq2 em { transition-delay: calc((var(--i) - 2) * 0.4s + 0.25s); }
  .k0 .rq0 > div, .k3 .rq3 > div { background: var(--tint); }

  /* 設計：全件を同じ観点で読む */
  .dg { display: grid; grid-template-columns: 1.15fr 1fr; gap: 26px; margin: 22px 26px 6px; }
  .dg__doc { padding: 20px; border-radius: 14px; background: var(--bg); }
  .dg__h { display: flex; gap: 14px; padding: 10px 16px; border-radius: 10px 10px 0 0; background: var(--card); font-size: 13.5px; box-shadow: inset 0 -1px 0 var(--rule); }
  .dg__h span { margin-left: auto; font: 500 12px/2 var(--mono); color: var(--mute); }
  .dg__b { position: relative; padding: 14px 16px 16px; border-radius: 0 0 10px 10px; background: var(--card); overflow: hidden; }
  .dg__b p { position: relative; height: 12px; margin: 11px 0; }
  .dg__b p::before { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: 6px; background: #dfe1dd; transform: scaleX(0); transform-origin: left; transition: transform 0.5s, background 0.4s; }
  .k0 .dg__b p::before { transform: none; transition-delay: calc(var(--i) * 0.22s); }
  .dg__b u { position: absolute; left: 0; right: 0; top: 0; z-index: 2; height: 40px; border-bottom: 3px solid var(--key); background: linear-gradient(transparent, rgba(242, 169, 0, 0.25)); transform: translateY(-44px); }
  .k1 .dg__b u { animation: dgscan 2.6s linear both; }
  @keyframes dgscan { to { transform: translateY(260px); } }
  .k2 .dg__b u, .k3 .dg__b u { animation: none; }
  .dg__b em { position: absolute; left: calc(var(--w) + 10px); top: 50%; z-index: 3; padding: 0 14px; border-radius: 99px; background: var(--ink); color: #fff; font: 700 12.5px/2.1 var(--sans); font-style: normal; white-space: nowrap; opacity: 0; transform: translate(-8px, -50%); transition: opacity 0.4s, transform 0.4s; }
  .k2 .dg__b .f::before { background: var(--ink); }
  .k2 .dg__b em { opacity: 1; transform: translate(0, -50%); transition-delay: calc(var(--i) * 0.12s); }
  .dg__all { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 14px; }
  .dg__all i { width: 6px; height: 18px; border-radius: 2px; background: #dfe1dd; transition: background 0.2s; }
  .k1 .dg__all i { background: var(--key); transition-delay: calc(var(--i) * 11ms); }
  .k2 .dg__all i.w { background: var(--ink); transition-delay: 0s; }
  .dg__v { display: flex; flex-direction: column; }
  .dg__v li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--rule); font-weight: 700; font-size: clamp(14px, 1.35vw, 18px); }
  .dg__v li b { padding: 0 16px; border-radius: 99px; background: var(--key); font: 700 12.5px/2.1 var(--sans); opacity: 0; transform: scale(0.6); transition: opacity 0.3s, transform 0.3s, background 0.3s, color 0.3s; }
  .dg__v li.flag b { font-size: 0; }
  .dg__v li.flag b::after { content: '済'; font-size: 12.5px; }
  .k1 .dg__v li b { opacity: 1; transform: none; transition-delay: calc(var(--i) * 0.38s + 0.3s); }
  .k2 .dg__v li.flag b { background: var(--ink); color: #fff; font-size: 12.5px; transition-delay: 0s; }
  .k2 .dg__v li.flag b::after { content: none; }
  .dg__out { margin-top: auto; padding: 16px 20px; border-radius: 14px; background: var(--tint); font-size: 14.5px; opacity: 0; transform: translateY(12px); transition: opacity 0.5s, transform 0.5s; }
  .dg__out b { display: block; font-size: clamp(16px, 1.6vw, 21px); font-weight: 900; }
  .k3 .dg__out { opacity: 1; transform: none; }

  /* プロジェクト管理：毎朝の見込みの幅 */
  .pm { margin: 8px 20px 0; }
  .mo .fc__b { transform-box: fill-box; transform-origin: left center; transform: scaleX(0); transition: transform 0.6s; }
  .mo .fc__m, .mo .fc__ev { opacity: 0; transition: opacity 0.4s; }
  .mo.k0 .fc__m, .mo.k0 .fc__ev { opacity: 1; transition-delay: calc(var(--i) * 0.3s); }
  .mo .fc__e, .mo .fc__bg, .mo .fc__side { opacity: 0; transition: opacity 0.4s; }
  .mo.k1 .fc:first-of-type .fc__b { transform: none; }
  .mo.k1 .fc:first-of-type .fc__e { opacity: 1; transition-delay: 0.5s; }
  .mo.k2 .fc .fc__b { transform: none; transition-delay: calc(var(--i) * 0.36s); }
  .mo.k2 .fc .fc__e { opacity: 1; transition-delay: calc(var(--i) * 0.36s + 0.4s); }
  .mo.k1 .fc:first-of-type .fc__b, .mo.k1 .fc:first-of-type .fc__e { transition-delay: 0.1s; }
  .mo.k3 .fc__bg, .mo.k3 .fc__side { opacity: 1; }

  /* 開発：設計書の行と、プログラムの行 */
  .dv { margin: 22px 26px 6px; }
  .dv__t, .dv__r { display: grid; grid-template-columns: 1fr 70px 1fr; align-items: center; }
  .dv__t { font-size: 12px; font-weight: 700; color: var(--mute); }
  .dv__r { position: relative; margin-top: 10px; font-size: clamp(13.5px, 1.2vw, 16px); }
  .dv__d, .dv__c, .dv__none { padding: 16px 20px; border-radius: 10px; background: var(--bg); transition: background 0.5s, opacity 0.5s, clip-path 0.7s; }
  .dv__d i { margin-right: 12px; font: 500 11.5px var(--mono); font-style: normal; color: var(--mute); }
  .dv__c { font: 500 clamp(12px, 1.05vw, 14px)/1.9 var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; background: var(--tint); clip-path: inset(0 100% 0 0 round 10px); }
  .k0 .dv__c { clip-path: inset(0 0 0 0 round 10px); transition-delay: calc(var(--i) * 0.45s); }
  .dv__r b { height: 5px; background: var(--key); transform: scaleX(0); transform-origin: left; transition: transform 0.5s; }
  .k1 .dv__r:not(.odd) b { transform: none; transition-delay: calc(var(--i) * 0.5s + 0.2s); }
  .dv__none { background: none; box-shadow: inset 0 0 0 2px var(--miss); color: var(--miss); font-weight: 700; font-size: 14px; opacity: 0; }
  .k2 .dv__none { opacity: 1; }
  .k2 .odd .dv__d, .k2 .odd .dv__c { background: #fbe3eb; }
  .dv__man { position: absolute; right: 10px; top: 50%; padding: 0 14px; border-radius: 99px; background: var(--ink); color: #fff; font: 700 13px/2.4 var(--sans); font-style: normal; opacity: 0; transform: translate(10px, -50%); transition: opacity 0.4s, transform 0.4s; }
  .dv__r.odd:last-child .dv__man { right: auto; left: 10px; }
  .k3 .dv__man { opacity: 1; transform: translate(0, -50%); transition-delay: calc((var(--i) - 3) * 0.6s + 0.3s); }

  /* テスト：画面を操作し、証跡を残す */
  .ts { margin: 18px 26px 4px; }
  .ts__run { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
